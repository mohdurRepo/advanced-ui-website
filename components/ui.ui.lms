window.marketConfig = {
  endpoints: {
    marketData: "/api",
    timing: "/api"
  },
 
  refresh: {
    fallbackInterval: 30000
  },
 
  domains: {
 
    mainCompany: companyDetailsURL+"?companySymbol=",
    nomuCompany: companyDetailsSMEURL+"?companySymbol=",
    sukukCompany: sukukURL+"?SukukBondsSymbol=",
    reitsCompany: companyDetailsURL+"?companySymbol=", 
    etfCompany: companyDetailsETFURL+"?etfSymbolParameter=", 
    cefCompany: companyDetailsURL+"?companySymbol="
  },
 
  labels: {
    mainMarketLabel: "<fmt:message key='${siteStatusDerivatives}' />",
    nomuMarketLabel: "<fmt:message key='${siteStatusDerivatives}' />",
    sukukMarketLabel: "<fmt:message key='${siteStatusDerivatives}' />",
    fundsMarketLabel: "<fmt:message key='${siteStatusDerivatives}' />"
  },
 
  icons: {
    status: "#custom-circle-icon",
    changeUp: "#custom-arrow-up-right",
    changeDown: "#custom-arrow-down-right",
    neutral: "#custom-minus-icon"
  },
 
  statusClasses: {
    0: "red",
    1: "orange",
    2: "green",
    3: "red",
    4: "red",
    6: "orange",
    9: "orange",
    10: "yellow"
  }
};



(function (window, document) {
  "use strict";
 
  var MarketCommon = {};
 
  MarketCommon.getPath = function (object, path) {
    if (!object || !path) {
      return null;
    }
 
    return path.split(".").reduce(function (current, key) {
      return current && current[key] !== undefined ? current[key] : null;
    }, object);
  };
 
  MarketCommon.toNumber = function (value) {
    if (value === null || value === undefined || value === "") {
      return 0;
    }
 
    return parseFloat(String(value).replace(/,/g, "")) || 0;
  };
 
  MarketCommon.formatNumber = function (value, decimals) {
    return MarketCommon.toNumber(value).toLocaleString(undefined, {
      minimumFractionDigits: decimals || 0,
      maximumFractionDigits: decimals || 0
    });
  };
 
  MarketCommon.getDirection = function (value) {
    var number = MarketCommon.toNumber(value);
 
    if (number > 0) {
      return "up";
    }
 
    if (number < 0) {
      return "down";
    }
 
    return "equal";
  };
 
  MarketCommon.getPriceClass = function (value) {
    var direction = MarketCommon.getDirection(value);
 
    if (direction === "up") {
      return "price-up";
    }
 
    if (direction === "down") {
      return "price-down";
    }
 
    return "price-equal";
  };
 
  MarketCommon.buildSvg = function (iconRef, className) {
    if (!iconRef) {
      return "";
    }
 
    return (
      '<svg class="' + (className || "pc-icon pr-3 link-icon") + '" width="20" height="20" aria-hidden="true">' +
        '<use xlink:href="' + iconRef + '"></use>' +
      '</svg>'
    );
  };
 
  MarketCommon.buildChangeHtml = function (netChange, percentChange) {
	  var config = window.marketConfig || {};
	  var icons = config.icons || {};
	  var direction = MarketCommon.getDirection(netChange);
	  var iconRef = "";
	   
	  if (direction === "up") {
	    iconRef = icons.changeUp;
	  } else if (direction === "down") {
	    iconRef = icons.changeDown;
	  }
	   
	  return (
	    '<div class="' + MarketCommon.getPriceClass(netChange) + '">' +
	    MarketCommon.buildSvg(iconRef, "pc-icon pr-3 link-icon change-icon") +
	    '<span data-field="netChange">' + MarketCommon.formatNumber(netChange, 2) + '</span>' +
	    ' <span data-field="percentChange">(' + MarketCommon.formatNumber(percentChange, 2) + '%)</span>' +
	    '</div>'
	  );
	  };
 
  MarketCommon.clearPriceClasses = function (element) {
    if (!element) {
      return;
    }
 
    element.classList.remove("price-up", "price-down", "price-equal");
  };
 
  MarketCommon.applyPriceClass = function (element, value) {
    if (!element) {
      return;
    }
 
    MarketCommon.clearPriceClasses(element);
    element.classList.add(MarketCommon.getPriceClass(value));
  };
 
  MarketCommon.flashElement = function (element, oldValue, newValue) {
    var oldNumber;
    var newNumber;
 
    if (!element || oldValue === undefined || oldValue === null) {
      return;
    }
 
    oldNumber = MarketCommon.toNumber(oldValue);
    newNumber = MarketCommon.toNumber(newValue);
 
    element.classList.remove("flash-up", "flash-down");
 
    if (newNumber > oldNumber) {
      element.classList.add("flash-up");
    } else if (newNumber < oldNumber) {
      element.classList.add("flash-down");
    }
 
    window.setTimeout(function () {
      element.classList.remove("flash-up", "flash-down");
    }, 700);
  };
 
  MarketCommon.setTextWithFlash = function (element, oldValue, newValue, formattedValue) {
    if (!element) {
      return;
    }
 
    element.textContent = formattedValue;
    MarketCommon.flashElement(element, oldValue, newValue);
  };
 
  MarketCommon.updateStatusClass = function (element, statusCode) {
    var config = window.marketConfig || {};
    var statusClasses = config.statusClasses || {};
    var className = statusClasses[statusCode] || "red";
 
    if (!element) {
      return;
    }
 
    element.classList.remove("red", "orange", "green", "yellow");
    element.classList.add(className);
  };
 
  MarketCommon.isArabic = function () {
    return (document.documentElement.lang || "").toLowerCase().indexOf("ar") === 0;
  };
 
  MarketCommon.toInt = function (value, fallback) {
    var number = parseInt(value, 10);
    return isNaN(number) ? fallback : number;
  };
 
  MarketCommon.pad = function (value) {
    value = MarketCommon.toInt(value, 0);
    return value < 10 ? "0" + value : String(value);
  };
 
  MarketCommon.getTimerLabel = function (status) {
    status = String(status || "").toUpperCase();
 
    if (MarketCommon.isArabic()) {
      return status === "OPEN" ? "يغلق خلال: " : "يفتح خلال: ";
    }
 
    return status === "OPEN" ? "Closes in: " : "Opens in: ";
  };
 
  MarketCommon.buildTargetDate = function (nextEventTimer) {
    var date;
    var time;
 
    if (!nextEventTimer || !nextEventTimer.date || !nextEventTimer.time) {
      return null;
    }
 
    date = nextEventTimer.date;
    time = nextEventTimer.time;
 
    return new Date(
      MarketCommon.toInt(date.year, 0),
      MarketCommon.toInt(date.month, 1) - 1,
      MarketCommon.toInt(date.day, 1),
      MarketCommon.toInt(time.hour, 0),
      MarketCommon.toInt(time.minute, 0),
      MarketCommon.toInt(time.second, 0),
      time.nano ? Math.floor(MarketCommon.toInt(time.nano, 0) / 1000000) : 0
    );
  };
 
  MarketCommon.getRemainingSeconds = function (nextEventTimer) {
    var targetDate = MarketCommon.buildTargetDate(nextEventTimer);
 
    if (!targetDate || isNaN(targetDate.getTime())) {
      return 0;
    }
 
    return Math.max(0, Math.floor((targetDate.getTime() - Date.now()) / 1000));
  };
 
  MarketCommon.formatTimer = function (seconds) {
    var safeSeconds = Math.max(0, Math.floor(seconds || 0));
    var days = Math.floor(safeSeconds / 86400);
    var hours = Math.floor((safeSeconds % 86400) / 3600);
    var minutes = Math.floor((safeSeconds % 3600) / 60);
    var remainingSeconds = safeSeconds % 60;
 
    if (days > 0) {
      return MarketCommon.isArabic()
        ? days + " يوم"
        : days + " " + (days === 1 ? "day" : "days");
    }
 
    return (
      MarketCommon.pad(hours) +
      ":" +
      MarketCommon.pad(minutes) +
      ":" +
      MarketCommon.pad(remainingSeconds)
    );
  };
 
  window.MarketCommon = MarketCommon;
 
}(window, document));
 

 (function (window, document, $) {
  "use strict";
 
  var config = window.marketConfig || {};
  var common = window.MarketCommon;
 
  if (!common) {
    return;
  }
 
  var state = {
    isRefreshing: false,
    fallbackRefreshTimer: null,
    cardTimers: {},
    previousValues: {}
  };
 
  var CARD_MAP = {
    tasi: {
      selector: '[data-key="tasi"]',
      valuePath: "tasiValue",
      netChangePath: "tasiNetChange",
      percentChangePath: "tasiPercentageChange",
      statusCodePath: "marketStatusCode"
    },
 
    nomuc: {
      selector: '[data-key="nomuc"]',
      valuePath: "smeSasiValue",
      netChangePath: "smeSasiNetChange",
      percentChangePath: "smeSasiPercentageChange",
      statusCodePath: "smeMarketStatusCode"
    },
 
    sukuk: {
      selector: '[data-key="sukuk"]',
      valuePath: "sukukValue",
      netChangePath: "sukukNetChange",
      percentChangePath: "sukukPercentageChange",
      statusCodePath: "sukukmarketStatusCode"
    },
 
    mt30: {
      selector: '[data-key="mt30"]',
      valuePath: "mt30IndexValue",
      netChangePath: "mt30IndexNetChange",
      percentChangePath: "mt30IndexPercentageChange",
      statusCodePath: "derivativeMarketStatus"
    },
 
    REITs: {
      selector: '[data-key="REITs"]',
      valuePath: null,
      netChangePath: null,
      percentChangePath: null,
      statusCodePath: "marketStatusCode"
    }
  };
 
  function fetchJson(url) {
    return $.ajax({
      type: "GET",
      url: url,
      dataType: "json"
    });
  }
 
  function previousKey(cardKey, field) {
    return cardKey + "." + field;
  }
 
  function getPrevious(cardKey, field) {
    return state.previousValues[previousKey(cardKey, field)];
  }
 
  function setPrevious(cardKey, field, value) {
    state.previousValues[previousKey(cardKey, field)] = common.toNumber(value);
  }
 
  function updateTextField(card, cardKey, field, rawValue, formattedValue) {
    var element = card.querySelector('[data-field="' + field + '"]');
    var oldValue = getPrevious(cardKey, field);
 
    if (!element) {
      return;
    }
 
    common.setTextWithFlash(element, oldValue, rawValue, formattedValue);
    setPrevious(cardKey, field, rawValue);
  }
 
  function updateChangeField(card, cardKey, netChange, percentChange) {
    var element = card.querySelector('[data-field="change"]');
    var oldValue = getPrevious(cardKey, "change");
 
    if (!element) {
      return;
    }
 
    element.innerHTML = common.buildChangeHtml(netChange, percentChange);
    common.flashElement(element, oldValue, netChange);
    setPrevious(cardKey, "change", netChange);
  }
 
  function updateCardStatus(card, statusCode) {
    common.updateStatusClass(
      card.querySelector('[data-field="statusIcon"]'),
      statusCode
    );
  }
 
  function updateCard(cardKey, marketData) {
    var cardConfig = CARD_MAP[cardKey];
    var card;
    var value;
    var netChange;
    var percentChange;
    var statusCode;
 
    if (!cardConfig) {
      return;
    }
 
    card = document.querySelector(cardConfig.selector);
 
    if (!card) {
      return;
    }
 
    statusCode = common.getPath(marketData, cardConfig.statusCodePath);
    updateCardStatus(card, statusCode);
 
    if (!cardConfig.valuePath) {
      return;
    }
 
    value = common.getPath(marketData, cardConfig.valuePath);
    netChange = common.getPath(marketData, cardConfig.netChangePath);
    percentChange = common.getPath(marketData, cardConfig.percentChangePath);
 
    updateTextField(
      card,
      cardKey,
      "indexPrice",
      value,
      common.formatNumber(value, 2)
    );
 
    updateChangeField(card, cardKey, netChange, percentChange);
  }
 
  function updateCards(marketData) {
    Object.keys(CARD_MAP).forEach(function (cardKey) {
      updateCard(cardKey, marketData);
    });
  }
 
  function clearCardTimer(timerKey) {
    if (state.cardTimers[timerKey]) {
      window.clearInterval(state.cardTimers[timerKey]);
      delete state.cardTimers[timerKey];
    }
  }
 
  function clearAllCardTimers() {
    Object.keys(state.cardTimers).forEach(clearCardTimer);
  }
 
  function renderTimer(timerElement, label, seconds) {
    if (!timerElement) {
      return;
    }
 
    timerElement.classList.toggle("timer-warning", seconds > 0 && seconds <= 10);
    timerElement.classList.toggle("timer-ended", seconds <= 0);
    timerElement.textContent = label + common.formatTimer(seconds);
  }
 
  function updateTimers(timingData) {
	  clearAllCardTimers();
	 
	  if (!$.isArray(timingData)) {
	    return;
	  }
	 
	  timingData.forEach(function (timingItem) {
	    var marketCode;
	 
	    if (!timingItem) {
	      return;
	    }
	 
	    marketCode = String(timingItem.marketCode || "").toUpperCase();
	 
	    if (marketCode === "M") {
	      startSingleCardTimerForKey(timingItem, "tasi");
	      startSingleCardTimerForKey(timingItem, "nomuc");
	      return;
	    }
	 
	    if (marketCode === "S") {
	      startSingleCardTimerForKey(timingItem, "sukuk");
	      return;
	    }
	 
	    if (marketCode === "B") {
	      startSingleCardTimerForKey(timingItem, "REITs");
	      return;
	    }
	 
	    if (marketCode === "D") {
	      startSingleCardTimerForKey(timingItem, "mt30");
	    }
	  });
	}
 
  function startSingleCardTimerForKey(timingItem, timerKey) {
	  var card;
	  var timerElement;
	  var label;
	  var seconds;
	 
	  if (!timingItem || !timerKey) {
	    return;
	  }
	 
	  card = document.querySelector(
	    '.market-card[data-timer-key="' + timerKey + '"]'
	  );
	 
	  if (!card) {
	    return;
	  }
	 
	  timerElement = card.querySelector('[data-field="timer"]');
	 
	  if (!timerElement) {
	    return;
	  }
	 
	  clearCardTimer(timerKey);
	 
	  label = common.getTimerLabel(timingItem.status);
	  seconds = common.getRemainingSeconds(timingItem.nextEventTimer);
	 
	  renderTimer(timerElement, label, seconds);
	 
	  state.cardTimers[timerKey] = window.setInterval(function () {
	    seconds = common.getRemainingSeconds(timingItem.nextEventTimer);
	 
	    renderTimer(timerElement, label, seconds);
	 
	    if (seconds <= 0) {
	      clearCardTimer(timerKey);
	      refreshNow();
	    }
	  }, 1000);
	}
 
  function refreshNow() {
    if (state.isRefreshing) {
      return;
    }
 
    state.isRefreshing = true;
 
    $.when(
      fetchJson(config.endpoints.marketData),
      fetchJson(config.endpoints.timing)
    )
      .done(function (marketResponse, timingResponse) {
		  var marketData = marketResponse[0];
		  var timingData = timingResponse[0];
		 
		  updateCards(marketData);
		  updateTimers(timingData);
		 
		  if (
		    window.MarketHomeDetails &&
		    typeof window.MarketHomeDetails.update === "function"
		  ) {
		    window.MarketHomeDetails.update(marketData);
		  }
		})
      .always(function () {
        state.isRefreshing = false;
      });
  }
 
  function start() {
    stop();
 
    refreshNow();
 
    state.fallbackRefreshTimer = window.setInterval(function () {
      refreshNow();
    }, config.refresh.fallbackInterval || 30000);
  }
 
  function stop() {
    if (state.fallbackRefreshTimer) {
      window.clearInterval(state.fallbackRefreshTimer);
      state.fallbackRefreshTimer = null;
    }
 
    clearAllCardTimers();
  }
 
  window.MarketHomeRefresh = {
    start: start,
    stop: stop,
    refreshNow: refreshNow,
    updateCards: updateCards,
    updateTimers: updateTimers
  };
 
  $(start);
 
}(window, document, jQuery));


(function (window, document) {
  "use strict";
 
  var config = window.marketConfig || {};
  var common = window.MarketCommon;
 
  if (!common) return;
 
  var previousValues = {};
 
  var MARKET_CONFIGS = {
    tasi: {
    	cardSelector: '[data-key="tasi"]',
      listRoot: "mainMarketActiveResultsBean",
      companyDomain: "mainCompany",
      labelKey: "mainMarketLabel",
 
      stats: {
        summaryPath: "tasiBean.tasiTodaysSummaryBean",
        ytdPath: "tasiBean.tasiYearToDateBean",
        marketCapPath: "marketCapBean",
        marketBeanPath: "marketBean",
 
        turnOver: "turnOver",
        volumeTraded: "volumeTraded",
        marketCap: "marketCap",
        symbolsListed: "noOfSymbolsListedMain", 
        symbolsDown: "noOfDowns",
        symbolsUp: "noOfUps"
      }
    },
 
    nomu: {
    	cardSelector: '[data-key="nomuc"]',
      listRoot: "nomuMarketActiveResultBean",
      companyDomain: "nomuCompany",
      labelKey: "nomuMarketLabel",
 
      stats: {
        summaryPath: "smeSasiBean.smeSASITodaysSummaryBean",
        ytdPath: "smeSasiBean.smeSASIYearToDateBean",
        marketCapPath: "marketCapBean",
        marketBeanPath: "smeMarketBean",
 
        turnOver: "turnOver",
        volumeTraded: "volumeTraded",
        marketCap: "marketCap_Nomu",
        symbolsListed: "noOfSymbolsListedNomu",
        symbolsDown: "noOfDowns",
        symbolsUp: "noOfUps"
      }
    },
    
    sukuk: {
    	cardSelector: '[data-key="sukuk"]',
	  listRoot: "sokukMarketActiveResultBean",
	  companyDomain: "sukukCompany",
	  labelKey: "sukukMarketLabel",
	 
	  stats: {
	    summaryPath: "sukukIndicesBean.tasiTodaysSummaryBean",
	    ytdPath: "sukukIndicesBean.tasiYearToDateBean",
	    marketCapPath: "marketCapBean",
	    marketBeanPath: "sukukMarketBean",
	 
	    turnOver: "turnOver",
	    volumeTraded: "volumeTraded",
	    marketCap: "marketCap_Sukuk",
	    symbolsListed: "noOfSymbolsListedSukuk",
	    symbolsDown: "noOfDowns",
	    symbolsUp: "noOfUps"
	  }
	},
	
	fundsReits: {
		cardSelector: '[data-key="REITs"]',
	  listRoot: "reitMarketActiveResultBean",
	  companyDomain: "reitsCompany",
	  labelKey: "fundsMarketLabel",
	  fieldPrefix: "funds.reits",
	 
	  stats: {
	    sourcePath: "reitMarketBean",
	    turnOver: "turnover",
	    volumeTraded: "volume",
	    noOfTrades: "noOfTrades",
	    listedFunds: "listedFundsREITs"
	  }
	},
	 
	fundsEtfs: {
		cardSelector: '[data-key="REITs"]',
	  listRoot: "etfMarketActiveResultBean",
	  companyDomain: "etfCompany",
	  labelKey: "fundsMarketLabel",
	  fieldPrefix: "funds.etfs",
	 
	  stats: {
	    sourcePath: "etfMarketBean",
	    turnOver: "turnover",
	    volumeTraded: "volume",
	    noOfTrades: "noOfTrades",
	    listedFunds: "listedFundsETFs"
	  }
	},
	 
	fundCefs: {
		cardSelector: '[data-key="REITs"]',
	  listRoot: "",	
	  companyDomain: "cefCompany",
	  fieldPrefix: "funds.cefs",
	 
	  stats: {
	    sourcePath: "cefMarketBean",
	    turnOver: "turnover",
	    volumeTraded: "volume",
	    noOfTrades: "noOfTrades",
	    listedFunds: "listedFundsCEFs"
	  }
	}
  };
 
  function key(name) {
    return "details." + name;
  }
 
  function getPrevious(name) {
    return previousValues[key(name)];
  }
 
  function setPrevious(name, value) {
    previousValues[key(name)] = common.toNumber(value);
  }
 
  function getMarketList(data, rootPath, listName) {
    var beans = common.getPath(data, rootPath);
 
    if (!Array.isArray(beans)) {
      return [];
    }
 
    for (var i = 0; i < beans.length; i += 1) {
      if (Array.isArray(beans[i][listName])) {
        return beans[i][listName];
      }
    }
 
    return [];
  }
 
  function getDomain(domainKey) {
    return String((config.domains && config.domains[domainKey]) || "");
  }
 
  function buildCompanyUrl(marketConfig, symbol) {
    return getDomain(marketConfig.companyDomain) + encodeURIComponent(symbol || "");
  }
 
  function getSymbol(item) {
    return item.szSymbol || item.symbol || item.companySymbol || "";
  }
 
  function getCompanyName(item) {
	  if (common.isArabic && common.isArabic()) {
	    return (
	      item.companyAr ||
	      item.companyNameAr ||
	      item.companyNameAR ||
	      item.issuerNameAr ||
	      item.companyName ||
	      item.szCompany ||
	      ""
	    );
	  }
	 
	  return (
	    item.companyEn ||
	    item.companyNameEn ||
	    item.companyNameEN ||
	    item.issuerNameEn ||
	    item.companyName ||
	    item.szCompany ||
	    ""
	  );
	}
 
  function getCompanyStatusClass(status) {
    status = String(status || "");
 
    if (status === "1") return "yellow";
    if (status === "2") return "orange";
    if (status === "3") return "red";
 
    return "";
  }
 
  function flash(name, element, newValue) {
    common.flashElement(element, getPrevious(name), newValue);
    setPrevious(name, newValue);
  }
 
  function setDetailValue(field, rawValue, formattedValue) {
    var elements = document.querySelectorAll('[data-detail-field="' + field + '"]');
 
    Array.prototype.forEach.call(elements, function (element) {
      common.setTextWithFlash(element, getPrevious(field), rawValue, formattedValue);
    });
 
    setPrevious(field, rawValue);
  }
 
  function buildChangeIcon(value) {
    var direction = common.getDirection(value);
    var icons = config.icons || {};
    var iconRef = "";
 
    if (direction === "up") iconRef = icons.changeUp;
    if (direction === "down") iconRef = icons.changeDown;
 
    return iconRef
      ? common.buildSvg(iconRef, "pc-icon pr-3 link-icon change-icon")
      : "";
  }
 
  function buildChangeStrong(value, suffix) {
    var number = common.toNumber(value);
 
    return (
      '<strong class="' + common.getPriceClass(number) + '">' +
        buildChangeIcon(number) +
        common.formatNumber(number, 2) +
        (suffix || "") +
      '</strong>'
    );
  }
 
  function updateChangeDetail(field, rawValue, suffix) {
    var elements = document.querySelectorAll('[data-detail-field="' + field + '"]');
 
    Array.prototype.forEach.call(elements, function (element) {
      element.innerHTML = buildChangeStrong(rawValue, suffix);
      common.flashElement(element, getPrevious(field), rawValue);
    });
 
    setPrevious(field, rawValue);
  }
 
  function updateMarketStats(data, marketKey) {
    var marketConfig = MARKET_CONFIGS[marketKey];
    var stats = marketConfig.stats;
 
    var summary = common.getPath(data, stats.summaryPath) || {};
    var ytd = common.getPath(data, stats.ytdPath) || {};
    var marketCap = common.getPath(data, stats.marketCapPath) || {};
    var marketBean = common.getPath(data, stats.marketBeanPath) || {};
    var symbolsListed = common.getPath(data, stats.symbolsListed) || {};
 
    setDetailValue(
      marketKey + ".turnOver",
      summary[stats.turnOver],
      common.formatNumber(summary[stats.turnOver], 2)
    );

    setDetailValue(
      marketKey + ".volumeTraded",
     summary[stats.volumeTraded],
      common.formatNumber(summary[stats.volumeTraded], 0)
    );
 
    /*setDetailValue(
      marketKey + ".marketCap",
      marketCap[stats.marketCap],
      marketCap[stats.marketCap] || "0"
    );*/
 
      setDetailValue(
      marketKey + ".symbolsListed",
      symbolsListed,
      symbolsListed || "0"
    );
 
    setDetailValue(
      marketKey + ".symbolsDown",
      marketBean[stats.symbolsDown],
      marketBean[stats.symbolsDown] || "0"
    );
 
    setDetailValue(
      marketKey + ".symbolsUp",
      marketBean[stats.symbolsUp],
      marketBean[stats.symbolsUp] || "0"
    );
 
    updateChangeDetail(
      marketKey + ".dailyChange",
      ytd.change,
      ""
    );
 
    updateChangeDetail(
      marketKey + ".dailyPercentChange",
      ytd.percentChange,
      "%"
    );
  }
 

  function getCardStatusLabel(marketConfig) {
	    var card;
	    var statusElement;
	    var fallbackLabel;
	 
	    fallbackLabel =
	        (config.labels && config.labels[marketConfig.labelKey]) || "";
	 
	    if (!marketConfig || !marketConfig.cardSelector) {
	        return fallbackLabel;
	    }
	 
	    card = document.querySelector(marketConfig.cardSelector);
	 
	    if (!card) {
	        return fallbackLabel;
	    }
	 
	    statusElement = card.querySelector('[data-field="marketStatus"]');
	 
	    if (!statusElement) {
	        return fallbackLabel;
	    }
	 
	    return String(statusElement.textContent || "").trim() || fallbackLabel;
	}
  function createCompanyInfo(item, marketConfig, marketStatusLabel) {
	    var info = document.createElement("div");
	    var link = document.createElement("a");
	    var strong = document.createElement("strong");
	    var status = document.createElement("span");
	    var small = document.createElement("small");
	    var cardStatusLabel = getCardStatusLabel(marketConfig);
	 
	    info.className = "info";
	 
	    link.href = buildCompanyUrl(
	        marketConfig,
	        getSymbol(item)
	    );
	 
	    strong.appendChild(
	        document.createTextNode(getCompanyName(item) + " ")
	    );
	 
	    status.className =
	        "status-circle " +
	        getCompanyStatusClass(item.companyStatus);
	 
	    strong.appendChild(status);
	    link.appendChild(strong);
	 
	    small.textContent = cardStatusLabel;
	 
	    info.appendChild(link);
	    info.appendChild(small);
	 
	    return info;
	}
	 
 
  function createPriceElement(item, rowKey) {
	  var price = document.createElement("div");
	 
	  var value =
	    item.bdLastPrice ||
	    item.lastTradedPrice ||
	    item.lastTradePrice ||
	    item.lastTradePriceModified ||
	    item.closePrice ||
	    "0.00";
	 
	  price.className = "price";
	  price.textContent = value;
	 
	  flash(rowKey + ".price", price, value);
	 
	  return price;
	}
	
	function createChangeElement(item, rowKey) {
	  var change = document.createElement("div");
	 
	  var net =
	    item.bdNetChange ||
	    item.netChange ||
	    "0.00";
	 
	  var percent =
	    item.bdPercnetChange ||
	    item.netPercentChange ||
	    item.percentChange ||
	    item.precentChange ||
	    item.percentChangeDoubleModified ||
	    "0.00";
	 
	  change.className = "change " + common.getPriceClass(percent);
	 
	  change.innerHTML =
	    buildChangeIcon(percent) +
	    String(net) +
	    " (" +
	    String(percent) +
	    "%)";
	 
	  flash(rowKey + ".change", change, percent);
	 
	  return change;
	}
 
	function createSimpleValueElement(value, rowKey, fieldName) {
		  var element = document.createElement("div");
		  var fractionDigits = fieldName === "value" ? 2 : 0;
		  var formattedValue = common.formatNumber(value, fractionDigits);
		 
		  element.className = "change";
		  element.textContent = formattedValue;
		 
		  flash(rowKey + "." + fieldName, element, value);
		 
		  return element;
		}
	function createRow(item, mode, marketKey, listKey, overrideConfig) {

		  var row = document.createElement("div");
		  var numbers = document.createElement("div");
		  var symbol = getSymbol(item);
		  var rowKey = marketKey + "." + listKey + "." + symbol;
		  var marketConfig = overrideConfig || MARKET_CONFIGS[marketKey];
		 
		  row.className = "market-tabs__row";
		  numbers.className = "numbers";
		 
		  row.appendChild(createCompanyInfo(item, marketConfig));
		  numbers.appendChild(createPriceElement(item, rowKey));
		 
		  if (mode === "change") {
		    numbers.appendChild(createChangeElement(item, rowKey));
		  }
		 
		  if (mode === "volume") {
		    numbers.appendChild(
		      createSimpleValueElement(
		        item.bdVolume || item.volumeTraded || item.volume,
		        rowKey,
		        "volume"
		      )
		    );
		  }
		 
		  if (mode === "value") {
		    numbers.appendChild(
		      createSimpleValueElement(
		        item.bdTurnover || item.turnover,
		        rowKey,
		        "value"
		      )
		    );
		  }
		 
		  row.appendChild(numbers);
		 
		  return row;
		}
 
	function renderPanel(selector, list, mode, marketKey, listKey, overrideConfig) {
	  var panel = document.querySelector(selector);
	 
	  if (!panel) return;
	 
	  panel.innerHTML = "";
	 
	  (list || []).slice(0, 5).forEach(function (item) {
		  
		    if (listKey === "volume" &&
		        Number(item.bdVolume || item.volumeTraded || item.volume) === 0) {
		        return;
		    }
		 
		    if (listKey === "value" &&
		        Number(item.bdTurnover || item.turnover) === 0) {
		        return;
		    }
		 
		    panel.appendChild(
		        createRow(item, mode, marketKey, listKey, overrideConfig)
		    );
		});
	}
 
  function updateMarketTabs(data, marketKey) {
    var marketConfig = MARKET_CONFIGS[marketKey];
 
    
    renderPanel(
      '[data-detail-list="' + marketKey + '.gainers"]',
      getMarketList(data, marketConfig.listRoot, "gainers"),
      "change",
      marketKey,
      "gainers", 
      null
      );
 
    renderPanel(
      '[data-detail-list="' + marketKey + '.losers"]',
      getMarketList(data, marketConfig.listRoot, "losers"),
      "change",
      marketKey,
      "losers",
      null
    );
 
    renderPanel(
      '[data-detail-list="' + marketKey + '.volume"]',
      getMarketList(data, marketConfig.listRoot, "volume"),
      "volume",
      marketKey,
      "volume",
      null
    );
 
    renderPanel(
      '[data-detail-list="' + marketKey + '.value"]',
      getMarketList(data, marketConfig.listRoot, "value"),
      "value",
      marketKey,
      "value",
      null
    );
  }
  
  function updateFundsTabs(data) {
	  updateFundTabs(data, MARKET_CONFIGS.fundsReits);
	  updateFundTabs(data, MARKET_CONFIGS.fundsEtfs);
	}
	 
  function updateFundTabs(data, marketConfig) {
	  var prefix = marketConfig.fieldPrefix;
	 
	  renderPanel(
	    '[data-detail-list="' + prefix + '.gainers"]',
	    getMarketList(data, marketConfig.listRoot, "gainers"),
	    "change",
	    prefix,
	    "gainers",
	    marketConfig
	  );
	 
	  renderPanel(
	    '[data-detail-list="' + prefix + '.losers"]',
	    getMarketList(data, marketConfig.listRoot, "losers"),
	    "change",
	    prefix,
	    "losers",
	    marketConfig
	  );
	 
	  renderPanel(
	    '[data-detail-list="' + prefix + '.volume"]',
	    getMarketList(data, marketConfig.listRoot, "volume"),
	    "volume",
	    prefix,
	    "volume",
	    marketConfig
	  );
	 
	  renderPanel(
	    '[data-detail-list="' + prefix + '.value"]',
	    getMarketList(data, marketConfig.listRoot, "value"),
	    "value",
	    prefix,
	    "value",
	    marketConfig
	  );
	}
	

  function updateFundsStats(data) {
	  updateFundStats(data, MARKET_CONFIGS.fundsReits);
	  updateFundStats(data, MARKET_CONFIGS.fundsEtfs);
	  updateFundStats(data, MARKET_CONFIGS.fundCefs);
	}
	 
	function updateFundStats(data, marketConfig) {
	  var statsConfig = marketConfig.stats;
	  var stats = getFundStatsSource(data, statsConfig);
	  var prefix = marketConfig.fieldPrefix;
	  var listedFunds = common.getPath(data, statsConfig.listedFundsPath);
	 
	  setDetailValue(
	    prefix + ".turnOver",
	    stats[statsConfig.turnOver],
	    common.formatNumber(stats[statsConfig.turnOver], 2)
	  );
	 
	  setDetailValue(
	    prefix + ".volumeTraded",
	    stats[statsConfig.volumeTraded],
	    stats[statsConfig.volumeTraded]
	  );
	 
	  setDetailValue(
	    prefix + ".noOfTrades",
	    stats[statsConfig.noOfTrades],
	    stats[statsConfig.noOfTrades]
	  );
	 
	  /*setDetailValue(
	    prefix + ".listedFunds",
	    listedFunds,
	    common.formatNumber(listedFunds, 0)
	  );*/
	}
	 
	function getFundStatsSource(data, statsConfig) {
	  if (statsConfig.sourceType === "indicesList") {
	    return getItemBySymbol(
	      common.getPath(data, "indicesList") || [],
	      statsConfig.sourceSymbol
	    );
	  }
	 
	  return common.getPath(data, statsConfig.sourcePath) || {};
	}
	 
	function getItemBySymbol(list, symbol) {
	  for (var i = 0; i < list.length; i += 1) {
	    if (list[i] && list[i].symbol === symbol) {
	      return list[i];
	    }
	  }
	 
	  return {};
	}
  
  
  
  
		function updateEtfWatchTable(data) {
			  var tableBody = document.querySelector('[data-detail-table="funds.etfs.watch"]');
			  var list = common.getPath(data, "marketWatchETFsBeans") || [];
			 
			  if (!tableBody) return;
			 
			  tableBody.innerHTML = "";
			 
			  list.forEach(function (item) {
			    tableBody.appendChild(createEtfWatchRow(item));
			  });
			}
			 
			function createEtfWatchRow(item) {
			  var row = document.createElement("tr");
			  var symbol = getSymbol(item);
			  var rowKey = "funds.etfs.watch." + symbol;
			 
			  row.appendChild(createLinkedTableCell(item, "etfCompany", ""));
			 
			  row.appendChild(createFlashTableCell(
					  item.lastTradePrice || item.lastTradePriceModified,
					  rowKey + ".price",
					  "text-center",
					  2
					));
			 
			  row.appendChild(createPercentTableCell(
			    item.precentChange || item.percentChangeDoubleModified,
			    rowKey + ".percent",
			    "text-center",
				  2
			  ));
			 
			  row.appendChild(createFlashTableCell(
					  item.INAV || item.INAVModified,
					  rowKey + ".inav",
					  "text-center",
					  2
					));
			 
			  return row;
			}
			 
			 
			function updateCefWatchTable(data) {
			  var tableBody = document.querySelector('[data-detail-table="funds.cefs.watch"]');
			  var list = common.getPath(data, "marketWatchCEFsBeans") || [];
			 
			  if (!tableBody) return;
			 
			  tableBody.innerHTML = "";
			 
			  list.forEach(function (item) {
			    tableBody.appendChild(createCefWatchRow(item));
			  });
			}
			 
			function createCefWatchRow(item) {
			  var row = document.createElement("tr");
			  var symbol = item.companyRef || item.symbol || "";
			  var rowKey = "funds.cefs.watch." + symbol;
			 
			  row.appendChild(createLinkedTableCell(
			    {
			      symbol: symbol,
			      companyName: item.companyName
			    },
			    "cefCompany",
			    "text-center"
			    ));
			 
			  row.appendChild(createFlashTableCell(
					  item.lastTradePriceModified,
					  rowKey + ".price",
					  "text-center",
					  2
					));
			 
			  row.appendChild(createPercentTableCell(
			    item.precentChange,
			    rowKey + ".percent",
			    "text-center",
				  2
			  ));
			 
			  row.appendChild(createFlashTableCell(
					  item.volumeTraded,
					  rowKey + ".volume",
					  "text-center",
					  2
					));
			 
			  return row;
			}
			 
			 
			function createLinkedTableCell(item, domainKey, className) {
			  var cell = document.createElement("td");
			  var link = document.createElement("a");
			 
			  cell.className = className || "";
			 
			  link.href = getDomain(domainKey) + encodeURIComponent(getSymbol(item));
			  link.textContent = getCompanyName(item);
			 
			  cell.appendChild(link);
			 
			  return cell;
			}
			 
			function createFlashTableCell(value, rowKey, className, fractionDigits) {
				  var cell = document.createElement("td");
				 
				  cell.className = className || "";
				  cell.textContent = common.formatNumber(value, fractionDigits || 0);
				 
				  flash(rowKey, cell, value);
				 
				  return cell;
				}
			 
			function createPercentTableCell(value, rowKey) {
			  var cell = document.createElement("td");
			 
			  cell.className = common.getPriceClass(value)+" text-center";
			  cell.innerHTML = buildChangeIcon(value) + String(value || "0.00") + "%";
			 
			  flash(rowKey, cell, value);
			 
			  return cell;
			}
 
  function updateMarket(data, marketKey) {
    updateMarketStats(data, marketKey);
    updateMarketTabs(data, marketKey);
  }
 
  function update(data) {
	  updateMarket(data, "tasi");
	  updateMarket(data, "nomu");
	  updateMarket(data, "sukuk");
	 
	  updateFundsTabs(data);
	  updateFundsStats(data);
	  updateEtfWatchTable(data);
	  //updateCefWatchTable(data);
	}
	 
	 
	 
	window.MarketHomeDetails = {
	  update: update,
	 
	  updateTasi: function (data) {
	    updateMarket(data, "tasi");
	  },
	 
	  updateNomu: function (data) {
	    updateMarket(data, "nomu");
	  },
	 
	  updateSukuk: function (data) {
	    updateMarket(data, "sukuk");
	  },
	 
	  updateFunds: function (data) {
	    updateFundsTabs(data);
	    updateFundsStats(data);
	    updateEtfWatchTable(data);
	    //updateCefWatchTable(data);
	  }
	};
 
}(window, document));
 
