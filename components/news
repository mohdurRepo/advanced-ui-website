		<c:if test="${isHomePage}">
			<%-- Initial state before first paint (default "auto").
					 Must match market-overview.js: STORAGE_KEY and AUTO_OPEN_QUERY. --%>
			<script>
				(function () {
					var details = document.currentScript.parentElement;
					var root = details.closest("[data-market-overview]");
					var label = details.querySelector("[data-market-overview-toggle-label]");
					var stored = null;

					try {
						stored = window.localStorage.getItem("se-market-details");
					} catch (error) {}

					var large = window.matchMedia(
						"(min-width: 992px) and (min-height: 820px)"
					).matches;

					// Small screens always start closed; the stored choice applies only
					// where there is room for Details.
					var open = large && stored !== "closed";

					details.open = open;
					root.setAttribute("data-market-details-state", open ? "open" : "closed");

					if (label) {
						var arabic = (document.documentElement.lang || "").indexOf("ar") === 0;

						label.textContent = open
							? (arabic ? "\u0625\u062e\u0641\u0627\u0621 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0633\u0648\u0642" : "Hide market details")
							: (arabic ? "\u0639\u0631\u0636 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0633\u0648\u0642" : "Show market details");
					}
				})();
			</script>
		</c:if>

