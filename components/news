<script>
  var root = document.documentElement;

  var LANGUAGE_RESTORE_TIMEOUT = 4000;
  var MOTION_FALLBACK_TIMEOUT = 3000;

  function getStoredValue(key, fallback) {
    try {
      var value = window.localStorage.getItem(key);

      return value !== null ? value : fallback;
    } catch (error) {
      return fallback;
    }
  }

  function getUrlLanguage() {
    try {
      var language = new URLSearchParams(window.location.search).get("locale");

      if (language === "ar" || language === "en") {
        return language;
      }

      return null;
    } catch (error) {
      return null;
    }
  }

  /* ==========================================================================
     Language
     ========================================================================== */

  var documentLanguage =
    root.getAttribute("lang") === "ar" ? "ar" : "en";

  var storedLanguage = getStoredValue("se-lang", null);
  var urlLanguage = getUrlLanguage();

  var resolvedLanguage = documentLanguage;

  if (urlLanguage === "ar" || urlLanguage === "en") {
    resolvedLanguage = urlLanguage;
  } else if (storedLanguage === "ar" || storedLanguage === "en") {
    resolvedLanguage = storedLanguage;
  }

  var resolvedDirection =
    resolvedLanguage === "ar" ? "rtl" : "ltr";

  root.setAttribute("lang", resolvedLanguage);
  root.setAttribute("dir", resolvedDirection);

  /* ==========================================================================
     Language Restoration
     ========================================================================== */

  if (resolvedLanguage !== documentLanguage) {
    root.style.visibility = "hidden";
    root.setAttribute("data-language-restoring", "true");

    window.__languageRestoreFallback = window.setTimeout(function () {
      root.style.removeProperty("visibility");
      root.removeAttribute("data-language-restoring");

      window.__languageRestoreFallback = null;
    }, LANGUAGE_RESTORE_TIMEOUT);
  }

  /* ==========================================================================
     Preferences
     ========================================================================== */

  var themeChoice = getStoredValue("se-theme", "system");
  var accent = getStoredValue("se-accent", "blue");
  var fontSize = getStoredValue("se-font-size", "0");
  var contrast = getStoredValue("se-contrast", "normal");
  var motion = getStoredValue("se-motion", "normal");

  /* ==========================================================================
     System Theme
     ========================================================================== */

  var systemTheme = "light";

  if (
    window.matchMedia &&
    window.matchMedia("(prefers-color-scheme: dark)").matches
  ) {
    systemTheme = "dark";
  }

  var resolvedTheme =
    themeChoice === "system" ? systemTheme : themeChoice;

  /* ==========================================================================
     Reduced Motion
     ========================================================================== */

  var prefersReducedMotion = false;

  if (
    window.matchMedia &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    prefersReducedMotion = true;
  }

  /* ==========================================================================
     Root State
     ========================================================================== */

  root.setAttribute("data-theme", resolvedTheme);
  root.setAttribute("data-theme-choice", themeChoice);
  root.setAttribute("data-accent", accent);
  root.setAttribute("data-font-size", fontSize);
  root.setAttribute("data-contrast", contrast);
  root.setAttribute("data-motion", motion);

  /* ==========================================================================
     Motion Bootstrap
     ========================================================================== */

  if (motion !== "reduce" && !prefersReducedMotion) {
    root.classList.add("motion-ready");

    window.__motionFallback = window.setTimeout(function () {
      window.__motionFallbackFired = true;

      root.classList.remove("motion-ready");

      window.__motionFallback = null;
    }, MOTION_FALLBACK_TIMEOUT);
  }
</script>