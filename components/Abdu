      topRow.append(
        createHeaderCell({
          label:
            group.label ||
            group.id,

          className:
            group.className ||
            "table-group-heading",

          scope:
            "colgroup",

          colSpan:
            groupColumns.length,

          headerGroup:
            group.id,
        }),
      );

      groupColumns.forEach(
        (column) => {
          bottomRow.append(
            createHeaderCell({
              label:
                getColumnLabel(
                  column,
                ),

              className:
                column.headerClassName ||
                column.className ||
                "",

              width:
                column.width ||
                "",

              visibilityGroup:
                column.visibilityGroup ||
                "",
            }),
          );
        },
      );
    },
  );

