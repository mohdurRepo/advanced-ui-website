      /* ------------------------------------------------------------------------
       Change
       ------------------------------------------------------------------------ */

      const change = card.querySelector('[data-market-card-field="change"]');

      setDataValue(
        change,
        item.netChange,
        item.netChange === null
          ? "—"
          : signedPriceFormatter.format(item.netChange),
      );

      applyPriceState(
        card.querySelector('[data-market-card-state="change"]'),
        item.netChange ?? 0,
      );

      /* ------------------------------------------------------------------------
       Volume / Value
       ------------------------------------------------------------------------ */

      if (type === "volume" || type === "value") {
        const extra = card.querySelector('[data-market-card-field="extra"]');

        const extraValue = getActivityExtraValue(type, item);

        setDataValue(extra, extraValue, formatActivityExtra(type, extraValue), {
          animate: !initial && extraValue !== null,
        });
      }

      /* ------------------------------------------------------------------------
       Five-day Performance
       ------------------------------------------------------------------------ */

      updatePerformanceElement(
        card.querySelector(".market-activity-table__performance"),
        item.performance,
      );
    }

    function renderActivityCards(type, items, { initial = false } = {}) {
      const container = document.querySelector(
        `[data-market-activity-cards="${type}"]`,
      );

      if (!container) {
        return;
      }

      const existingCards = new Map(
        Array.from(container.querySelectorAll("[data-market-symbol]")).map(
          (card) => [card.dataset.marketSymbol, card],
        ),
      );

      /*
       * Removes initial loading cards and any old
       * empty/error message before rendering data.
       */

      container
        .querySelectorAll(
          ".data-card:not([data-market-symbol]), .data-view__empty",
        )
        .forEach((element) => {
          element.remove();
        });

      const visibleSymbols = new Set();

      items.forEach((item) => {
        visibleSymbols.add(item.symbol);

        let card = existingCards.get(item.symbol);

        const isNew = !card;

        if (!card) {
          card = createActivityCard(type, item);
        }

        updateActivityCard(card, type, item, {
          initial: initial || isNew,
        });

        /*
         * Existing cards are moved into the new
         * server-provided ranking rather than all
         * cards being destroyed/recreated.
         */

        container.appendChild(card);
      });

      existingCards.forEach((card, symbol) => {
        if (!visibleSymbols.has(symbol)) {
          card.remove();
        }
      });
    }

    /* ========================================================================
     Activity Empty / Error States
     ======================================================================== */

    function renderActivityMessage(type, message) {
      const body = document.querySelector(
        `[data-market-activity-body="${type}"]`,
      );

      const cards = document.querySelector(
        `[data-market-activity-cards="${type}"]`,
      );

      /* ------------------------------------------------------------------------
       Table
       ------------------------------------------------------------------------ */

      if (body) {
        body.replaceChildren();

        /*
         * table-loading IS appropriate here.
         *
         * This is one single full-width message row,
         * not one class per skeleton row.
         */

        const row = document.createElement("tr");

        row.className = "table-loading";

        const cell = document.createElement("td");

        cell.colSpan = getActivityColumnCount(type);

        cell.textContent = message;

        row.appendChild(cell);

        body.appendChild(row);
      }

      /* ------------------------------------------------------------------------
       Mobile
       ------------------------------------------------------------------------ */

      if (cards) {
        cards.replaceChildren();

        const messageElement = document.createElement("p");

        messageElement.className = "data-view__empty";

        messageElement.textContent = message;

        cards.appendChild(messageElement);
      }
    }

    function completeActivityLoading(type) {
      document
        .querySelector(`[data-market-activity-view="${type}"]`)
        ?.setAttribute("aria-busy", "false");

      document
        .querySelector(`[data-market-activity-table="${type}"]`)
        ?.setAttribute("aria-busy", "false");
    }

    /* ========================================================================
     Activity Requests
     ======================================================================== */

    async function loadActivity(type, { force = false } = {}) {
      if (!ACTIVITY_TYPES.includes(type)) {
        return;
      }

      const activityState = state.activity[type];

      /*
       * First load is lazy.
       *
       * Once loaded, force=true allows a refresh.
       */

      if (activityState.loaded && !force) {
        return;
      }

      const baseUrl = getActivityUrl(type);

      if (!baseUrl) {
        console.error(`Market activity URL is missing for ${type}.`);

        if (!activityState.loaded) {
          renderActivityMessage(
            type,
            "Market data is temporarily unavailable.",
          );

          completeActivityLoading(type);
        }

        return;
      }

      /*
       * Prevent overlapping/stale requests for the
       * same dataset.
       */

      activityState.controller?.abort();

      const controller = new AbortController();

      activityState.controller = controller;

      const initial = !activityState.loaded;

      try {
        const payload = await requestJson(buildResourceUrl(baseUrl), {
          signal: controller.signal,
        });

        const items = normalizeActivityResponse(payload);

        /*
         * Keep the normalized backend objects available
         * for interactions such as watchlist actions.
         */

        activityState.items = new Map(items.map((item) => [item.symbol, item]));

        if (!items.length) {
          renderActivityMessage(type, "No market activity is available.");

          activityState.loaded = true;

          completeActivityLoading(type);

          return;
        }

        renderActivityTable(type, items, {
          initial,
        });

        renderActivityCards(type, items, {
          initial,
        });

        activityState.loaded = true;

        completeActivityLoading(type);
      } catch (error) {
        if (error.name === "AbortError") {
          return;
        }

        console.error(`Unable to load ${type} market activity:`, error);

        /*
         * Initial failure:
         * replace skeleton with unavailable message.
         *
         * Refresh failure:
         * keep previous successful values visible.
         */

        if (!activityState.loaded) {
          renderActivityMessage(
            type,
            "Market data is temporarily unavailable.",
          );

          completeActivityLoading(type);
        }
      } finally {
        if (activityState.controller === controller) {
          activityState.controller = null;
        }
      }
    }

    /* ========================================================================
     Tabs / Active Dataset
     ======================================================================== */

    function getActivityTypeFromTab(tab) {
      const target = tab?.getAttribute("data-tab-target");

      if (!target) {
        return null;
      }

      const match = target.match(
        /^activity-(gainers|losers|volume|value)-panel$/,
      );

      return match?.[1] || null;
    }

    function getActiveActivityType() {
      const activeTab = document.querySelector(
        '.market-activity__tab[aria-selected="true"]',
      );

      return getActivityTypeFromTab(activeTab) || "gainers";
    }

    /* ========================================================================
     Mobile Card Expansion
     ======================================================================== */

    function toggleCardDetails(button) {
      const card = button.closest(".data-card");

      if (!card) {
        return;
      }

      const details = card.querySelector("[data-market-card-details]");

      if (!details) {
        return;
      }

      const expanded = button.getAttribute("aria-expanded") === "true";

      const nextExpanded = !expanded;

      button.setAttribute("aria-expanded", String(nextExpanded));

      details.hidden = !nextExpanded;

      card.classList.toggle("is-expanded", nextExpanded);

      const label = button.querySelector(".data-card__toggle-label");

      if (label) {
        label.textContent = nextExpanded ? "Hide details" : "Show details";
      }
    }

    /* ========================================================================
     Event Delegation
     ======================================================================== */

    document.addEventListener("click", (event) => {
      /* ----------------------------------------------------------------------
         Activity Tab
         ---------------------------------------------------------------------- */

      const tab = event.target.closest(
        ".market-activity__tab[data-tab-target]",
      );

      if (tab) {
        const type = getActivityTypeFromTab(tab);

        if (type) {
          /*
           * First visit:
           * load the dataset.
           *
           * Later visits:
           * refresh it immediately so the user does
           * not see an old cached tab.
           */

          loadActivity(type, {
            force: state.activity[type].loaded,
          });
        }
      }

      /* ----------------------------------------------------------------------
         Mobile Details
         ---------------------------------------------------------------------- */

      const cardToggle = event.target.closest("[data-market-card-toggle]");

      if (cardToggle) {
        toggleCardDetails(cardToggle);

        return;
      }

      /* ----------------------------------------------------------------------
         Watchlist
         ---------------------------------------------------------------------- */

      const watchlistButton = event.target.closest("[data-market-watchlist]");

      if (!watchlistButton) {
        return;
      }

      const symbol = watchlistButton.dataset.marketWatchlist;

      const type = ACTIVITY_TYPES.find((activityType) =>
        document
          .querySelector(`[data-market-activity-view="${activityType}"]`)
          ?.contains(watchlistButton),
      );

      if (!type || !symbol) {
        return;
      }

      const item = state.activity[type].items.get(symbol);

      handleWatchlist(item);
    });

    /* ========================================================================
     Production Refresh Cycle
     ======================================================================== */

    async function refreshVisibleMarketData() {
      if (document.hidden) {
        return;
      }

      const activeType = getActiveActivityType();

      /*
       * Hero always refreshes.
       *
       * Only the currently visible activity dataset
       * refreshes automatically.
       *
       * Inactive tabs refresh when opened.
       */

      await Promise.allSettled([
        loadMarketIndex({
          initial: false,
        }),

        loadActivity(activeType, {
          force: true,
        }),
      ]);
    }

    function stopRefreshTimer() {
      if (!state.refreshTimer) {
        return;
      }

      window.clearInterval(state.refreshTimer);

      state.refreshTimer = null;
    }

    function startRefreshTimer() {
      stopRefreshTimer();

      state.refreshTimer = window.setInterval(
        refreshVisibleMarketData,
        REFRESH_INTERVAL,
      );
    }

    /* ========================================================================
     Page Visibility
     ======================================================================== */

    document.addEventListener("visibilitychange", () => {
      if (!state.started) {
        return;
      }

      if (document.hidden) {
        stopRefreshTimer();

        /*
         * Abort requests that no longer need to finish
         * while the user is away.
         */

        state.index.controller?.abort();

        ACTIVITY_TYPES.forEach((type) => {
          state.activity[type].controller?.abort();
        });

        return;
      }

      /*
       * User returned:
       *
       * refresh immediately, then restart the normal
       * 60-second cadence.
       */

      refreshVisibleMarketData();

      startRefreshTimer();
    });

    /* ========================================================================
     Start
     ======================================================================== */

    async function initialize() {
      state.started = true;

      /*
       * Initial page load:
       *
       * - TASI loads immediately.
       * - Gainers loads immediately because it is the
       *   default selected activity tab.
       * - Losers / Volume / Value remain skeletons until
       *   the user opens those tabs.
       */

      await Promise.allSettled([
        loadMarketIndex({
          initial: true,
        }),

        loadActivity("gainers"),
      ]);

      startRefreshTimer();
    }

    initialize();
  })();
</script>
