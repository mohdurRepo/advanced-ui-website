<%-- ==========================================================================
Historical Reports Hero
==========================================================================
Page-level introduction for Historical Reports. The decorative background is
hidden from assistive technology. The visible heading provides the accessible
name for the section.
========================================================================== --%>

<section
  class="hero-section surface-hero"
  aria-labelledby="historical-reports-title"
>
  <div class="hero-section__background" aria-hidden="true"></div>

  <div class="container hero-section__content">
    <header class="hero-intro">
      <div class="hero-intro__header">
        <div class="hero-intro__brand">
          <span
            class="hero-intro__icon has-icon icon-tadawul"
            aria-hidden="true"
          ></span>

          <h2 class="hero-intro__title" id="historical-reports-title">
            <fmt:message key="page.header" />
          </h2>
        </div>
      </div>
    </header>
  </div>
</section>
<%-- ==========================================================================
     Historical Reports Filters
     ==========================================================================

     Historical filter surface.

     Responsibilities:
     - Market selection
     - Sector selection
     - Entity selection
     - conditional Trade Type selection
     - date-range selection
     - Reset action

     Validation/result messaging is intentionally NOT rendered inside this
     form. Page-level filter guidance is displayed in the Historical content
     placeholder so users receive one clear message instead of duplicate
     messages beneath individual controls.
     ========================================================================== --%>

<section
  class="section historical-filters pb-0"
  aria-labelledby="historical-filters-title"
>
  <div class="container">

    <form
      class="filter-bar filter-bar--connected"
      data-historical-filters
      aria-labelledby="historical-filters-title"
      novalidate
    >
      <h2
        class="visually-hidden"
        id="historical-filters-title"
      >
        <fmt:message key="page.header" />
      </h2>

      <div class="filter-bar__inner">

        <%-- ====================================================================
             Filter Fields
             ==================================================================== --%>

        <div class="filter-bar__fields grid-4">

          <%-- ==================================================================
               Market
               ================================================================== --%>

          <div class="filter-bar__field">
            <label
              class="form-label"
              for="historical-market"
            >
              <fmt:message key="market.title" />

              <span
                class="form-required"
                aria-hidden="true"
              >
                *
              </span>
            </label>

            <div
              class="custom-select"
              data-custom-select
              data-searchable
            >
              <div class="form-select-wrap custom-select__fallback">

                <select
                  class="form-select custom-select__native"
                  id="historical-market"
                  name="market"
                  data-historical-market
                  required
                >
                  <option
                    value="-1"
                    <c:if test="${empty requestScope.selectedMarket or requestScope.selectedMarket eq '-1'}">
                      selected
                    </c:if>
                  >
                    <fmt:message key="market.default.value" />
                  </option>

                  <c:forEach
                    items="${requestScope.marketIndicesList}"
                    var="item"
                  >
                    <option
                      value="<c:out value='${item.value}' />"
                      <c:if test="${item.value == requestScope.selectedMarket}">
                        selected
                      </c:if>
                    >
                      <c:out value="${item.text}" />
                    </option>
                  </c:forEach>
                </select>

                <span
                  class="form-select-icon has-icon icon-chevron-down"
                  aria-hidden="true"
                ></span>

              </div>
            </div>
          </div>

          <%-- ==================================================================
               Sector

               Sector remains non-blocking in Historical business validation.
               The dependency layer still owns enable/disable and population.
               ================================================================== --%>

          <div class="filter-bar__field">
            <label
              class="form-label"
              for="historical-sector"
            >
              <fmt:message key="sector.title" />
            </label>

            <div
              class="custom-select"
              data-custom-select
              data-searchable
            >
              <div class="form-select-wrap custom-select__fallback">

                <select
                  class="form-select custom-select__native"
                  id="historical-sector"
                  name="sector"
                  data-historical-sector
                >
                  <option
                    value="0"
                    <c:if test="${empty requestScope.selectedSector or requestScope.selectedSector eq '0'}">
                      selected
                    </c:if>
                  >
                    <fmt:message key="sector.default.value" />
                  </option>

                  <c:forEach
                    items="${requestScope.sectorList}"
                    var="item"
                  >
                    <option
                      value="<c:out value='${item.dropdownValue}' />"
                      <c:if test="${item.dropdownValue == requestScope.selectedSector}">
                        selected
                      </c:if>
                    >
                      <c:out value="${item.name}" />
                    </option>
                  </c:forEach>
                </select>

                <span
                  class="form-select-icon has-icon icon-chevron-down"
                  aria-hidden="true"
                ></span>

              </div>
            </div>
          </div>

          <%-- ==================================================================
               Entity
               ================================================================== --%>

          <div class="filter-bar__field">
            <label
              class="form-label"
              for="historical-entity"
            >
              <fmt:message key="entity.title" />

              <span
                class="form-required"
                aria-hidden="true"
              >
                *
              </span>
            </label>

            <div
              class="custom-select"
              data-custom-select
              data-searchable
            >
              <div class="form-select-wrap custom-select__fallback">

                <select
                  class="form-select custom-select__native"
                  id="historical-entity"
                  name="entity"
                  data-historical-entity
                  required
                >
                  <option
                    value="0"
                    <c:if test="${empty requestScope.selectedEntity or requestScope.selectedEntity eq '0'}">
                      selected
                    </c:if>
                  >
                    <fmt:message key="entity.default.value" />
                  </option>

                  <c:forEach
                    items="${requestScope.entityList}"
                    var="item"
                  >
                    <option
                      value="<c:out value='${item.entitySymbol}' />"
                      <c:if test="${item.entitySymbol == requestScope.selectedEntity}">
                        selected
                      </c:if>
                    >
                      <c:out value="${item.entityName}" />
                    </option>
                  </c:forEach>
                </select>

                <span
                  class="form-select-icon has-icon icon-chevron-down"
                  aria-hidden="true"
                ></span>

              </div>
            </div>
          </div>

          <%-- ==================================================================
               Trade Type

               Historical rules reveal this field only for:
               - Market = SUKUK
               - Sector = G or S

               When hidden, Historical JS forces the source value back to OB.
               ================================================================== --%>

          <div
            class="filter-bar__field"
            id="tradeTypeFilter"
            hidden
          >
            <label
              class="form-label"
              for="historical-trade-type"
            >
              <fmt:message key="trade.title" />
            </label>

            <div
              class="custom-select"
              data-custom-select
            >
              <div class="form-select-wrap custom-select__fallback">

                <select
                  class="form-select custom-select__native"
                  id="historical-trade-type"
                  name="tradeType"
                  data-historical-trade-type
                >
                  <option
                    value="OB"
                    selected
                  >
                    <fmt:message key="type.of.trade.option.1" />
                  </option>

                  <option value="OTC">
                    <fmt:message key="type.of.trade.option.2" />
                  </option>

                  <option value="ND">
                    <fmt:message key="type.of.trade.option.3" />
                  </option>
                </select>

                <span
                  class="form-select-icon has-icon icon-chevron-down"
                  aria-hidden="true"
                ></span>

              </div>
            </div>
          </div>

          <%-- ==================================================================
               Time Period

               Uses the standard filter-bar field contract rather than
               fieldset/legend so its label and control align exactly with the
               select controls.
               ================================================================== --%>

          <div class="filter-bar__field">

            <span
              class="form-label-static"
              id="historical-date-label"
            >
              <fmt:message key="filter.date" />

              <span
                class="form-required"
                aria-hidden="true"
              >
                *
              </span>
            </span>

            <div
              class="custom-date custom-date--range"
              data-custom-date-range
              data-placeholder="YYYY-MM-DD – YYYY-MM-DD"
              aria-labelledby="historical-date-label"
            >
              <div class="custom-date__fallback">

                <%-- Native progressive-enhancement fallback --%>

                <div class="custom-date__native-range">

                  <input
                    class="form-control custom-date__native"
                    id="historical-date-start"
                    name="startDate"
                    type="date"
                    data-date-start
                    data-historical-date-start
                    aria-label="<fmt:message key='filter.date' /> start"
                    required
                  />

                  <input
                    class="form-control custom-date__native"
                    id="historical-date-end"
                    name="endDate"
                    type="date"
                    data-date-end
                    data-historical-date-end
                    aria-label="<fmt:message key='filter.date' /> end"
                    required
                  />

                </div>

                <%-- Initial enhanced-control placeholder --%>

                <div
                  class="custom-date__initial-trigger"
                  aria-hidden="true"
                >
                  <span class="custom-date__initial-value is-placeholder">
                    YYYY-MM-DD – YYYY-MM-DD
                  </span>

                  <span
                    class="custom-date__initial-indicator has-icon icon-calendar-scheduler"
                    aria-hidden="true"
                  ></span>
                </div>

              </div>
            </div>
          </div>

        </div>

        <%-- ====================================================================
             Actions

             Reset remains outside filter-bar__fields so the shared filter-bar
             layout can align it with the controls instead of their labels.
             ==================================================================== --%>

        <div class="filter-bar__actions">

          <button
            type="button"
            class="btn btn-outline-primary has-icon icon-sync-refresh icon-end"
            data-historical-reset
          >
            <fmt:message key="reset.btn.title" />
          </button>

        </div>

      </div>
    </form>

  </div>
</section>
<%-- ==========================================================================
     Historical Reports Content
     ==========================================================================

     Historical result area.

     The active business profile determines which result surface is shown:

     - Performance / Unadjusted:
       connected tabbed report surface

     - Derivatives Single Stock Options:
       connected Underlying surface

     - incomplete / invalid filter state:
       connected page-level guidance surface

     Notes and pagination remain outside the report surface because their
     visibility and lifecycle are coordinated independently.
     ========================================================================== --%>

<section
  class="section-none historical-reports"
  aria-label="<fmt:message key='page.header' />"
  data-historical-content
>
  <div class="container">

    <%-- ========================================================================
         Performance / Unadjusted Results
         ========================================================================

         The tabs themselves own the connected result surface.

         tabs--contained:
         - visually contains navigation + active panel
         - removes the floating-tabs appearance
         - keeps primary underline tab behavior

         data-view / data-view--connected:
         - keeps the report aligned with the connected filter composition
         - provides the shared data-view workspace contract
         ======================================================================== --%>

    <div
      class="tabs tabs--full tabs--contained data-view data-view--connected"
      data-tabs
      data-historical-tabs
    >

      <%-- ======================================================================
           Tab Navigation
           ====================================================================== --%>

      <div
        class="tabs-nav"
        role="tablist"
        aria-label="<fmt:message key='page.header' />"
      >

        <%-- Performance --%>

        <button
          type="button"
          class="tab-link active"
          role="tab"
          id="historical-tab-performance"
          data-tab="performance"
          data-tab-target="historical-panel-performance"
          aria-controls="historical-panel-performance"
          aria-selected="true"
          tabindex="0"
        >
          <fmt:message key="performance.tab.title" />
        </button>

        <%-- Unadjusted Price & Volume --%>

        <button
          type="button"
          class="tab-link"
          role="tab"
          id="historical-tab-unadjusted"
          data-tab="unadjusted"
          data-tab-target="historical-panel-unadjusted"
          aria-controls="historical-panel-unadjusted"
          aria-selected="false"
          tabindex="-1"
        >
          <fmt:message key="unadjust.price.tab.title" />
        </button>

      </div>

      <%-- ======================================================================
           Tab Content
           ====================================================================== --%>

      <div class="tabs-content">

        <%-- ====================================================================
             Performance
             ==================================================================== --%>

        <section
          class="tab-pane active"
          id="historical-panel-performance"
          role="tabpanel"
          aria-labelledby="historical-tab-performance"
          aria-hidden="false"
          data-historical-view="performance"
        >
          <div class="data-view__workspace">

            <%-- ================================================================
                 Desktop / Tablet Table
                 ================================================================ --%>

            <div class="data-view__table">

              <div
                class="table-shell"
                data-table-shell
              >
                <section
                  class="table-responsive custom-scrollbar"
                  tabindex="0"
                  role="region"
                  aria-label="<fmt:message key='performance.tab.title' />"
                >
                  <table
                    id="historical-performance-table"
                    class="table table-hover table-nowrap"
                    data-historical-table="performance"
                    aria-busy="true"
                  >
                    <caption class="visually-hidden">
                      <fmt:message key="performance.tab.title" />
                    </caption>

                    <%--
                      Historical columns are generated from the active
                      market/profile schema.

                      common/data-view/data-table.js owns:
                      - generated header cells
                      - column visibility
                      - skeleton loading rows
                      - empty/error table states
                      - DataTables lifecycle
                    --%>

                    <thead>
                      <tr></tr>
                    </thead>

                    <tbody></tbody>
                  </table>
                </section>

                <%-- ============================================================
                     Horizontal Table Navigation
                     ============================================================ --%>

                <button
                  type="button"
                  class="table-scroll-jump has-icon icon-chevron-right-bold icon-md icon-flip-rtl"
                  data-table-scroll-jump
                  data-table-scroll-direction="end"
                  aria-label="Jump to last columns"
                  title="Jump to last columns"
                  hidden
                >
                  <span class="visually-hidden">
                    Jump to last columns
                  </span>
                </button>

              </div>
            </div>

            <%-- ================================================================
                 Mobile Cards
                 ================================================================ --%>

            <div
              class="data-view__cards"
              aria-label="<fmt:message key='performance.tab.title' />"
            >
              <div
                class="data-view__cards-inner"
                data-historical-mobile-cards="performance"
                aria-busy="true"
              ></div>
            </div>

          </div>
        </section>

        <%-- ====================================================================
             Unadjusted Price & Volume
             ==================================================================== --%>

        <section
          class="tab-pane"
          id="historical-panel-unadjusted"
          role="tabpanel"
          aria-labelledby="historical-tab-unadjusted"
          aria-hidden="true"
          data-historical-view="unadjusted"
          hidden
        >
          <div class="data-view__workspace">

            <%-- ================================================================
                 Desktop / Tablet Table
                 ================================================================ --%>

            <div class="data-view__table">

              <div
                class="table-shell"
                data-table-shell
              >
                <section
                  class="table-responsive custom-scrollbar"
                  tabindex="0"
                  role="region"
                  aria-label="<fmt:message key='unadjust.price.tab.title' />"
                >
                  <table
                    id="historical-unadjusted-table"
                    class="table table-hover table-nowrap"
                    data-historical-table="unadjusted"
                    aria-busy="true"
                  >
                    <caption class="visually-hidden">
                      <fmt:message key="unadjust.price.tab.title" />
                    </caption>

                    <%--
                      Unadjusted columns are generated from the Historical
                      schema.

                      Historical owns business-specific visibility.
                      common/data-view owns rendering and table lifecycle.
                    --%>

                    <thead>
                      <tr></tr>
                    </thead>

                    <tbody></tbody>
                  </table>
                </section>

                <%-- ============================================================
                     Horizontal Table Navigation
                     ============================================================ --%>

                <button
                  type="button"
                  class="table-scroll-jump has-icon icon-chevron-right-bold icon-md icon-flip-rtl"
                  data-table-scroll-jump
                  data-table-scroll-direction="end"
                  aria-label="Jump to last columns"
                  title="Jump to last columns"
                  hidden
                >
                  <span class="visually-hidden">
                    Jump to last columns
                  </span>
                </button>

              </div>
            </div>

            <%-- ================================================================
                 Mobile Cards
                 ================================================================ --%>

            <div
              class="data-view__cards"
              aria-label="<fmt:message key='unadjust.price.tab.title' />"
            >
              <div
                class="data-view__cards-inner"
                data-historical-mobile-cards="unadjusted"
                aria-busy="true"
              ></div>
            </div>

          </div>
        </section>

      </div>
    </div>

    <%-- ========================================================================
         Derivatives Underlying
         ========================================================================

         This is intentionally not a tab.

         Historical rules replace the Performance / Unadjusted surface with
         this view for:

         DERIVATIVE -> Single Stock Options

         Underlying remains:
         - client-side
         - non-paged
         - independently loaded
         ======================================================================== --%>

    <section
      id="historical-underlying-section"
      data-historical-underlying-section
      aria-labelledby="historical-underlying-title"
      hidden
    >
      <h2
        class="visually-hidden"
        id="historical-underlying-title"
      >
        <fmt:message key="derivatives.market.watch.sso" />
      </h2>

      <div
        class="data-view data-view--connected"
        data-historical-view="underlying"
      >
        <div class="data-view__workspace">

          <%-- ================================================================
               Desktop / Tablet Table
               ================================================================ --%>

          <div class="data-view__table">

            <div
              class="table-shell"
              data-table-shell
            >
              <section
                class="table-responsive custom-scrollbar"
                tabindex="0"
                role="region"
                aria-label="<fmt:message key='derivatives.market.watch.sso' />"
              >
                <table
                  id="historical-underlying-table"
                  class="table table-hover table-nowrap"
                  data-historical-table="underlying"
                  aria-busy="true"
                >
                  <caption class="visually-hidden">
                    <fmt:message key="derivatives.market.watch.sso" />
                  </caption>

                  <thead>
                    <tr></tr>
                  </thead>

                  <tbody></tbody>
                </table>
              </section>

              <%-- ==============================================================
                   Horizontal Table Navigation
                   ============================================================== --%>

              <button
                type="button"
                class="table-scroll-jump has-icon icon-chevron-right-bold icon-md icon-flip-rtl"
                data-table-scroll-jump
                data-table-scroll-direction="end"
                aria-label="Jump to last columns"
                title="Jump to last columns"
                hidden
              >
                <span class="visually-hidden">
                  Jump to last columns
                </span>
              </button>

            </div>
          </div>

          <%-- ================================================================
               Mobile Cards
               ================================================================ --%>

          <div
            class="data-view__cards"
            aria-label="<fmt:message key='derivatives.market.watch.sso' />"
          >
            <div
              class="data-view__cards-inner"
              data-historical-mobile-cards="underlying"
              aria-busy="true"
            ></div>
          </div>

        </div>
      </div>
    </section>

    <%-- ========================================================================
         Historical Reports Notes
         ========================================================================

         Shared note-panel design-system component.

         historical.rules.js resolves the semantic note key.
         historical.js clones the matching trusted JSP template content into
         the appropriate note-panel instance.
         ======================================================================== --%>

    <%-- Default Note --%>

    <div
      class="note-panel mt-6"
      id="historical-note"
      data-historical-note="default"
      role="note"
      aria-live="polite"
      hidden
    >
      <div class="note-panel__item">

        <span
          class="note-panel__marker has-icon icon-check"
          aria-hidden="true"
        ></span>

        <div
          class="note-panel__content"
          id="historical-note-text"
          data-historical-note-content
        ></div>

      </div>
    </div>

    <%-- Derivatives Note --%>

    <div
      class="note-panel mt-6"
      id="historical-note-derivatives"
      data-historical-note="derivatives"
      role="note"
      aria-live="polite"
      hidden
    >
      <div class="note-panel__item">

        <span
          class="note-panel__marker has-icon icon-check"
          aria-hidden="true"
        ></span>

        <div
          class="note-panel__content"
          id="historical-note-derivatives-text"
          data-historical-note-content
        ></div>

      </div>
    </div>

    <%-- ========================================================================
         Note Templates
         ========================================================================

         These templates are inert until Historical JS clones their content.

         Content is trusted server-rendered application/resource-bundle
         content. User-provided HTML must never be inserted here unsanitized.
         ======================================================================== --%>

    <template data-historical-note-template="indexType">
      <fmt:message key="note1" />
    </template>

    <template data-historical-note-template="mainMarketTasi">
      <fmt:message key="main.market.indices.tasi.note1" />
    </template>

    <template data-historical-note-template="derivativeChangePoints">
      <fmt:message key="derivative.performance.foonote.change.points" />
    </template>

    <template data-historical-note-template="mfNav">
      <fmt:message key="mf.performance.foonote.nav" />
    </template>

    <%-- ========================================================================
         Historical Reports Page Placeholder
         ========================================================================

         Page-level state used when the current filter/business-rule state
         cannot display one of the normal report views.

         Examples:
         - required filter values are incomplete
         - the current state requires user guidance before loading a report

         This is intentionally presented through the same connected data-view
         surface as normal report content so the filter/result composition
         remains visually complete.

         Ordinary zero-row API responses remain owned by data-table/data-cards.
         ======================================================================== --%>

    <div
      id="historical-empty-state"
      class="data-view data-view--connected"
      data-historical-placeholder
      hidden
    >
      <div class="data-view__workspace">

        <section
          class="text-center py-8"
          aria-live="polite"
          aria-atomic="true"
        >
          <img
            id="historical-empty-image"
            src="${pageContext.request.contextPath}/images/no-data.png"
            class="w-100"
            style="max-width: 300px; margin-inline: auto;"
            data-historical-placeholder-image
            alt=""
            hidden
          />

          <p
            id="historical-placeholder-message"
            class="text-muted"
            data-historical-placeholder-message
          ></p>
        </section>

      </div>
    </div>

    <%-- ========================================================================
         Historical Reports Pagination
         ========================================================================

         Shared only by:
         - Performance
         - Unadjusted Price & Volume

         Derivatives Underlying does not use report pagination.

         common/data-view/data-pagination.js owns:
         - result range
         - Previous
         - page numbers
         - ellipsis
         - current page
         - Next
         ======================================================================== --%>

    <nav
      class="pagination mt-6"
      data-historical-pagination
      aria-label="<fmt:message key='pagination.page' />"
      aria-busy="false"
      hidden
    >
      <%-- Result Range --%>

      <p
        class="pagination__summary"
        data-historical-pagination-summary
        aria-live="polite"
      ></p>

      <%-- Dynamic Page Controls --%>

      <ol
        class="pagination__list"
        data-historical-pagination-list
      ></ol>
    </nav>

  </div>
</section>
<%-- ==========================================================================
     Historical Reports Page Configuration
     ==========================================================================

     Server-rendered configuration consumed by:

       js/pages/historical/historical.js

     Responsibilities:
     - locale
     - backend resource endpoints
     - initial/reset filter values
     - Historical business constants
     - DataTables configuration
     - translated UI labels
     - table-column labels

     Business behavior remains implemented in the Historical JavaScript
     modules rather than in this JSP configuration block.
     ========================================================================== --%>

<script>
  window.HistoricalConfig = {

    /* ========================================================================
       Locale
       ======================================================================== */

    locale:
      "${requestScope.requestLocale}",

    /* ========================================================================
       Endpoints
       ======================================================================== */

    endpoints: {
      report:
        "<portlet:resourceURL id='populateCompanyDetails'></portlet:resourceURL>",

      underlying:
        "<portlet:resourceURL id='getSingleStockOptionsTableCompanyData'></portlet:resourceURL>",

      sectors:
        "<portlet:resourceURL id='populateSectors'></portlet:resourceURL>",

      entities:
        "<portlet:resourceURL id='populateEntity'></portlet:resourceURL>"
    },

    /* ========================================================================
       Defaults / Reset Targets
       ======================================================================== */

    defaults: {
      market:
        "${requestScope.selectedMarket}",

      sector:
        "${requestScope.selectedSector}",

      entity:
        "${requestScope.selectedEntity}",

      tradeType:
        "OB"
    },

    /* ========================================================================
       Business Rule Constants
       ======================================================================== */

    constants: {
      marketsWithoutSector: [
        "ETFS",
        "MF",
        "TR"
      ]
    },

    /* ========================================================================
       DataTables Configuration
       ======================================================================== */

    table: {

      /* ----------------------------------------------------------------------
         Performance / Unadjusted
         ---------------------------------------------------------------------- */

      report: {
        serverSide:
          true,

