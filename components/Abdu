      };

    /* ------------------------------------------------------------------------
       Init Complete
       ------------------------------------------------------------------------ */

    const userInitComplete =
      tableOptions.initComplete;

    generated.initComplete =
      function initComplete(
        settings,
        json,
      ) {
        updateHeaderVisibility();

        /*
         * Initialization is not guaranteed to produce another draw after the
         * DataTables instance is fully ready, so keep the explicit init
         * refresh.
         */

        scheduleLayoutRefresh();

        userInitComplete?.call(
          this,
          settings,
          json,
        );

        options.onInit?.(
          api,
          getContext(),
        );
      };

    return generated;
  }

  /* ==========================================================================
     Header
     ========================================================================== */

  function buildHeader() {
    if (
      headerMode ===
      "existing"
    ) {
      return;
    }

    const columns =
      getCurrentColumns();

    const groups =
      getCurrentGroups();

    /* ------------------------------------------------------------------------
       Caller-Provided Complex Header
       ------------------------------------------------------------------------ */

    if (renderHeader) {
      const result =
        renderHeader({
          table,

          view:
            currentView,

          columns: [
            ...columns,
          ],

          groups: [
            ...groups,
          ],

          context:
            getContext(),
        });

      if (
        result &&
        typeof result.then ===
          "function"
      ) {
        throw new TypeError(
          "Data table renderHeader() must be synchronous.",
        );
      }

      /*
       * Returning false requests the standard schema-generated header.
       *
       * This lets one table use a custom header for only selected views.
       */

      if (result !== false) {
        if (
          !table.tHead ||
          !table.tHead.rows.length
        ) {
          throw new Error(
            "Data table renderHeader() must attach a non-empty thead.",
          );
        }

        return;
      }
    }

    /* ------------------------------------------------------------------------
       Standard Schema Header
       ------------------------------------------------------------------------ */

    buildSchemaHeader(
      table,
      columns,
      groups,
    );
  }

  /* ==========================================================================
     Creation
     ========================================================================== */

  function createInstance() {
    if (destroyed) {
      return;
    }

    table.dataset.dataView =
      currentView;

    buildHeader();

    api =
      new DataTable(
        table,
        buildDataTableOptions(),
      );

    bindServerSideLifecycle();
  }

  /* ==========================================================================
     Destruction
     ========================================================================== */

  function destroyInstance() {
    if (!api) {
      return;
    }

    options.beforeDestroy?.(
      api,
      getContext(),
    );

    api.destroy();

    api =
      null;
  }

  function recreate() {
    if (destroyed) {
      return;
    }

    destroyInstance();

    createInstance();
  }

  /* ==========================================================================
     Rows
     ========================================================================== */

  function setRows(
    nextRows = [],
  ) {
    if (destroyed) {
      return;
    }

    rows =
      Array.isArray(
        nextRows,
      )
        ? nextRows
        : [];

    renderState =
      null;

    table.setAttribute(
      "aria-busy",
      "false",
    );

    if (!api) {
      createInstance();

      return;
    }

    /*
     * Server-side tables fetch their own rows through `ajax`.
     *
     * Calling setRows() on one is usually a sign that the caller meant
     * reload(), but expose the rows through the optional callback for
     * integrations that deliberately observe them.
     */

    if (
      tableOptions.serverSide
    ) {
      options.onServerSideRows?.(
        rows,
        api,
        getContext(),
      );

      return;
    }

    api.clear();

    if (rows.length) {
      api.rows.add(
        rows,
      );
    }

    /*
     * drawCallback owns the post-draw layout hook.
     */

    api.draw(
      false,
    );

    options.onRowsChange?.(
      rows,
      api,
      getContext(),
    );
  }

  /* ==========================================================================
     Loading
     ========================================================================== */

  function showLoading() {
    if (destroyed) {
      return;
    }

    renderState = {
      type:
        STATES.loading,

      message:
        "",
    };

    table.setAttribute(
      "aria-busy",
      "true",
    );

    if (!api) {
      createInstance();

      return;
    }

    /*
     * Server-side loading state is driven by DataTables' processing.dt
     * lifecycle because DataTables itself decides when a request begins.
     */

    if (
      tableOptions.serverSide
    ) {
      return;
    }

    api.clear();

    api.rows.add(
      createLoadingRows(
        options.loadingRowCount ||
          6,

        getContext(),
      ),
    );

    /*
     * drawCallback owns the post-draw layout hook.
     */

    api.draw(
      false,
    );
  }

  /* ==========================================================================
     Empty
     ========================================================================== */

  function showEmpty(
    message,
  ) {
    if (destroyed) {
      return;
    }

    rows =
      [];

    renderState = {
      type:
        STATES.empty,

      message:
        message ||
        options.emptyMessage ||
        "No data available",
    };

    table.setAttribute(
      "aria-busy",
      "false",
    );

    if (!api) {
      createInstance();

      return;
    }

    /*
     * Server-side DataTables renders its own td.dt-empty marker when the
     * response contains no rows. updateEmptyState() customizes that marker
     * from drawCallback.
     */

    if (
      tableOptions.serverSide
    ) {
      return;
    }

    api.clear();

    /*
     * drawCallback owns empty-state rendering and layout refresh.
     */

    api.draw(
      false,
    );
  }

  /* ==========================================================================
     Error
     ========================================================================== */

  function showError(
    message,
  ) {
    if (destroyed) {
      return;
    }

    rows =
      [];

    renderState = {
      type:
        STATES.error,

      message:
        message ||
        options.errorMessage ||
        options.emptyMessage ||
        "Unable to load data.",
    };

    table.setAttribute(
      "aria-busy",
      "false",
    );

    if (!api) {
      createInstance();

      return;
    }

    /*
     * Server-side ajax failures are surfaced through error.dt and/or the
     * page's function-form ajax callback. There is no local DataTables row
     * array to replace in this mode.
     */

    if (
      tableOptions.serverSide
    ) {
      return;
    }

    api.clear();

    /*
     * drawCallback owns error-state rendering and layout refresh.
     */

    api.draw(
      false,
    );
  }

  /* ==========================================================================
     Column Visibility
     ========================================================================== */

  function setVisibleGroups(
    nextGroups = [],
  ) {
    if (destroyed) {
      return false;
    }

    const groups =
      unique(
        nextGroups,
      );

    /*
     * Once the caller explicitly supplies visibility groups, visibility is
     * caller-owned rather than inferred automatically from the schema.
     */

    usesSchemaVisibility =
      false;

    if (
      arraysEqual(
        groups,
        visibleGroups,
      )
    ) {
      return false;
    }

    visibleGroups =
      groups;

    if (!api) {
      return true;
    }

    let changed =
      false;

    getCurrentColumns().forEach(
      (
        column,
        index,
      ) => {
        if (
          !column.visibilityGroup
        ) {
          return;
        }

        const shouldBeVisible =
          isColumnVisible(
            column,
            visibleGroups,
          );

        const dataTableColumn =
          api.column(
            index,
          );

        if (
          dataTableColumn.visible() ===
          shouldBeVisible
        ) {
          return;
        }

        /*
         * Defer redraw until every visibility change has been applied.
         */

        dataTableColumn.visible(
          shouldBeVisible,
          false,
        );

        changed =
          true;
      },
    );

    updateHeaderVisibility();

    if (changed) {
      /*
       * Visibility changes alter the available table width, so ask DataTables
       * to remeasure before performing one redraw.
       */

      api.columns.adjust();

      api.draw(
        false,
      );
    }

    options.onVisibilityChange?.(
      visibleGroups,
      api,
      getContext(),
    );

    return changed;
  }

  /* ==========================================================================
     View / Schema
     ========================================================================== */

  function setView(
    nextView,
    nextVisibleGroups = null,
  ) {
    if (destroyed) {
      return false;
    }

    const view =
      normalizeView(
        nextView,
      );

    const viewChanged =
      view !==
      currentView;

    let nextGroups =
      visibleGroups;

    let nextUsesSchemaVisibility =
      usesSchemaVisibility;

    /*
     * An explicit array always wins, including [].
     */

    if (
      Array.isArray(
        nextVisibleGroups,
      )
    ) {
      nextGroups =
        unique(
          nextVisibleGroups,
        );

      nextUsesSchemaVisibility =
        false;
    } else if (
      usesSchemaVisibility
    ) {
      /*
       * No explicit visibility controller owns this table.
       *
       * A new schema therefore begins with all groups declared by that schema
       * visible.
       */

      nextGroups =
        getSchemaVisibilityGroups(
          getCurrentColumnsForView(
            view,
          ),
        );
    }

    const groupsChanged =
      !arraysEqual(
        nextGroups,
        visibleGroups,
      );

    if (
      !viewChanged &&
      !groupsChanged
    ) {
      return false;
    }

    currentView =
      view;

    visibleGroups =
      nextGroups;

    usesSchemaVisibility =
      nextUsesSchemaVisibility;

    /*
     * Different schemas require one clean DataTables recreation.
     */

    recreate();

    options.onViewChange?.(
      currentView,
      api,
      getContext(),
    );

    return true;
  }

  /* ==========================================================================
     DataTables Operations
     ========================================================================== */

  function adjust() {
    if (!api) {
      return;
    }

    /*
     * adjust() does not necessarily trigger a draw, so preserve the explicit
     * post-layout callback here.
     */

    api.columns.adjust();

    scheduleLayoutRefresh();
  }

  function redraw(
    resetPaging = false,
  ) {
    if (!api) {
      return;
    }

    /*
     * drawCallback owns the post-draw layout hook.
     */

    api.draw(
      Boolean(
        resetPaging,
      ),
    );
  }

  function reload() {
    if (
      !api ||
      !api.ajax
    ) {
      return;
    }

    /*
     * Primary refresh path for an already-created server-side table.
     *
     * Keep the current page here. A page that needs to reset paging because
     * filters changed can explicitly recreate the table or use the DataTables
     * API to move to page zero before reloading.
     */

    api.ajax.reload(
      null,
      false,
    );
  }

  function search(
    value,
  ) {
    if (
      !api ||
      typeof api.search !==
        "function"
    ) {
      return;
    }

    api
      .search(
        value ??
          "",
      )
      .draw();
  }

  function setPageLength(
    length,
  ) {
    if (!api) {
      return;
    }

    const normalized =
      Number(
        length,
      );

    if (
      !Number.isFinite(
        normalized,
      ) ||
      normalized <= 0
    ) {
      return;
    }

    api
      .page
      .len(
        normalized,
      )
      .draw(
        false,
      );
  }

  /* ==========================================================================
     Queries
     ========================================================================== */

  function getRows() {
    return [
      ...rows,
    ];
  }

  function getView() {
    return currentView;
  }

  function getVisibleGroups() {
    return [
      ...visibleGroups,
    ];
  }

  function getApi() {
    return api;
  }

  function getState() {
    return Object.freeze({
      view:
        currentView,

      visibleGroups: [
        ...visibleGroups,
      ],

      rowCount:
        rows.length,

      /*
       * For server-side integrations, request/loading state is primarily
       * represented by DataTables' own lifecycle and aria-busy. renderState
       * remains useful for the client-side table path.
       */

      renderState:
        renderState
          ? {
              ...renderState,
            }
          : null,

      initialized:
        Boolean(
          api,
        ),
    });
  }

  /* ==========================================================================
     Lifecycle
     ========================================================================== */

  function destroy() {
    if (destroyed) {
      return;
    }

    destroyed =
      true;

    if (
      layoutFrame !==
      null
    ) {
      window.cancelAnimationFrame(
        layoutFrame,
      );

      layoutFrame =
        null;
    }

    destroyInstance();
  }

  /* ==========================================================================
     Initialization
     ========================================================================== */

  if (
    options.autoInit !==
    false
  ) {
    createInstance();
  }

  /* ==========================================================================
     Public Instance
     ========================================================================== */

  return Object.freeze({
    adjust,
    destroy,

    getApi,
    getRows,
    getState,
    getView,
    getVisibleGroups,

    recreate,
    redraw,
    reload,

    search,
    setPageLength,

    setRows,
    setView,
    setVisibleGroups,

    showEmpty,
    showError,
    showLoading,
  });
}

/* ==========================================================================
   Data Pagination
   ========================================================================== */

/*
 * Generic pagination renderer/controller for data-view modules.
 *
 * Responsibilities:
 *
 * - render design-system pagination controls
 * - render result-range summary
 * - render Previous / Next controls
 * - render page-number buttons
 * - render ellipsis for large page counts
 * - expose current pagination state
 * - expose loading / busy state
 * - delegate page changes through a callback
 * - support RTL through the design-system icon classes
 * - support keyboard/accessibility semantics through native buttons
 *
 * This module intentionally has no:
 *
 * - DataTables dependency
 * - request logic
 * - endpoint knowledge
 * - Historical Reports knowledge
 * - filter logic
 * - result fetching
 * - URL/history behavior
 *
 * The owning page decides what "go to page N" means through:
 *
 *   onPageChange(page, state)
 *
 * For DataTables-backed pagination, that callback can simply call:
 *
 *   api.page(page - 1).draw("page")
 */

/* ==========================================================================
   Constants
   ========================================================================== */

const DEFAULT_SELECTORS =
  Object.freeze({
    summary:
      ".pagination__summary",

    list:
      ".pagination__list",
  });

const DEFAULT_LABELS =
  Object.freeze({
    page:
      "Page",

    of:
      "of",

    previous:
      "Previous",

    next:
      "Next",
  });

const DEFAULT_MAX_VISIBLE_PAGES =
  7;

const ELLIPSIS =
  "ellipsis";

/* ==========================================================================
   Generic Helpers
   ========================================================================== */

function isObject(
  value,
) {
  return (
    value !== null &&
    typeof value ===
      "object" &&
    !Array.isArray(
      value,
    )
  );
}

function normalizeString(
  value,
) {
  return String(
    value ?? "",
  ).trim();
}

function clamp(
  value,
  minimum,
  maximum,
) {
  return Math.min(
    Math.max(
      value,
      minimum,
    ),
    maximum,
  );
}

function toNonNegativeInteger(
  value,
  fallback = 0,
) {
  const numeric =
    Number(
      value,
    );

  if (
    !Number.isFinite(
      numeric,
    ) ||
    numeric < 0
  ) {
    return fallback;
  }

  return Math.floor(
    numeric,
  );
}

function toPositiveInteger(
  value,
  fallback = 1,
) {
  const numeric =
    Number(
      value,
    );

  if (
    !Number.isFinite(
      numeric,
    ) ||
    numeric <= 0
  ) {
    return fallback;
  }

  return Math.floor(
    numeric,
  );
}

/* ==========================================================================
   Element Resolution
   ========================================================================== */

function resolveElement(
  root,
  value,
) {
  if (
    value instanceof
      Element
  ) {
    return value;
  }

  if (
    typeof value ===
    "string"
  ) {
    return root.querySelector(
      value,
    );
  }

  return null;
}

/* ==========================================================================
   Labels
   ========================================================================== */

function normalizeLabels(
  labels = {},
) {
  const source =
    isObject(
      labels,
    )
      ? labels
      : {};

  return {
    page:
      normalizeString(
        source.page,
      ) ||
      DEFAULT_LABELS.page,

    of:
      normalizeString(
        source.of,
      ) ||
      DEFAULT_LABELS.of,

    previous:
      normalizeString(
        source.previous,
      ) ||
      DEFAULT_LABELS.previous,

    next:
      normalizeString(
        source.next,
      ) ||
      DEFAULT_LABELS.next,
  };
}

/* ==========================================================================
   Number Formatter
   ========================================================================== */

function createNumberFormatter(
  locale,
) {
  try {
    return new Intl.NumberFormat(
      locale ||
        undefined,
    );
  } catch {
    return new Intl.NumberFormat();
  }
}

/* ==========================================================================
   Pagination State
   ========================================================================== */

function createDefaultState() {
  return {
    page:
      1,

    pageSize:
      1,

    totalPages:
      0,

    total:
      0,

    start:
      0,

    end:
      0,

    rowCount:
      0,

    hasPrevious:
      false,

    hasNext:
      false,

    loading:
      false,
  };
}

function normalizePaginationState(
  value = {},
  previousState =
    createDefaultState(),
) {
  const source =
    isObject(
      value,
    )
      ? value
      : {};

  const pageSize =
    toPositiveInteger(
      source.pageSize,
      previousState.pageSize ||
        1,
    );

  const total =
    toNonNegativeInteger(
      source.total,
      previousState.total ||
        0,
    );

  let totalPages =
    toNonNegativeInteger(
      source.totalPages,
      0,
    );

  /*
   * Derive totalPages when the caller provides only total + pageSize.
   */
  if (
    !totalPages &&
    total > 0
  ) {
    totalPages =
      Math.ceil(
        total /
          pageSize,
      );
  }

  let page =
    toPositiveInteger(
      source.page,
      previousState.page ||
        1,
    );

  if (
    totalPages > 0
  ) {
    page =
      clamp(
        page,
        1,
        totalPages,
      );
  } else {
    page =
      1;
  }

  const rowCount =
    toNonNegativeInteger(
      source.rowCount,
      0,
    );

  let start =
    toNonNegativeInteger(
      source.start,
      0,
    );

  let end =
    toNonNegativeInteger(
      source.end,
      0,
    );

  if (
    total === 0
  ) {
    start =
      0;

    end =
      0;
  } else {
    /*
     * Derive a sane range if the caller omitted one.
     */
    if (!start) {
      start =
        (page - 1) *
          pageSize +
        1;
    }

    if (!end) {
      end =
        Math.min(
          start +
            Math.max(
              rowCount,
              pageSize,
            ) -
            1,

          total,
        );
    }

    start =
      clamp(
        start,
        1,
        total,
      );

    end =
      clamp(
        end,
        start,
        total,
      );
  }

  const hasPrevious =
    typeof source.hasPrevious ===
    "boolean"
      ? source.hasPrevious
      : totalPages > 0 &&
        page > 1;

  const hasNext =
    typeof source.hasNext ===
    "boolean"
      ? source.hasNext
      : totalPages > 0 &&
        page <
          totalPages;

  const loading =
    typeof source.loading ===
    "boolean"
      ? source.loading
      : Boolean(
          previousState.loading,
        );

  return {
    page,

    pageSize,

    totalPages,

    total,

    start,

    end,

    rowCount,

    hasPrevious,

    hasNext,

    loading,
  };
}

/* ==========================================================================
   Page Window
   ========================================================================== */

/*
 * Produces a compact page model.
 *
 * Examples:
 *
 * 4 pages:
 *
 *   1 2 3 4
 *
 * 20 pages, current 1:
 *
 *   1 2 3 4 5 … 20
 *
 * 20 pages, current 10:
 *
 *   1 … 9 10 11 … 20
 *
 * 20 pages, current 20:
 *
 *   1 … 16 17 18 19 20
 *
 * The current page is always present, which also guarantees the design
 * system's mobile CSS can keep Previous / current / Next visible.
 */

export function createPaginationItems(
  currentPage,
  totalPages,
  maxVisiblePages =
    DEFAULT_MAX_VISIBLE_PAGES,
) {
  const total =
    toNonNegativeInteger(
      totalPages,
      0,
    );

  if (!total) {
    return [];
  }

  const current =
    clamp(
      toPositiveInteger(
        currentPage,
        1,
      ),
      1,
      total,
    );

  const maximum =
    Math.max(
      5,
      toPositiveInteger(
        maxVisiblePages,
        DEFAULT_MAX_VISIBLE_PAGES,
      ),
    );

  /*
   * Small result sets require no ellipsis.
   */
  if (
    total <=
    maximum
  ) {
    return Array.from(
      {
        length:
          total,
      },

      (
        _unused,
        index,
      ) =>
        index + 1,
    );
  }

  const edgeWindow =
    2;

  const siblingWindow =
    1;

  const pages =
    new Set([
      1,
      total,
    ]);

  /*
   * Keep a slightly wider window at either edge.
   */
  if (
    current <=
    edgeWindow + 2
  ) {
    for (
      let page = 1;
      page <=
      Math.min(
        maximum - 2,
        total,
      );
      page += 1
    ) {
      pages.add(
        page,
      );
    }
  } else if (
    current >=
    total -
      edgeWindow -
      1
  ) {
    for (
      let page =
        Math.max(
          1,
          total -
            maximum +
            3,
        );
      page <=
      total;
      page += 1
    ) {
      pages.add(
        page,
      );
    }
  } else {
    for (
      let page =
        current -
        siblingWindow;
      page <=
      current +
        siblingWindow;
      page += 1
    ) {
      pages.add(
        page,
      );
    }
  }

  const ordered =
    [...pages]
      .filter(
        (page) =>
          page >= 1 &&
          page <= total,
      )
      .sort(
        (
          first,
          second,
        ) =>
          first -
          second,
      );

  const items =
    [];

  ordered.forEach(
    (
      page,
      index,
    ) => {
      const previous =
        ordered[
          index - 1
        ];

      if (
        previous &&
        page -
          previous >
          1
      ) {
        items.push(
          ELLIPSIS,
        );
      }

      items.push(
        page,
      );
    },
  );

  return items;
}

/* ==========================================================================
   DOM Creation Helpers
   ========================================================================== */

function createListItem(
  documentReference,
  modifier = "",
) {
  const item =
    documentReference.createElement(
      "li",
    );

  item.className =
    [
      "pagination__item",
      modifier,
    ]
      .filter(
        Boolean,
      )
      .join(
        " ",
      );

  return item;
}

function createControlButton({
  documentReference,

  label,

  ariaLabel,

  action,

  page,

  current = false,

  disabled = false,

  className = "",
}) {
  const button =
    documentReference.createElement(
      "button",
    );

  button.type =
    "button";

  button.className =
    [
      "pagination__link",
      className,
      current
        ? "is-current"
        : "",
    ]
      .filter(
        Boolean,
      )
      .join(
        " ",
      );

  if (action) {
    button.dataset.paginationAction =
      action;
  }

  if (
    Number.isInteger(
      page,
    )
  ) {
    button.dataset.paginationPage =
      String(page);
  }

  button.setAttribute(
    "aria-label",
    ariaLabel ||
      label,
  );

  if (current) {
    button.setAttribute(
      "aria-current",
      "page",
    );
  }

  button.disabled =
    Boolean(
      disabled,
    );

  if (disabled) {
    button.setAttribute(
      "aria-disabled",
      "true",
    );
  }

  const text =
    documentReference.createElement(
      "span",
    );

  text.className =
    "pagination__link-text";

  text.textContent =
    label;

  button.append(
    text,
  );

  return button;
}

function createEllipsisItem(
  documentReference,
) {
  const item =
    createListItem(
      documentReference,
      "pagination__item--ellipsis",
    );

  const ellipsis =
    documentReference.createElement(
      "span",
    );

  ellipsis.className =
    "pagination__ellipsis";

  ellipsis.textContent =
    "…";

  ellipsis.setAttribute(
    "aria-hidden",
    "true",
  );

  item.append(
    ellipsis,
  );

  return item;
}

/* ==========================================================================
   Public Factory
   ========================================================================== */

export function createDataPagination(
  options = {},
) {
  if (
    !isObject(
      options,
    )
  ) {
    throw new TypeError(
      "createDataPagination requires an options object.",
    );
  }

  /* ========================================================================
     DOM
     ======================================================================== */

  const root =
    options.root ||
    document;

  const container =
    resolveElement(
      root,
      options.container,
    );

  if (!container) {
    throw new Error(
      "Data pagination requires a valid container element or selector.",
    );
  }

  const summary =
    resolveElement(
      container,
      options.summary ||
        DEFAULT_SELECTORS.summary,
    );

  const list =
    resolveElement(
      container,
      options.list ||
        DEFAULT_SELECTORS.list,
    );

  if (!list) {
    throw new Error(
      "Data pagination requires a pagination list.",
    );
  }

  const documentReference =
    container.ownerDocument ||
    document;

  /* ========================================================================
     Configuration
     ======================================================================== */

  const labels =
    normalizeLabels(
      options.labels,
    );

  const numberFormatter =
    createNumberFormatter(
      options.locale,
    );

  const maxVisiblePages =
    Math.max(
      5,
      toPositiveInteger(
        options.maxVisiblePages,
        DEFAULT_MAX_VISIBLE_PAGES,
      ),
    );

  const hideWhenEmpty =
    options.hideWhenEmpty !==
    false;

  const hideSinglePage =
    options.hideSinglePage ===
    true;

  const autoBusyOnChange =
    options.autoBusyOnChange !==
    false;

  const renderSummary =
    typeof options.renderSummary ===
    "function"
      ? options.renderSummary
      : null;

  /* ========================================================================
     Internal State
     ======================================================================== */

  let state =
    normalizePaginationState(
      options.initialState,
    );

  let destroyed =
    false;

  let pendingPage =
    null;

  const abortController =
    new AbortController();

  /* ========================================================================
     Queries
     ======================================================================== */

  function getState() {
    return Object.freeze({
      ...state,
    });
  }

  function shouldBeVisible() {
    if (
      hideWhenEmpty &&
      state.total <= 0
    ) {
      return false;
    }

    if (
      hideSinglePage &&
      state.totalPages <=
        1
    ) {
      return false;
    }

    return true;
  }

  /* ========================================================================
     Summary
     ======================================================================== */

  function renderDefaultSummary() {
    if (!summary) {
      return;
    }

    summary.replaceChildren();

    if (
      state.total <= 0
    ) {
      summary.textContent =
        "";

      return;
    }

    const range =
      documentReference.createElement(
        "strong",
      );

    range.className =
      "pagination__summary-value";

    range.textContent =
      `${numberFormatter.format(
        state.start,
      )}–${numberFormatter.format(
        state.end,
      )}`;

    const total =
      documentReference.createElement(
        "strong",
      );

    total.className =
      "pagination__summary-value";

    total.textContent =
      numberFormatter.format(
        state.total,
      );

    summary.append(
      range,

      documentReference.createTextNode(
        ` ${labels.of} `,
      ),

      total,
    );
  }

  function renderSummaryContent() {
    if (!summary) {
      return;
    }

    if (!renderSummary) {
      renderDefaultSummary();

      return;
    }

    const result =
      renderSummary(
        getState(),
        {
          labels: {
            ...labels,
          },

          numberFormatter,
        },
      );

    /*
     * String output is treated as text, not HTML.
     *
     * Consumers that need rich markup can return a Node / DocumentFragment.
     */
    if (
      result instanceof
      Node
    ) {
      summary.replaceChildren(
        result,
      );

      return;
    }

    summary.textContent =
      result == null
        ? ""
        : String(
            result,
          );
  }

  /* ========================================================================
     Previous
     ======================================================================== */

  function renderPrevious() {
    const item =
      createListItem(
        documentReference,
      );

    const button =
      createControlButton({
        documentReference,

        label:
          labels.previous,

        ariaLabel:
          labels.previous,

        action:
          "previous",

        page:
          Math.max(
            1,
            state.page - 1,
          ),

        disabled:
          state.loading ||
          !state.hasPrevious,

        className:
          [
            "pagination__link--previous",
            "has-icon",
            "icon-chevron-left",
            "icon-flip-rtl",
          ].join(
            " ",
          ),
      });

    item.append(
      button,
    );

    return item;
  }

  /* ========================================================================
     Numbered Pages
     ======================================================================== */

  function renderPage(
    page,
  ) {
    const item =
      createListItem(
        documentReference,
      );

    const current =
      page ===
      state.page;

    const formattedPage =
      numberFormatter.format(
        page,
      );

    const button =
      createControlButton({
        documentReference,

        label:
          formattedPage,

        ariaLabel:
          `${labels.page} ${formattedPage}`,

        action:
          "page",

        page,

        current,

        /*
         * Current page is intentionally disabled as an action but retains
         * aria-current for authoritative current-page semantics.
         */
        disabled:
          state.loading ||
          current,
      });

    item.append(
      button,
    );

    return item;
  }

  /* ========================================================================
     Next
     ======================================================================== */

  function renderNext() {
    const item =
      createListItem(
        documentReference,
      );

    const button =
      createControlButton({
        documentReference,

        label:
          labels.next,

        ariaLabel:
          labels.next,

        action:
          "next",

        page:
          Math.min(
            Math.max(
              1,
              state.totalPages,
            ),

            state.page + 1,
          ),

        disabled:
          state.loading ||
          !state.hasNext,

        className:
          [
            "pagination__link--next",
            "has-icon",
            "icon-chevron-right",
            "icon-flip-rtl",
            "icon-end",
          ].join(
            " ",
          ),
      });

    item.append(
      button,
    );

    return item;
  }

  /* ========================================================================
     List
     ======================================================================== */

  function renderList() {
    list.replaceChildren();

    if (
      state.totalPages <=
      0
    ) {
      return;
    }

    const fragment =
      documentReference
        .createDocumentFragment();

    fragment.append(
      renderPrevious(),
    );

    createPaginationItems(
      state.page,
      state.totalPages,
      maxVisiblePages,
    ).forEach(
      (item) => {
        if (
          item ===
          ELLIPSIS
        ) {
          fragment.append(
            createEllipsisItem(
              documentReference,
            ),
          );

          return;
        }

        fragment.append(
          renderPage(
            item,
          ),
        );
      },
    );

    fragment.append(
      renderNext(),
    );

    list.append(
      fragment,
    );
  }

  /* ========================================================================
     Visibility / Busy State
     ======================================================================== */

  function syncContainerState() {
    container.hidden =
      !shouldBeVisible();

    container.setAttribute(
      "aria-busy",
      String(
        Boolean(
          state.loading,
        ),
      ),
    );
  }

  /* ========================================================================
     Render
     ======================================================================== */

  function render() {
    if (destroyed) {
      return;
    }

    syncContainerState();

    renderSummaryContent();

    renderList();

    options.afterRender?.(
      getState(),
      {
        container,
        summary,
        list,
      },
    );
  }

  /* ========================================================================
     State Mutation
     ======================================================================== */

  function setState(
    nextState = {},
    settings = {},
  ) {
    if (destroyed) {
      return getState();
    }

    state =
      normalizePaginationState(
        {
          ...state,

          ...nextState,

          /*
           * A completed external state update clears the temporary busy state
           * unless the caller explicitly keeps loading:true.
           */
          loading:
            typeof nextState.loading ===
            "boolean"
              ? nextState.loading
              : false,
        },

        state,
      );

    pendingPage =
      null;

    if (
      settings.render !==
      false
    ) {
      render();
    }

    return getState();
  }

  function setLoading(
    loading = true,
    settings = {},
  ) {
    if (destroyed) {
      return getState();
    }

    state =
      normalizePaginationState(
        {
          ...state,

          loading:
            Boolean(
              loading,
            ),
        },

        state,
      );

    if (
      !state.loading
    ) {
      pendingPage =
        null;
    }

    if (
      settings.render !==
      false
    ) {
      render();
    }

    return getState();
  }

  function clear(
    settings = {},
  ) {
    if (destroyed) {
      return getState();
    }

    state =
      normalizePaginationState(
        {
          page:
            1,

          pageSize:
            state.pageSize,

          totalPages:
            0,

          total:
            0,

          start:
            0,

          end:
            0,

          rowCount:
            0,

          hasPrevious:
            false,

          hasNext:
            false,

          loading:
            false,
        },

        state,
      );

    pendingPage =
      null;

    if (
      settings.render !==
      false
    ) {
      render();
    }

    return getState();
  }

  /* ========================================================================
     Visibility API
     ======================================================================== */

  function show() {
    if (destroyed) {
      return;
    }

    container.hidden =
      false;
  }

  function hide() {
    if (destroyed) {
      return;
    }

    container.hidden =
      true;
  }

  /* ========================================================================
     Navigation
     ======================================================================== */

  function resolveTargetPage(
    button,
  ) {
    const action =
      button.dataset
        .paginationAction;

    switch (action) {
      case "previous":
        return state.page -
          1;

      case "next":
        return state.page +
          1;

      case "page":
      default:
        return Number(
          button.dataset
            .paginationPage,
        );
    }
  }

  function requestPage(
    targetPage,
  ) {
    if (
      destroyed ||
      state.loading ||
      state.totalPages <=
        0
    ) {
      return false;
    }

    const page =
      clamp(
        toPositiveInteger(
          targetPage,
          state.page,
        ),

        1,

        state.totalPages,
      );

    if (
      page ===
        state.page ||
      page ===
        pendingPage
    ) {
      return false;
    }

    pendingPage =
      page;

    if (
      autoBusyOnChange
    ) {
      setLoading(
        true,
      );
    }

    options.onPageChange?.(
      page,
      getState(),
    );

    return true;
  }

  /* ========================================================================
     Events
     ======================================================================== */

  function handleClick(
    event,
  ) {
    if (destroyed) {
      return;
    }

    const button =
      event.target.closest(
        "[data-pagination-page]",
      );

    if (
      !button ||
      !list.contains(
        button,
      )
    ) {
      return;
    }

    if (
      button.disabled ||
      button.getAttribute(
        "aria-disabled",
      ) ===
        "true"
    ) {
      return;
    }

    const targetPage =
      resolveTargetPage(
        button,
      );

    requestPage(
      targetPage,
    );
  }

  list.addEventListener(
    "click",
    handleClick,
    {
      signal:
        abortController.signal,
    },
  );

  /* ========================================================================
     Lifecycle
     ======================================================================== */

  function destroy() {
    if (destroyed) {
      return;
    }

    destroyed =
      true;

    abortController.abort();

    list.replaceChildren();

    if (summary) {
      summary.replaceChildren();
    }

    container.removeAttribute(
      "aria-busy",
    );
  }

  /* ========================================================================
     Initialization
     ======================================================================== */

  if (
    options.autoRender !==
    false
  ) {
    render();
  }

  /* ========================================================================
     Public Instance
     ======================================================================== */

  return Object.freeze({
    clear,

    destroy,

    getState,

    hide,

    render,

    requestPage,

    setLoading,

    setState,

    show,
  });
}

