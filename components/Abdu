    function getPerformanceLabel(performance) {
      const values = performance.map((direction, index) => {
        const day = index + 1;

        if (direction === "up") {
          return `day ${day} up`;
        }

        if (direction === "down") {
          return `day ${day} down`;
        }

        return `day ${day} ` + "no change or no data";
      });

      return "Five-day performance: " + `${values.join(", ")}.`;
    }

    function createPerformanceElement(performance) {
      const wrapper = document.createElement("div");

      wrapper.className = "market-activity-table__performance";

      wrapper.setAttribute("role", "img");

      wrapper.setAttribute("aria-label", getPerformanceLabel(performance));

      performance.forEach((direction) => {
        const bar = document.createElement("span");

        bar.className = `is-${direction}`;

        bar.setAttribute("aria-hidden", "true");

        wrapper.appendChild(bar);
      });

      return wrapper;
    }

    function updatePerformanceElement(element, performance) {
      if (!element) {
        return;
      }

      element.setAttribute("aria-label", getPerformanceLabel(performance));

      const bars = Array.from(element.children);

      if (bars.length !== performance.length) {
        element.replaceChildren(
          ...performance.map((direction) => {
            const bar = document.createElement("span");

            bar.className = `is-${direction}`;

            bar.setAttribute("aria-hidden", "true");

            return bar;
          }),
        );

        return;
      }

      bars.forEach((bar, index) => {
        bar.classList.remove("is-up", "is-down", "is-neutral");

        bar.classList.add(`is-${performance[index]}`);
      });
    }

