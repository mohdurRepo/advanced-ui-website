  /* ==========================================================================
     Load Activity Dataset
     ========================================================================== */

  async function loadActivity(
    type,
    {
      force = false,
    } = {}
  ) {
    if (
      !ACTIVITY_TYPES.includes(
        type
      )
    ) {
      return;
    }

    const activityState =
      state.activity[type];

    /* ------------------------------------------------------------------------
       Lazy Loading
       ------------------------------------------------------------------------ */

    if (
      activityState.loaded &&
      !force
    ) {
      return;
    }

    /* ------------------------------------------------------------------------
       Configured JSP Endpoint
       ------------------------------------------------------------------------ */

    const endpoint =
      getActivityUrl(
        type
      );

    if (!endpoint) {
      console.error(
        `Main Market: activity endpoint is missing for "${type}".`
      );

      if (
        !activityState.loaded
      ) {
        renderActivityMessage(
          type,
          "Market data is temporarily unavailable."
        );

        completeActivityLoading(
          type
        );
      }

      return;
    }

    /* ------------------------------------------------------------------------
       Cancel Stale Request
       ------------------------------------------------------------------------ */

    activityState.request
      ?.abort();

    /*
     * Important:
     *
     * Do not rebuild or modify the resource URL.
     *
     * Pass the portlet URL exactly as JSP generated it,
     * and allow jQuery to serialize requestLocale.
     */

    const request =
      ajaxJson(
        endpoint,
        {
          data: {
            requestLocale:
              getRequestLocale(),
          },
        }
      );

    activityState.request =
      request;

    const initial =
      !activityState.loaded;

    try {
      /* ----------------------------------------------------------------------
         Response
         ---------------------------------------------------------------------- */

      const payload =
        await request.promise;

      /*
       * Preserve backend ranking.
       *
       * Do not client-sort Gainers, Losers,
       * Volume or Value.
       */

      const items =
        normalizeActivityResponse(
          payload
        ).slice(
          0,
          ACTIVITY_LIMIT
        );

      /* ----------------------------------------------------------------------
         Empty Response
         ---------------------------------------------------------------------- */

      if (
        !items.length
      ) {
        /*
         * Initial empty response:
         *
         * replace skeletons with an empty state.
         *
         * Subsequent empty response:
         *
         * keep the last successfully rendered data.
         */

        if (
          !activityState.loaded
        ) {
          activityState.loaded =
            true;

          activityState.items =
            new Map();

          renderActivityMessage(
            type,
            "No market activity is available."
          );

          completeActivityLoading(
            type
          );
        }

        return;
      }

      /* ----------------------------------------------------------------------
         Runtime Item Map
         ---------------------------------------------------------------------- */

      activityState.items =
        new Map(
          items.map(
            (item) => [
              item.symbol,
              item,
            ]
          )
        );

      /* ----------------------------------------------------------------------
         Desktop
         ---------------------------------------------------------------------- */

      renderActivityTable(
        type,
        items,
        {
          initial,
        }
      );

      /* ----------------------------------------------------------------------
         Mobile
         ---------------------------------------------------------------------- */

      renderActivityCards(
        type,
        items,
        {
          initial,
        }
      );

      activityState.loaded =
        true;

      completeActivityLoading(
        type
      );
    } catch (error) {
      /* ----------------------------------------------------------------------
         Request Aborted
         ---------------------------------------------------------------------- */

      if (
        error.name ===
        "AbortError"
      ) {
        return;
      }

      console.error(
        `Unable to load ${type} market activity:`,
        error
      );

      /*
       * Initial failure:
       *
       * remove the skeleton state and show unavailable.
       *
       * Later refresh failure:
       *
       * preserve the previously successful result.
       */

      if (
        !activityState.loaded
      ) {
        renderActivityMessage(
          type,
          "Market data is temporarily unavailable."
        );

        completeActivityLoading(
          type
        );
      }
    } finally {
      if (
        activityState.request ===
        request
      ) {
        activityState.request =
          null;
      }
    }
  }

  /* ==========================================================================
     Activity Tab Helpers
     ========================================================================== */

  function getActivityTypeFromTab(
    tab
  ) {
    const target =
      tab?.getAttribute(
        "data-tab-target"
      );

    if (!target) {
      return null;
    }

    const match =
      target.match(
        /^activity-(gainers|losers|volume|value)-panel$/
      );

    return (
      match?.[1] ||
      null
    );
  }

  function getActiveActivityType() {
    const selectedTab =
      document.querySelector(
        '.market-activity__tab[aria-selected="true"]'
      );

    const activeTab =
      selectedTab ||
      document.querySelector(
        ".market-activity__tab.active"
      );

    return (
      getActivityTypeFromTab(
        activeTab
      ) ||
      "gainers"
    );
  }

  /* ==========================================================================
     Mobile Card Details
     ========================================================================== */

  function toggleCardDetails(
    button
  ) {
    const card =
      button.closest(
        ".data-card"
      );

    if (!card) {
      return;
    }

    const details =
      card.querySelector(
        "[data-market-card-details]"
      );

    if (!details) {
      return;
    }

    const expanded =
      button.getAttribute(
        "aria-expanded"
      ) !== "true";

    button.setAttribute(
      "aria-expanded",
      String(
        expanded
      )
    );

    details.hidden =
      !expanded;

    card.classList.toggle(
      "is-expanded",
      expanded
    );

    const label =
      button.querySelector(
        ".data-card__toggle-label"
      );

    if (label) {
      label.textContent =
        expanded
          ? "Hide details"
          : "Show details";
    }
  }

  /* ==========================================================================
     Resolve Watchlist Item From DOM
     ========================================================================== */

  function getActivityItemFromElement(
    element
  ) {
    const view =
      element.closest(
        "[data-market-activity-view]"
      );

    if (!view) {
      return null;
    }

    const type =
      view.getAttribute(
        "data-market-activity-view"
      );

    if (
      !ACTIVITY_TYPES.includes(
        type
      )
    ) {
      return null;
    }

    const symbol =
      element.getAttribute(
        "data-market-watchlist"
      );

    if (!symbol) {
      return null;
    }

    return (
      state.activity[type]
        .items.get(
          symbol
        ) ||
      null
    );
  }

  /* ==========================================================================
     Delegated Activity Events
     ========================================================================== */

  document.addEventListener(
    "click",
    (event) => {
      /* ----------------------------------------------------------------------
         Activity Tab
         ---------------------------------------------------------------------- */

      const tab =
        event.target.closest(
          ".market-activity__tab[data-tab-target]"
        );

      if (tab) {
        const type =
          getActivityTypeFromTab(
            tab
          );

        if (type) {
          /*
           * First visit:
           * load the dataset.
           *
           * Later visits:
           * refresh immediately.
           */

          loadActivity(
            type,
            {
              force:
                state.activity[type]
                  .loaded,
            }
          );
        }
      }

      /* ----------------------------------------------------------------------
         Card Details
         ---------------------------------------------------------------------- */

      const cardToggle =
        event.target.closest(
          "[data-market-card-toggle]"
        );

      if (cardToggle) {
        event.preventDefault();

        toggleCardDetails(
          cardToggle
        );

        return;
      }

      /* ----------------------------------------------------------------------
         Watchlist
         ---------------------------------------------------------------------- */

      const watchlistButton =
        event.target.closest(
          "[data-market-watchlist]"
        );

      if (
        !watchlistButton
      ) {
        return;
      }

      event.preventDefault();

      const item =
        getActivityItemFromElement(
          watchlistButton
        );

      handleWatchlist(
        item
      );
    }
  );

  /* ==========================================================================
     Refresh Visible Market Data
     ========================================================================== */

  async function refreshVisibleMarketData() {
    if (
      document.hidden
    ) {
      return;
    }

    const activeType =
      getActiveActivityType();

    /*
     * Hero refreshes every cycle.
     *
     * Only the currently visible Activity dataset
     * refreshes automatically.
     *
     * Hidden tabs refresh when opened.
     */

    await Promise.allSettled(
      [
        loadMarketIndex({
          initial: false,
        }),

        loadActivity(
          activeType,
          {
            force: true,
          }
        ),
      ]
    );
  }

  /* ==========================================================================
     Refresh Timer
     ========================================================================== */

  function stopRefreshTimer() {
    if (
      state.refreshTimer ===
      null
    ) {
      return;
    }

    window.clearInterval(
      state.refreshTimer
    );

    state.refreshTimer =
      null;
  }

  function startRefreshTimer() {
    stopRefreshTimer();

    if (
      document.hidden
    ) {
      return;
    }

    state.refreshTimer =
      window.setInterval(
        refreshVisibleMarketData,
        REFRESH_INTERVAL
      );
  }

  /* ==========================================================================
     Abort Current Requests
     ========================================================================== */

  function abortCurrentRequests() {
    state.index.request
      ?.abort();

    ACTIVITY_TYPES.forEach(
      (type) => {
        state.activity[type]
          .request?.abort();
      }
    );
  }

  /* ==========================================================================
     Page Visibility
     ========================================================================== */

  document.addEventListener(
    "visibilitychange",
    () => {
      if (
        !state.started
      ) {
        return;
      }

      /* ----------------------------------------------------------------------
         Page Hidden
         ---------------------------------------------------------------------- */

      if (
        document.hidden
      ) {
        stopRefreshTimer();

        abortCurrentRequests();

        return;
      }

      /* ----------------------------------------------------------------------
         Page Visible Again
         ---------------------------------------------------------------------- */

      /*
       * Refresh immediately after returning instead
       * of waiting for the next 60-second interval.
       */

      refreshVisibleMarketData();

      startRefreshTimer();
    }
  );

  /* ==========================================================================
     Page Hide Cleanup
     ========================================================================== */

  window.addEventListener(
    "pagehide",
    () => {
      stopRefreshTimer();

      abortCurrentRequests();
    }
  );

  /* ==========================================================================
     Configuration / Markup Validation
     ========================================================================== */

  function validateConfiguration() {
    if (
      !window.MainMarketConfig
    ) {
      console.warn(
        [
          "Main Market: window.MainMarketConfig is missing.",
          "Activity requests require JSP configuration.",
        ].join(" ")
      );
    }

    ACTIVITY_TYPES.forEach(
      (type) => {
        /* --------------------------------------------------------------------
           Activity View
           -------------------------------------------------------------------- */

        if (
          !getActivityView(
            type
          )
        ) {
          console.warn(
            `Main Market: missing activity view "${type}".`
          );
        }

        /* --------------------------------------------------------------------
           Endpoint
           -------------------------------------------------------------------- */

        if (
          !getActivityUrl(
            type
          )
        ) {
          console.warn(
            `Main Market: missing configured endpoint for "${type}".`
          );
        }

        /* --------------------------------------------------------------------
           Desktop Body
           -------------------------------------------------------------------- */

        if (
          !document.querySelector(
            `[data-market-activity-body="${type}"]`
          )
        ) {
          console.warn(
            `Main Market: missing activity tbody "${type}".`
          );
        }

        /* --------------------------------------------------------------------
           Mobile Cards
           -------------------------------------------------------------------- */

        if (
          !document.querySelector(
            `[data-market-activity-cards="${type}"]`
          )
        ) {
          console.warn(
            `Main Market: missing activity cards container "${type}".`
          );
        }
      }
    );
  }

  /* ==========================================================================
     Initialize Main Market
     ========================================================================== */

  async function initializeMainMarket() {
    if (
      state.started
    ) {
      return;
    }

    state.started =
      true;

    validateConfiguration();

    /*
     * Initial requests:
     *
     * Hero:
     * load immediately.
     *
     * Gainers:
     * load immediately because it is the initial tab.
     *
     * Losers / Volume / Value:
     * remain in their skeleton state until opened.
     */

    await Promise.allSettled(
      [
        loadMarketIndex({
          initial: true,
        }),

        loadActivity(
          "gainers"
        ),
      ]
    );

    startRefreshTimer();
  }

  /* ==========================================================================
     Start
     ========================================================================== */

  /*
   * Supports both:
   *
   * <script src="..." defer></script>
   *
   * and a script included after page markup.
   */

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeMainMarket,
      {
        once: true,
      }
    );
  } else {
    initializeMainMarket();
  }

  /* ==========================================================================
     End Main Market
     ========================================================================== */

})();

</script>
