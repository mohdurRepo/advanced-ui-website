<script>
  (() => {
    "use strict";

    /* ========================================================================
     Main Market — Production Live Data
     ======================================================================== */

    const REFRESH_INTERVAL = 60_000;
    const LIVE_UPDATE_DURATION = 900;

    const ACTIVITY_TYPES = ["gainers", "losers", "volume", "value"];

    const locale =
      document.documentElement.lang || navigator.language || "en-US";

    /* ========================================================================
     Number Formatters
     ======================================================================== */

    const priceFormatter = new Intl.NumberFormat(locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

    const signedPriceFormatter = new Intl.NumberFormat(locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
      signDisplay: "exceptZero",
    });

    const signedPercentFormatter = new Intl.NumberFormat(locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
      signDisplay: "exceptZero",
    });

    const integerFormatter = new Intl.NumberFormat(locale, {
      maximumFractionDigits: 0,
    });

    const moneyFormatter = new Intl.NumberFormat(locale, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    });

    /* ========================================================================
     Runtime State
     ======================================================================== */

    const state = {
      started: false,
      refreshTimer: null,

      index: {
        loaded: false,
        controller: null,
      },

      activity: Object.fromEntries(
        ACTIVITY_TYPES.map((type) => [
          type,
          {
            loaded: false,
            controller: null,
            items: new Map(),
          },
        ]),
      ),
    };

    /* ========================================================================
     DOM Cache
     ======================================================================== */

    const dom = {
      index: document.querySelector("[data-market-index]"),

      indexLoading: document.querySelectorAll("[data-market-index-loading]"),

      indexLive: document.querySelectorAll("[data-market-index-live]"),

      indexValue: document.querySelector("[data-market-index-value]"),

      indexChangeState: document.querySelector(
        "[data-market-index-change-state]",
      ),

      indexChangeIcon: document.querySelector(
        "[data-market-index-change-icon]",
      ),

      indexChange: document.querySelector("[data-market-index-change]"),

      indexChangePercent: document.querySelector(
        "[data-market-index-change-percent]",
      ),

      requestLocale: document.querySelector("#requestLocale"),
    };

    const liveUpdateTimers = new WeakMap();

    /* ========================================================================
     Generic Utilities
     ======================================================================== */

    function toNumber(value) {
      if (typeof value === "number") {
        return Number.isFinite(value) ? value : null;
      }

      if (value === null || value === undefined || value === "") {
        return null;
      }

      const normalized = String(value).replace(/,/g, "").trim();

      if (!normalized) {
        return null;
      }

      const number = Number(normalized);

      return Number.isFinite(number) ? number : null;
    }

    function getDirection(value) {
      if (value > 0) {
        return "up";
      }

      if (value < 0) {
        return "down";
      }

      return "neutral";
    }

    function applyPriceState(element, value) {
      if (!element) {
        return;
      }

      element.classList.remove("price-up", "price-down", "price-neutral");

      element.classList.add(`price-${getDirection(value)}`);
    }

    function sanitizeId(value) {
      return String(value)
        .toLowerCase()
        .replace(/[^a-z0-9_-]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function getRequestLocale() {
      return dom.requestLocale?.value || document.documentElement.lang || "en";
    }

    function getSafeHref(value) {
      if (!value) {
        return null;
      }

      try {
        const url = new URL(String(value), window.location.href);

        return url.protocol === "http:" || url.protocol === "https:"
          ? url.href
          : null;
      } catch {
        return null;
      }
    }

    /* ========================================================================
     Data Value Updates
     ======================================================================== */

    function setDataValue(
      element,
      rawValue,
      formattedValue,
      { animate = false } = {},
    ) {
      if (!element) {
        return;
      }

      const previousValue = toNumber(element.getAttribute("value"));

      if (rawValue === null || rawValue === undefined) {
        element.removeAttribute("value");
      } else {
        element.setAttribute("value", String(rawValue));
      }

      element.textContent = formattedValue;

      if (
        animate &&
        previousValue !== null &&
        rawValue !== null &&
        rawValue !== undefined &&
        previousValue !== rawValue
      ) {
        triggerLiveUpdate(element, previousValue, rawValue);
      }
    }

    /* ========================================================================
     Live Update Feedback
     ======================================================================== */

    function triggerLiveUpdate(element, previousValue, nextValue) {
      if (!element || previousValue === nextValue) {
        return;
      }

      const direction =
        nextValue > previousValue
          ? "up"
          : nextValue < previousValue
            ? "down"
            : "neutral";

      const classes = [
        "is-updating-up",
        "is-updating-down",
        "is-updating-neutral",
      ];

      element.classList.remove(...classes);

      const existingTimer = liveUpdateTimers.get(element);

      if (existingTimer) {
        window.clearTimeout(existingTimer);
      }

      /*
       * Intentional reflow.
       *
       * Allows the same element to visibly react on
       * consecutive refreshes in the same direction.
       */

      void element.offsetWidth;

      element.classList.add(`is-updating-${direction}`);

      const timer = window.setTimeout(() => {
        element.classList.remove(...classes);

        liveUpdateTimers.delete(element);
      }, LIVE_UPDATE_DURATION);

      liveUpdateTimers.set(element, timer);
    }

    /* ========================================================================
     HTTP
     ======================================================================== */

    async function requestJson(url, { signal } = {}) {
      const response = await fetch(url, {
        method: "GET",

        credentials: "same-origin",

        cache: "no-store",

        headers: {
          Accept: "application/json",
        },

        signal,
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status} ${response.statusText}`);
      }

      const text = (await response.text()).trim();

      if (!text) {
        return null;
      }

      const parsed = JSON.parse(text);

      /*
       * Defensive support for endpoints that return
       * a JSON string containing JSON.
       */

      return typeof parsed === "string" ? JSON.parse(parsed) : parsed;
    }

    function buildResourceUrl(baseUrl) {
      const url = new URL(baseUrl, window.location.href);

      url.searchParams.set("requestLocale", getRequestLocale());

      return url.href;
    }

    /* ========================================================================
     Hero / TASI
     ======================================================================== */

    function getMarketIndexEndpoint() {
      /*
       * Preferred future contract:
       *
       * data-market-index-url="..."
       */

      const attributeUrl = dom.index?.getAttribute("data-market-index-url");

      if (attributeUrl) {
        return attributeUrl;
      }

      /*
       * Current legacy contract.
       */

      if (
        typeof getMarketIndexUrl !== "undefined" &&
        typeof getMarketIndexUrl === "string" &&
        getMarketIndexUrl
      ) {
        return getMarketIndexUrl;
      }

      /*
       * Additional fallback when the variable was
       * explicitly attached to window.
       */

      if (
        typeof window.getMarketIndexUrl === "string" &&
        window.getMarketIndexUrl
      ) {
        return window.getMarketIndexUrl;
      }

      return null;
    }

    function normalizeIndexResponse(payload) {
      if (!payload || typeof payload !== "object") {
        throw new Error("Invalid Main Market index response.");
      }

      const indexPrice = toNumber(payload.indexPrice);

      const netChange = toNumber(payload.netChange);

      const percentChange = toNumber(payload.percentChange);

      if (indexPrice === null || netChange === null || percentChange === null) {
        throw new Error(
          "Main Market index response is missing required values.",
        );
      }

      return {
        indexPrice,
        netChange,
        percentChange,
      };
    }

    function revealIndexLiveState() {
      dom.indexLoading.forEach((element) => {
        element.hidden = true;
      });

      dom.indexLive.forEach((element) => {
        element.hidden = false;
      });

      dom.index?.setAttribute("aria-busy", "false");
    }

    function renderIndex(data, { initial = false } = {}) {
      if (!dom.index) {
        return;
      }

      const direction = getDirection(data.netChange);

      /* ------------------------------------------------------------------------
       Index Value
       ------------------------------------------------------------------------ */

      setDataValue(
        dom.indexValue,
        data.indexPrice,
        priceFormatter.format(data.indexPrice),
        {
          animate: !initial,
        },
      );

      /* ------------------------------------------------------------------------
       Net Change
       ------------------------------------------------------------------------ */

      setDataValue(
        dom.indexChange,
        data.netChange,
        signedPriceFormatter.format(data.netChange),
      );

      /* ------------------------------------------------------------------------
       Percentage
       ------------------------------------------------------------------------ */

      if (dom.indexChangePercent) {
        dom.indexChangePercent.textContent = `(${signedPercentFormatter.format(
          data.percentChange,
        )}%)`;
      }

      /* ------------------------------------------------------------------------
       Positive / Negative / Neutral State
       ------------------------------------------------------------------------ */

      applyPriceState(dom.indexChangeState, data.netChange);

      /* ------------------------------------------------------------------------
       Direction Icon
       ------------------------------------------------------------------------ */

      if (dom.indexChangeIcon) {
        if (direction === "neutral") {
          dom.indexChangeIcon.hidden = true;

          dom.indexChangeIcon.style.transform = "";
        } else {
          dom.indexChangeIcon.hidden = false;

          dom.indexChangeIcon.style.transform =
            direction === "down" ? "rotate(180deg)" : "";
        }
      }

      /* ------------------------------------------------------------------------
       Accessibility
       ------------------------------------------------------------------------ */

      const movementText =
        direction === "up"
          ? "Increased"
          : direction === "down"
            ? "Decreased"
            : "Unchanged";

      dom.index.setAttribute(
        "aria-label",
        [
          `TASI Index: ${priceFormatter.format(data.indexPrice)} points.`,

          `${movementText} by ${priceFormatter.format(
            Math.abs(data.netChange),
          )} points,`,

          `or ${priceFormatter.format(Math.abs(data.percentChange))} percent.`,
        ].join(" "),
      );

      revealIndexLiveState();

      state.index.loaded = true;
    }

    function renderIndexUnavailable() {
      if (!dom.index) {
        return;
      }

      revealIndexLiveState();

      setDataValue(dom.indexValue, null, "—");

      setDataValue(dom.indexChange, null, "—");

      if (dom.indexChangePercent) {
        dom.indexChangePercent.textContent = "—";
      }

      if (dom.indexChangeIcon) {
        dom.indexChangeIcon.hidden = true;

        dom.indexChangeIcon.style.transform = "";
      }

      dom.indexChangeState?.classList.remove(
        "price-up",
        "price-down",
        "price-neutral",
      );

      dom.index.setAttribute(
        "aria-label",
        "TASI Index market data is temporarily unavailable.",
      );
    }

    async function loadMarketIndex({ initial = false } = {}) {
      if (!dom.index) {
        return;
      }

      const endpoint = getMarketIndexEndpoint();

      if (!endpoint) {
        console.error("Main Market index URL is not available.");

        if (!state.index.loaded) {
          renderIndexUnavailable();
        }

        return;
      }

      /*
       * Abort the previous index request so a stale
       * response can never overwrite newer data.
       */

      state.index.controller?.abort();

      const controller = new AbortController();

      state.index.controller = controller;

      try {
        const payload = await requestJson(endpoint, {
          signal: controller.signal,
        });

        const data = normalizeIndexResponse(payload);

        renderIndex(data, {
          initial: initial || !state.index.loaded,
        });
      } catch (error) {
        if (error.name === "AbortError") {
          return;
        }

        console.error("Unable to load Main Market index:", error);

        /*
         * On an initial failure replace the skeleton
         * with an unavailable state.
         *
         * On later refresh failures leave the last
         * successful market value visible.
         */

        if (!state.index.loaded) {
          renderIndexUnavailable();
        }
      } finally {
        if (state.index.controller === controller) {
          state.index.controller = null;
        }
      }
    }

    /* ========================================================================
     Activity API Normalization
     ======================================================================== */

    function extractActivityRows(payload) {
      if (Array.isArray(payload)) {
        return payload;
      }

      if (!payload || typeof payload !== "object") {
        return [];
      }

      /*
       * Current DataTables-style backend is expected
       * to use `data`.
       *
       * Other common wrappers are supported defensively.
       */

      return (
        [payload.data, payload.aaData, payload.rows, payload.results].find(
          Array.isArray,
        ) || []
      );
    }

    function normalizePerformance(value) {
      const number = toNumber(value);

      if (number === null) {
        return "neutral";
      }

      return getDirection(number);
    }

    function normalizeActivityItem(row) {
      return {
        symbol: String(row?.symbol ?? ""),

        companyName: String(row?.companyName ?? ""),

        companyURL: getSafeHref(row?.companyURL),

        companyStatus: toNumber(row?.companyStatus),

        watchListId: row?.watchListId ?? 0,

        lastTradedPrice: toNumber(row?.lastTradedPrice),

        netChange: toNumber(row?.netChange),

        netPercentChange: toNumber(row?.netPercentChange),

        volume: toNumber(row?.volume),

        turnover: toNumber(row?.turnover),

        performance: [
          row?.day1Performance,
          row?.day2Performance,
          row?.day3Performance,
          row?.day4Performance,
          row?.day5Performance,
        ].map(normalizePerformance),
      };
    }

    function normalizeActivityResponse(payload) {
      return extractActivityRows(payload)
        .map(normalizeActivityItem)
        .filter((item) => item.symbol);
    }

