  /* ==========================================================================
     Desktop Table Reconciliation
     ========================================================================== */

  function renderActivityTable(
    type,
    items,
    {
      initial = false,
    } = {}
  ) {
    const body =
      document.querySelector(
        `[data-market-activity-body="${type}"]`
      );

    const table =
      document.querySelector(
        `[data-market-activity-table="${type}"]`
      );

    if (!body) {
      return;
    }

    /*
     * Only real rendered rows have data-market-symbol.
     *
     * Initial skeleton rows therefore stay outside
     * this keyed map and can be removed once.
     */

    const existingRows =
      new Map(
        Array.from(
          body.querySelectorAll(
            "tr[data-market-symbol]"
          )
        ).map(
          (row) => [
            row.dataset
              .marketSymbol,

            row,
          ]
        )
      );

    /*
     * Remove skeleton rows or old status rows.
     */

    body
      .querySelectorAll(
        "tr:not([data-market-symbol])"
      )
      .forEach(
        (row) => {
          row.remove();
        }
      );

    const visibleSymbols =
      new Set();

    items.forEach(
      (item) => {
        visibleSymbols.add(
          item.symbol
        );

        let row =
          existingRows.get(
            item.symbol
          );

        const isNew =
          !row;

        if (!row) {
          row =
            createActivityRow(
              type,
              item
            );
        }

        updateActivityRow(
          row,
          type,
          item,
          {
            initial:
              initial ||
              isNew,
          }
        );

        /*
         * appendChild() moves an existing node.
         *
         * Therefore backend ranking changes can be
         * reflected without destroying every row.
         */

        body.appendChild(
          row
        );
      }
    );

    /*
     * Remove companies that are no longer in the
     * returned Top 4 result.
     */

    existingRows.forEach(
      (
        row,
        symbol
      ) => {
        if (
          !visibleSymbols.has(
            symbol
          )
        ) {
          row.remove();
        }
      }
    );

    table?.setAttribute(
      "aria-busy",
      "false"
    );
  }

