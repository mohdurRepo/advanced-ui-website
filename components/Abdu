                    class="form-control custom-date__native"
                    id="historical-date-start"
                    name="startDate"
                    type="date"
                    data-date-start
                    data-historical-date-start
                    aria-label="<fmt:message key='filter.date' /> start"
                    required
                  />

                  <input
                    class="form-control custom-date__native"
                    id="historical-date-end"
                    name="endDate"
                    type="date"
                    data-date-end
                    data-historical-date-end
                    aria-label="<fmt:message key='filter.date' /> end"
                    required
                  />
                </div>

                <div class="custom-date__initial-trigger" aria-hidden="true">
                  <span class="custom-date__initial-value is-placeholder">
                    YYYY-MM-DD – YYYY-MM-DD
                  </span>

