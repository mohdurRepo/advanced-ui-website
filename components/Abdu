      ),

    indexChange:
      document.querySelector(
        "[data-market-index-change]"
      ),

    indexChangePercent:
      document.querySelector(
        "[data-market-index-change-percent]"
      ),

    requestLocale:
      document.getElementById(
        "requestLocale"
      ),
  };

  /* ==========================================================================
     Live Update Timers
     ========================================================================== */

  const liveUpdateTimers =
    new WeakMap();

  /* ==========================================================================
     Generic Utilities
     ========================================================================== */

  function toNumber(value) {
    if (
      typeof value === "number"
    ) {
      return Number.isFinite(value)
        ? value
        : null;
    }

    if (
      value === null ||
      value === undefined ||
      value === ""
    ) {
      return null;
    }

    const normalized =
      String(value)
        .replace(/,/g, "")
        .trim();

    if (!normalized) {
      return null;
    }

    const number =
      Number(normalized);

    return Number.isFinite(number)
      ? number
      : null;
  }

  function getDirection(value) {
    if (value > 0) {
      return "up";
    }

    if (value < 0) {
      return "down";
    }

    return "neutral";
  }

  function applyPriceState(
    element,
    value
  ) {
    if (!element) {
      return;
    }

    element.classList.remove(
      "price-up",
      "price-down",
      "price-neutral"
    );

    element.classList.add(
      `price-${getDirection(value)}`
    );
  }

  function sanitizeId(value) {
    return String(value)
      .toLowerCase()
      .replace(
        /[^a-z0-9_-]+/g,
        "-"
      )
      .replace(
        /^-+|-+$/g,
        ""
      );
  }

  function getRequestLocale() {
    return (
      config.requestLocale ||
      dom.requestLocale?.value ||
      document.documentElement.lang ||
      "en"
    );
  }

  function getSafeHref(value) {
    if (!value) {
      return null;
    }

    try {
      const url =
        new URL(
          String(value),
          window.location.href
        );

      return (
        url.protocol === "http:" ||
        url.protocol === "https:"
      )
        ? url.href
        : null;
    } catch {
      return null;
    }
  }

  function normalizeLabelText(
    value
  ) {
    return String(
      value || ""
    )
      .replace(
        /\s+/g,
        " "
      )
      .trim();
  }

  /* ==========================================================================
     Numeric DOM Updates
     ========================================================================== */

  function setDataValue(
    element,
    rawValue,
    formattedValue,
    {
      animate = false,
    } = {}
  ) {
    if (!element) {
      return;
    }

    const previousValue =
      toNumber(
        element.getAttribute(
          "value"
        )
      );

    if (
      rawValue === null ||
      rawValue === undefined
    ) {
      element.removeAttribute(
        "value"
      );
    } else {
      element.setAttribute(
        "value",
        String(rawValue)
      );
    }

    element.textContent =
      formattedValue;

    if (
      animate &&
      previousValue !== null &&
      rawValue !== null &&
      rawValue !== undefined &&
      previousValue !== rawValue
    ) {
      triggerLiveUpdate(
        element,
        previousValue,
        rawValue
      );
    }
  }

  /* ==========================================================================
     Live Refresh Highlight
     ========================================================================== */

  function triggerLiveUpdate(
    element,
    previousValue,
    nextValue
  ) {
    if (
      !element ||
      previousValue === nextValue
    ) {
      return;
    }

    const direction =
      nextValue > previousValue
        ? "up"
        : nextValue < previousValue
          ? "down"
          : "neutral";

    const classes = [
      "is-updating-up",
      "is-updating-down",
      "is-updating-neutral",
    ];

    element.classList.remove(
      ...classes
    );

    const existingTimer =
      liveUpdateTimers.get(
        element
      );

    if (existingTimer) {
      window.clearTimeout(
        existingTimer
      );
    }

    /*
     * Intentional reflow.
     *
     * This allows the same temporary update
     * feedback to run on consecutive refreshes.
     */

    void element.offsetWidth;

    element.classList.add(
      `is-updating-${direction}`
    );

    const timer =
      window.setTimeout(
        () => {
          element.classList.remove(
            ...classes
          );

          liveUpdateTimers.delete(
            element
          );
        },
        LIVE_UPDATE_DURATION
      );

    liveUpdateTimers.set(
      element,
      timer
    );
  }

  /* ==========================================================================
     jQuery AJAX Transport
     ========================================================================== */

  /*
   * Important:
   *
   * We deliberately keep jQuery AJAX because these
   * are existing Liferay/portlet resource URLs.
   *
   * We also deliberately request text and parse JSON
   * ourselves.
   *
   * That gives us useful diagnostics when a portal
   * redirect/error returns:
   *
   *   <!doctype html>
   *
   * rather than only receiving a generic JSON parser
   * exception from jQuery.
   */

  function parseJsonResponse(
    responseText,
    url
  ) {
    if (
      responseText === null ||
      responseText === undefined
    ) {
      return null;
    }

    if (
      typeof responseText ===
      "object"
    ) {
      return responseText;
    }

    const text =
      String(responseText)
        .trim();

    if (!text) {
      return null;
    }

    if (
      /^\s*<!doctype/i.test(
        text
      ) ||
      /^\s*<html/i.test(
        text
      )
    ) {
      throw new Error(
        [
          "Expected JSON but received HTML from",
          `${url}.`,
          "Check the generated resource URL and resource handler.",
        ].join(" ")
      );
    }

    let parsed;

    try {
      parsed =
        JSON.parse(text);
    } catch (error) {
      throw new Error(
        `Invalid JSON returned by ${url}: ${error.message}`
      );
    }

    /*
     * Defensive support for an endpoint that
     * serializes JSON twice.
     */

    if (
      typeof parsed ===
      "string"
    ) {
      const nested =
        parsed.trim();

      if (
        nested.startsWith("{") ||
        nested.startsWith("[")
      ) {
        try {
          return JSON.parse(
            nested
          );
        } catch {
          return parsed;
        }
      }
    }

    return parsed;
  }

  function ajaxJson(
    url,
    {
      data = {},
    } = {}
  ) {
    let jqXHR = null;

    const promise =
      new Promise(
        (
          resolve,
          reject
        ) => {
          jqXHR =
            $.ajax({
              url,

              type: "GET",

              data,

              /*
               * We parse manually.
               */

              dataType: "text",

              cache: false,
            })
              .done(
                (
                  responseText,
                  _textStatus,
                  xhr
                ) => {
                  try {
                    resolve(
                      parseJsonResponse(
                        responseText,
                        url
                      )
                    );
                  } catch (error) {
                    console.error(
                      "Main Market endpoint returned an unexpected response:",
                      {
                        url,

                        status:
                          xhr?.status,

                        contentType:
                          xhr
                            ?.getResponseHeader?.(
                              "Content-Type"
                            ),

                        preview:
                          String(
                            responseText
                          ).slice(
                            0,
                            300
                          ),
                      }
                    );

                    reject(
                      error
                    );
                  }
                }
              )
              .fail(
                (
                  xhr,
                  textStatus,
                  errorThrown
                ) => {
                  if (
                    textStatus ===
                    "abort"
                  ) {
                    const error =
                      new Error(
                        "Request aborted"
                      );

                    error.name =
                      "AbortError";

                    reject(
                      error
                    );

                    return;
                  }

                  const responseText =
                    xhr?.responseText
                      ? String(
                          xhr.responseText
                        )
                      : "";

                  const htmlResponse =
                    /^\s*</.test(
                      responseText
                    );

                  reject(
                    new Error(
                      [
                        `Request failed (${xhr?.status || 0}).`,

                        errorThrown ||
                          textStatus ||
                          "Unknown error.",

                        htmlResponse
                          ? "Server returned HTML instead of JSON."
                          : "",

                        `Endpoint: ${url}`,
                      ]
                        .filter(
                          Boolean
                        )
                        .join(
                          " "
                        )
                    )
                  );
                }
              );
        }
      );

    return {
      promise,

      abort() {
        if (
          jqXHR &&
          jqXHR.readyState !== 4
        ) {
          jqXHR.abort();
        }
      },
    };
  }

  /* ==========================================================================
     Hero / TASI Index Endpoint
     ========================================================================== */

  function getMarketIndexEndpoint() {
    /*
     * Option 1:
     *
     * HTML-owned Hero URL.
     */

    const attributeUrl =
      dom.index?.getAttribute(
        "data-market-index-url"
      );

    if (
      attributeUrl?.trim()
    ) {
      return attributeUrl.trim();
    }

    /*
     * Option 2:
     *
     * MainMarketConfig.
     *
     * We already support this now, so when we add
     * the Hero endpoint to the JSP later the JS will
     * not need another structural rewrite.
     */

    const configuredUrl =
      endpoints.index ||
      config.marketIndexUrl;

    if (
      typeof configuredUrl ===
        "string" &&
      configuredUrl.trim()
    ) {
      return configuredUrl.trim();
    }

    /*
     * Option 3:
     *
     * Existing legacy global.
     *
     * This keeps the Hero working until we complete
     * its JSP endpoint migration.
     */

    if (
      typeof window
        .getMarketIndexUrl ===
        "string" &&
      window
        .getMarketIndexUrl
        .trim()
    ) {
      return window
        .getMarketIndexUrl
        .trim();
    }

    return null;
  }

  /* ==========================================================================
     Hero Response Normalization
     ========================================================================== */

  function normalizeIndexResponse(
    payload
  ) {
    if (
      !payload ||
      typeof payload !== "object"
    ) {
      throw new Error(
        "Invalid Main Market index response."
      );
    }

    const indexPrice =
      toNumber(
        payload.indexPrice
      );

    const netChange =
      toNumber(
        payload.netChange
      );

    const percentChange =
      toNumber(
        payload.percentChange
      );

    if (
      indexPrice === null ||
      netChange === null ||
      percentChange === null
    ) {
      throw new Error(
        [
          "Main Market index response is missing",
          "indexPrice, netChange or percentChange.",
        ].join(" ")
      );
    }

    return {
      indexPrice,
      netChange,
      percentChange,
    };
  }

  /* ==========================================================================
     Hero Loading State
     ========================================================================== */

  function revealIndexLiveState() {
    dom.indexLoading.forEach(
      (element) => {
        element.hidden =
          true;
      }
    );

    dom.indexLive.forEach(
      (element) => {
        element.hidden =
          false;
      }
    );

    dom.index?.setAttribute(
      "aria-busy",
      "false"
    );
  }

  /* ==========================================================================
     Hero Render
     ========================================================================== */

  function renderIndex(
    data,
    {
      initial = false,
    } = {}
  ) {
    if (!dom.index) {
      return;
    }

    const direction =
      getDirection(
        data.netChange
      );

    /* ------------------------------------------------------------------------
       Current Index
       ------------------------------------------------------------------------ */

    setDataValue(
      dom.indexValue,

      data.indexPrice,

      priceFormatter.format(
        data.indexPrice
      ),

      {
        animate:
          !initial,
      }
    );

    /* ------------------------------------------------------------------------
       Net Change
       ------------------------------------------------------------------------ */

    setDataValue(
      dom.indexChange,

      data.netChange,

      signedPriceFormatter.format(
        data.netChange
      )
    );

    /* ------------------------------------------------------------------------
       Percentage Change
       ------------------------------------------------------------------------ */

    if (
      dom.indexChangePercent
    ) {
      dom.indexChangePercent
        .textContent =
        `(${signedPercentFormatter.format(
          data.percentChange
        )}%)`;
    }

    /* ------------------------------------------------------------------------
       Semantic State
       ------------------------------------------------------------------------ */

    applyPriceState(
      dom.indexChangeState,
      data.netChange
    );

    /* ------------------------------------------------------------------------
       Direction Icon
       ------------------------------------------------------------------------ */

    if (
      dom.indexChangeIcon
    ) {
      if (
        direction ===
        "neutral"
      ) {
        dom.indexChangeIcon.hidden =
          true;

        dom.indexChangeIcon
          .style.transform =
          "";
      } else {
        dom.indexChangeIcon.hidden =
          false;

        dom.indexChangeIcon
          .style.transform =
          direction === "down"
            ? "rotate(180deg)"
            : "";
      }
    }

    /* ------------------------------------------------------------------------
       Accessible Market Description
       ------------------------------------------------------------------------ */

    const movementText =
      direction === "up"
        ? "Increased"
        : direction === "down"
          ? "Decreased"
          : "Unchanged";

    dom.index.setAttribute(
      "aria-label",

      [
        `TASI Index: ${priceFormatter.format(
          data.indexPrice
        )} points.`,

        `${movementText} by ${priceFormatter.format(
          Math.abs(
            data.netChange
          )
        )} points,`,

        `or ${priceFormatter.format(
          Math.abs(
            data.percentChange
          )
        )} percent.`,
      ].join(
        " "
      )
    );

    revealIndexLiveState();

    state.index.loaded =
      true;
  }

  /* ==========================================================================
     Hero Initial Failure
     ========================================================================== */

  function renderIndexUnavailable() {
    if (!dom.index) {
      return;
    }

    revealIndexLiveState();

    setDataValue(
      dom.indexValue,
      null,
      "—"
    );

    setDataValue(
      dom.indexChange,
      null,
      "—"
    );

    if (
      dom.indexChangePercent
    ) {
      dom.indexChangePercent
        .textContent =
        "—";
    }

    if (
      dom.indexChangeIcon
    ) {
      dom.indexChangeIcon.hidden =
        true;

      dom.indexChangeIcon
        .style.transform =
        "";
    }

    dom.indexChangeState
      ?.classList.remove(
        "price-up",
        "price-down",
        "price-neutral"
      );

    dom.index.setAttribute(
      "aria-label",
      "TASI Index market data is temporarily unavailable."
    );
  }

  /* ==========================================================================
     Hero Request
     ========================================================================== */

  async function loadMarketIndex({
    initial = false,
  } = {}) {
    if (!dom.index) {
      return;
    }

    const endpoint =
      getMarketIndexEndpoint();

    if (!endpoint) {
      console.error(
        [
          "Main Market: index endpoint is unavailable.",
          "Add endpoints.index / marketIndexUrl to MainMarketConfig",
          "or expose data-market-index-url.",
        ].join(" ")
      );

      if (
        !state.index.loaded
      ) {
        renderIndexUnavailable();
      }

      return;
    }

    /*
     * Prevent an older Hero request from replacing
     * a newer response.
     */

    state.index.request
      ?.abort();

    const request =
      ajaxJson(
        endpoint
      );

    state.index.request =
      request;

    try {
      const payload =
        await request.promise;

      const data =
        normalizeIndexResponse(
          payload
        );

      renderIndex(
        data,

        {
          initial:
            initial ||
            !state.index.loaded,
        }
      );
    } catch (error) {
      if (
        error.name ===
        "AbortError"
      ) {
        return;
      }

      console.error(
        "Unable to load Main Market index:",
        error
      );

      /*
       * Initial failure:
       * reveal unavailable state.
       *
       * Refresh failure:
       * preserve the last successful value.
       */

      if (
        !state.index.loaded
      ) {
        renderIndexUnavailable();
      }
    } finally {
      if (
        state.index.request ===
        request
      ) {
        state.index.request =
          null;
      }
    }
  }

  /* ==========================================================================
     Activity Endpoints
     ========================================================================== */

  function getActivityView(type) {
    return document.querySelector(
      `[data-market-activity-view="${type}"]`
    );
  }

  function getActivityUrl(type) {
    const endpoint =
      endpoints[type];

    return (
      typeof endpoint ===
        "string" &&
      endpoint.trim()
    )
      ? endpoint.trim()
      : null;
  }

  /* ==========================================================================
     Activity Response Extraction
     ========================================================================== */

  function extractActivityRows(
    payload
  ) {
    if (
      Array.isArray(
        payload
      )
    ) {
      return payload;
    }

    if (
      !payload ||
      typeof payload !==
        "object"
    ) {
      return [];
    }

    const candidates = [
      payload.data,
      payload.aaData,
      payload.rows,
      payload.results,
    ];

    return (
      candidates.find(
        Array.isArray
      ) ||
      []
    );
  }

  /* ==========================================================================
     Five-Day Performance Normalization
     ========================================================================== */

  function normalizePerformance(
    value
  ) {
    const number =
      toNumber(
        value
      );

    if (
      number === null
    ) {
      return "neutral";
    }

    return getDirection(
      number
    );
  }

  /* ==========================================================================
     Activity Item Normalization
     ========================================================================== */

  function normalizeActivityItem(
    row
  ) {
    return {
      symbol:
        String(
          row?.symbol ??
            ""
        ).trim(),

      companyName:
        String(
          row?.companyName ??
            ""
        ).trim(),

      companyURL:
        getSafeHref(
          row?.companyURL
        ),

      companyStatus:
        toNumber(
          row?.companyStatus
        ),

      watchListId:
        row?.watchListId ??
        0,

      lastTradedPrice:
        toNumber(
          row?.lastTradedPrice
        ),

      netChange:
        toNumber(
          row?.netChange
        ),

      netPercentChange:
        toNumber(
          row?.netPercentChange
        ),

      volume:
        toNumber(
          row?.volume
        ),

      turnover:
        toNumber(
          row?.turnover
        ),

      performance: [
        row?.day1Performance,
        row?.day2Performance,
        row?.day3Performance,
        row?.day4Performance,
        row?.day5Performance,
      ].map(
        normalizePerformance
      ),
    };
  }

  function normalizeActivityResponse(
    payload
  ) {
    return extractActivityRows(
      payload
    )
      .map(
        normalizeActivityItem
      )
      .filter(
        (item) =>
          item.symbol
      );
  }

  /* ==========================================================================
     Activity Column Configuration
     ========================================================================== */

  function getActivityColumnCount(
    type
  ) {
    return (
      type === "volume" ||
      type === "value"
    )
      ? 6
      : 5;
  }

  function getActivityExtraLabel(
    type
  ) {
    if (
      type === "volume"
    ) {
      return "Volume";
    }

    if (
      type === "value"
    ) {
      return "Value";
    }

    return null;
  }

  function getActivityExtraValue(
    type,
    item
  ) {
    if (
      type === "volume"
    ) {
      return item.volume;
    }

    if (
      type === "value"
    ) {
      return item.turnover;
    }

    return null;
  }

  function formatActivityExtra(
    type,
    value
  ) {
    if (
      value === null
    ) {
      return "—";
    }

    if (
      type === "volume"
    ) {
      return integerFormatter.format(
        value
      );
    }

    return moneyFormatter.format(
      value
    );
  }

  /* ==========================================================================
     Activity Labels
     ========================================================================== */

  /*
   * Labels come from the JSP-rendered table headers.
   *
   * That means the external JS does not need JSP
   * localization tags.
   */

  function getActivityTableHeaders(
    type
  ) {
    const table =
      document.querySelector(
        `[data-market-activity-table="${type}"]`
      );

    if (!table) {
      return [];
    }

    return Array.from(
      table.querySelectorAll(
        "thead th"
      )
    ).map(
      (header) =>
        normalizeLabelText(
          header.textContent
        )
    );
  }

  function getActivityLabels(
    type
  ) {
    const headers =
      getActivityTableHeaders(
        type
      );

    const hasExtra =
      type === "volume" ||
      type === "value";

    return {
      company:
        headers[0] ||
        "Company",

      price:
        headers[1] ||
        "Price",

      change:
        headers[2] ||
        "Change",

      percent:
        headers[3] ||
        "Change %",

      extra:
        hasExtra
          ? (
              headers[4] ||
              getActivityExtraLabel(
                type
              )
            )
          : null,

      performance:
        headers[
          hasExtra
            ? 5
            : 4
        ] ||
        "5 Day Performance",
    };
  }

  /* ==========================================================================
     Watchlist
     ========================================================================== */

  function isUserValidated() {
    return (
      document.getElementById(
        "isUserValidated"
      )?.value ===
      "YES"
    );
  }

  function hasWatchlistEntry(
    item
  ) {
    const id =
      item?.watchListId;

    return !(
      id === 0 ||
      id === "0" ||
      id === null ||
      id === undefined ||
      id === ""
    );
  }

  function getWatchlistLabel(
    item
  ) {
    const name =
      item.companyName ||
      item.symbol;

    if (
      !isUserValidated()
    ) {
      return (
        `Sign in to add ${name} ` +
        "to watchlist"
      );
    }

    return hasWatchlistEntry(
      item
    )
      ? `Remove ${name} from watchlist`
      : `Add ${name} to watchlist`;
  }

  function syncWatchlistButton(
    button,
    item
  ) {
    if (!button) {
      return;
    }

    const active =
      hasWatchlistEntry(
        item
      );

    button.dataset
      .marketWatchlist =
      item.symbol;

    button.dataset
      .watchListId =
      String(
        item.watchListId ??
        0
      );

    button.setAttribute(
      "aria-pressed",
      String(
        active
      )
    );

    button.setAttribute(
      "aria-label",
      getWatchlistLabel(
        item
      )
    );

    button.classList.toggle(
      "is-active",
      active
    );
  }

  function createWatchlistButton(
    item,
    {
      mobile = false,
    } = {}
  ) {
    const button =
      document.createElement(
        "button"
      );

    button.type =
      "button";

    button.className =
      mobile
        ? "data-card__favorite has-icon icon-star-outline"
        : "market-activity-table__watchlist has-icon icon-star-outline";

    syncWatchlistButton(
      button,
      item
    );

    return button;
  }

  function handleWatchlist(
    item
  ) {
    if (!item) {
      return;
    }

    /* ------------------------------------------------------------------------
       Not Logged In
       ------------------------------------------------------------------------ */

    if (
      !isUserValidated()
    ) {
      if (
        typeof window
          .showLoginForm ===
        "function"
      ) {
        window.showLoginForm(
          item.symbol
        );
      }

      return;
    }

    /* ------------------------------------------------------------------------
       Existing Watchlist Entry
       ------------------------------------------------------------------------ */

    if (
      hasWatchlistEntry(
        item
      )
    ) {
      if (
        typeof window
          .deleteCompanyFromWatchlist ===
        "function"
      ) {
        window
          .deleteCompanyFromWatchlist(
            item.watchListId,
            item.symbol
          );
      }

      return;
    }

    /* ------------------------------------------------------------------------
       Add Watchlist Entry
       ------------------------------------------------------------------------ */

    if (
      typeof window
        .showAddToWatchListPopup ===
      "function"
    ) {
      window
        .showAddToWatchListPopup(
          item.symbol
        );
    }
  }

  /* ==========================================================================
     Five-Day Performance DOM
     ========================================================================== */

  function getPerformanceLabel(
    performance
  ) {
    const labels =
      performance.map(
        (
          direction,
          index
        ) => {
          const day =
            index + 1;

          if (
            direction === "up"
          ) {
            return (
              `day ${day} up`
            );
          }

          if (
            direction === "down"
          ) {
            return (
              `day ${day} down`
            );
          }

          return (
            `day ${day} ` +
            "no change or no data"
          );
        }
      );

    return (
      "Five-day performance: " +
      `${labels.join(", ")}.`
    );
  }

  function createPerformanceElement(
    performance
  ) {
    const wrapper =
      document.createElement(
        "div"
      );

    wrapper.className =
      "market-activity-table__performance";

    wrapper.setAttribute(
      "role",
      "img"
    );

    wrapper.setAttribute(
      "aria-label",
      getPerformanceLabel(
        performance
      )
    );

    performance.forEach(
      (direction) => {
        const bar =
          document.createElement(
            "span"
          );

        bar.className =
          `is-${direction}`;

        bar.setAttribute(
          "aria-hidden",
          "true"
        );

        wrapper.appendChild(
          bar
        );
      }
    );

    return wrapper;
  }

  function updatePerformanceElement(
    element,
    performance
  ) {
    if (!element) {
      return;
    }

    element.setAttribute(
      "aria-label",
      getPerformanceLabel(
        performance
      )
    );

    const bars =
      Array.from(
        element.children
      );

    if (
      bars.length !==
      performance.length
    ) {
      element.replaceChildren(
        ...performance.map(
          (direction) => {
            const bar =
              document.createElement(
                "span"
              );

            bar.className =
              `is-${direction}`;

            bar.setAttribute(
              "aria-hidden",
              "true"
            );

            return bar;
          }
        )
      );

      return;
    }

    bars.forEach(
      (
        bar,
        index
      ) => {
        bar.classList.remove(
          "is-up",
          "is-down",
          "is-neutral"
        );

        bar.classList.add(
          `is-${performance[index]}`
        );
      }
    );
  }

  /* ==========================================================================
     Desktop Company Identity
     ========================================================================== */

  function createCompanyIdentity(
    item
  ) {
    const wrapper =
      document.createElement(
        "div"
      );

    wrapper.className =
      "market-activity-table__company-content";

    wrapper.appendChild(
      createWatchlistButton(
        item
      )
    );

    const identity =
      document.createElement(
        "span"
      );

    identity.className =
      "market-activity-table__company-identity";

    const name =
      document.createElement(
        item.companyURL
          ? "a"
          : "span"
      );

    name.className =
      "market-activity-table__company-name";

    name.textContent =
      item.companyName ||
      item.symbol;

    if (
      item.companyURL
    ) {
      name.href =
        item.companyURL;
    }

    const symbol =
      document.createElement(
        "span"
      );

    symbol.className =
      "market-activity-table__company-symbol";

    symbol.dir =
      "ltr";

    symbol.textContent =
      item.symbol;

    identity.append(
