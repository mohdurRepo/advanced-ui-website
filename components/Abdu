<%-- =========================================================================
Home Discovery Search
========================================================================= --%>

<form
  id="searchForm"
  class="home-discovery-search"
  role="search"
  aria-label="Search companies, news, and market updates"
  action="#"
  method="get"
>
  <label class="visually-hidden" for="home-discovery-search-input">
    Search companies, news, and market updates
  </label>

  <span
    class="home-discovery-search__icon has-icon icon-search"
    aria-hidden="true"
  ></span>

  <input
    id="home-discovery-search-input"
    class="home-discovery-search__input"
    type="text"
    name="q"
    placeholder="Search companies, news, and updates"
    autocomplete="off"
    inputmode="search"
    enterkeyhint="search"
    spellcheck="false"
  />

  <button
    id="searchCompanyButton"
    class="home-discovery-search__submit has-icon icon-chevron-right icon-flip-rtl"
    type="submit"
    aria-label="Submit search"
  ></button>
</form>

<%-- =========================================================================
Company Search Data
========================================================================= --%>

<script>
  /**
   * Shared company collection used by:
   *
   * - Home discovery search
   * - Company search modal
   * - Existing Portal submitSearch()
   */
  window.searchableSymbols = Array.isArray(window.searchableSymbols)
    ? window.searchableSymbols
    : [];

  document.addEventListener("DOMContentLoaded", function () {
    refreshCompanySearchDetails();
  });

  function refreshCompanySearchDetails() {
    $.ajax({
      type: "GET",

      /*
       * Replace this with the actual Portal endpoint.
       */
      url: "/rul",

      dataType: "json",

      success: function (msg) {
        /**
         * Preserve the existing Portal contract.
         */
        window.searchableSymbols = Array.isArray(msg) ? msg : [];

        /**
         * Notify company-search/index.js that fresh API data
         * is available.
         *
         * Both the home and modal Typeahead instances will
         * use the same collection.
         */
        window.dispatchEvent(
          new CustomEvent("company-search:data", {
            detail: {
              companies: window.searchableSymbols,
            },
          }),
        );
      },

      error: function (xhr, status, error) {
        console.error("Company search API request failed:", status, error);

        /**
         * Keep the shared Portal collection valid.
         */
        window.searchableSymbols = [];

        window.dispatchEvent(
          new CustomEvent("company-search:error", {
            detail: {
              status: status,
              error: error,
            },
          }),
        );
      },
    });
  }
</script>

<%-- =========================================================================
Company Search Modal
========================================================================= --%>

<div
  id="companySearchModal"
  class="modal modal-lg modal-rounded modal-no-header modal-no-footer modal-visual company-search-modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="companySearchModalTitle"
  aria-describedby="companySearchModalDescription"
>
  <!-- =============================================================
       Backdrop
       ============================================================== -->

  <div class="modal-backdrop" data-modal-close aria-hidden="true"></div>

  <!-- =============================================================
       Dialog
       ============================================================== -->

  <div class="modal-dialog">
    <div class="modal-content surface-hero">
      <div class="modal-body">
        <!-- =========================================================
             Heading
             ========================================================= -->

        <div class="modal-login-heading">
          <div>
            <p class="modal-subtitle">Market Search</p>

            <h2 id="companySearchModalTitle" class="modal-title">
              Search for a company
            </h2>

            <p id="companySearchModalDescription" class="modal-subtitle">
              Search by company name, symbol, ISIN, or sector.
            </p>
          </div>
        </div>

        <!-- =========================================================
             Close
             ========================================================= -->

        <button
          class="modal-close"
          type="button"
          data-modal-close
          aria-label="Close company search"
        ></button>

        <!-- =========================================================
             Company Search
             ========================================================= -->

        <div class="company-search">
          <form
            id="companySearchForm"
            class="company-search__form"
            role="search"
            action="#"
            method="get"
          >
            <label class="visually-hidden" for="companySearchInput">
              Search companies
            </label>

            <div class="company-search__field">
              <span
                class="company-search__search-icon has-icon icon-search"
                aria-hidden="true"
              ></span>

              <input
                id="companySearchInput"
                class="form-control"
                type="text"
                name="company"
                placeholder="Search by company, symbol, ISIN, or sector"
                autocomplete="off"
                inputmode="search"
                enterkeyhint="search"
                spellcheck="false"
                data-modal-initial-focus
              />
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
