<script>
(() => {
  "use strict";

  /* ==========================================================================
     Main Market — Production Live Data
     ========================================================================== */

  const REFRESH_INTERVAL = 60_000;
  const LIVE_UPDATE_DURATION = 900;
  const ACTIVITY_LIMIT = 4;

  const ACTIVITY_TYPES = Object.freeze([
    "gainers",
    "losers",
    "volume",
    "value",
  ]);

  /* ==========================================================================
     jQuery
     ========================================================================== */

  if (
    typeof window.jQuery === "undefined" ||
    typeof window.jQuery.ajax !== "function"
  ) {
    console.error(
      "Main Market: jQuery must load before market-summary.js."
    );

    return;
  }

  const $ = window.jQuery;

  /* ==========================================================================
     JSP Configuration
     ========================================================================== */

  /*
   * Expected JSP configuration:
   *
   * window.MainMarketConfig = Object.freeze({
   *   requestLocale: "...",
   *
   *   endpoints: Object.freeze({
   *     gainers: "...",
   *     losers: "...",
   *     volume: "...",
   *     value: "..."
   *   })
   * });
   *
   * Hero support is also ready for:
   *
   *   endpoints.index
   *
   * or:
   *
   *   marketIndexUrl
   *
   * Until we wire that JSP value, the existing
   * window.getMarketIndexUrl legacy global remains
   * supported as a fallback.
   */

  const config =
    window.MainMarketConfig ?? {};

  const endpoints =
    config.endpoints ?? {};

  /* ==========================================================================
     Locale
     ========================================================================== */

  const locale =
    document.documentElement.lang ||
    config.requestLocale ||
    navigator.language ||
    "en-US";

  /* ==========================================================================
     Number Formatters
     ========================================================================== */

  const priceFormatter =
    new Intl.NumberFormat(
      locale,
      {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }
    );

  const signedPriceFormatter =
    new Intl.NumberFormat(
      locale,
      {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
        signDisplay: "exceptZero",
      }
    );

  const signedPercentFormatter =
    new Intl.NumberFormat(
      locale,
      {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
        signDisplay: "exceptZero",
      }
    );

  const integerFormatter =
    new Intl.NumberFormat(
      locale,
      {
        maximumFractionDigits: 0,
      }
    );

  const moneyFormatter =
    new Intl.NumberFormat(
      locale,
      {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }
    );

  /* ==========================================================================
     Runtime State
     ========================================================================== */

  const state = {
    started: false,

    refreshTimer: null,

    index: {
      loaded: false,
      request: null,
    },

    activity: Object.fromEntries(
      ACTIVITY_TYPES.map(
        (type) => [
          type,

          {
            loaded: false,
            request: null,
            items: new Map(),
          },
        ]
      )
    ),
  };

  /* ==========================================================================
     DOM Cache
     ========================================================================== */

  const dom = {
    index:
      document.querySelector(
        "[data-market-index]"
      ),

    indexLoading:
      document.querySelectorAll(
        "[data-market-index-loading]"
      ),

    indexLive:
      document.querySelectorAll(
        "[data-market-index-live]"
      ),

    indexValue:
      document.querySelector(
        "[data-market-index-value]"
      ),

    indexChangeState:
      document.querySelector(
        "[data-market-index-change-state]"
      ),

    indexChangeIcon:
      document.querySelector(
