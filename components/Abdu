        nav: "<fmt:message key='table.header.nav' />",
        closeYield: "<fmt:message key='table.header.close.yeild' />",
        mfDate: "<fmt:message key='table.header.mf.date' />",
        mfNav: "<fmt:message key='table.header.mf.nav' />",
        dailySettPrice: "<fmt:message key='table.header.daily.sett.price' />",
        openInterest: "<fmt:message key='table.header.open.interest' />",

