    function renderActivityTable(type, items, { initial = false } = {}) {
      const body = document.querySelector(
        `[data-market-activity-body="${type}"]`,
      );

      const table = document.querySelector(
        `[data-market-activity-table="${type}"]`,
      );

      if (!body) {
        return;
      }

      /*
       * Existing real rows are keyed by symbol.
       */

      const existingRows = new Map(
        Array.from(body.querySelectorAll("tr[data-market-symbol]")).map(
          (row) => [row.dataset.marketSymbol, row],
        ),
      );

      /*
       * Remove initial skeleton rows or an old
       * empty/error message.
       */

      body.querySelectorAll("tr:not([data-market-symbol])").forEach((row) => {
        row.remove();
      });

      const visibleSymbols = new Set();

      items.forEach((item) => {
        visibleSymbols.add(item.symbol);

        let row = existingRows.get(item.symbol);

        const isNew = !row;

        if (!row) {
          row = createActivityRow(type, item);
        }

        updateActivityRow(row, type, item, {
          initial: initial || isNew,
        });

        /*
         * Appending an existing DOM node moves it.
         *
         * This allows server ranking changes without
         * destroying every row.
         */

        body.appendChild(row);
      });

      /*
       * Remove companies no longer returned by the
       * endpoint.
       */

      existingRows.forEach((row, symbol) => {
        if (!visibleSymbols.has(symbol)) {
          row.remove();
        }
      });

      table?.setAttribute("aria-busy", "false");
    }

