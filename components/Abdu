                    class="custom-date__initial-indicator has-icon icon-calendar-scheduler"
                    aria-hidden="true"
                  ></span>
                </div>
              </div>
            </div>
          </fieldset>
        </div>

        <!-- ===================== ACTIONS ===================== -->
        <div class="filter-bar__actions">
          <button
            id="historicalResetBtn"
            type="button"
            class="btn btn-outline-primary"
            data-historical-reset
          >
            <span><fmt:message key="reset.btn.title" /></span>
            <span
              class="has-icon icon-sync-refresh icon-md"
              aria-hidden="true"
            ></span>
          </button>
        </div>
      </div>

      <p
        id="historicalFilterMessage"
        class="form-error"
        aria-live="polite"
        hidden
      ></p>
    </form>
  </div>
</section>
<%-- ==========================================================================
     Historical Reports Content
     ========================================================================== --%>

<section class="section">
  <div class="container">
    <!-- ======================================================================
         Tabs

         Fixed to match tabs.controller.js's selectors exactly:
         - root needs BOTH .tabs class AND data-tabs attribute (legacy had
           data-tabs on a different, unrelated wrapper)
         - tabs use role="tab" + data-tab-target (not data-tab-content)
         - panels use role="tabpanel" and live directly under .tabs-content
         data-tab is kept alongside data-tab-target so historical.feature-
         manager.js can read a stable semantic key ("performance") rather
         than a DOM id.
         ====================================================================== -->

    <div class="tabs" data-tabs>
      <div class="tabs-nav" role="tablist">
        <button
          type="button"
          class="tab-link"
          role="tab"
          id="historical-tab-performance"
          data-tab="performance"
          data-tab-target="historical-panel-performance"
          aria-selected="true"
        >
          <fmt:message key="performance.tab.title" />
        </button>

        <button
          type="button"
          class="tab-link"
          role="tab"
          id="historical-tab-unadjusted"
          data-tab="unadjusted"
          data-tab-target="historical-panel-unadjusted"
          aria-selected="false"
          tabindex="-1"
        >
          <fmt:message key="unadjust.price.tab.title" />
        </button>
      </div>

      <div class="tabs-content">
        <!-- ==================================================================
             Performance Panel
             ================================================================== -->

        <section
          class="tab-pane"
          role="tabpanel"
          id="historical-panel-performance"
        >
          <div class="data-view" data-historical-view="performance">
            <div class="data-view__workspace">
              <div class="data-view__table">
                <div class="table-shell" data-table-shell>
                  <section
                    class="table-responsive custom-scrollbar"
                    tabindex="0"
                    role="region"
                    aria-label="<fmt:message key='performance.tab.title' />"
                  >
                    <table
                      id="historical-performance-table"
                      class="table table-hover table-nowrap"
                      data-historical-table="performance"
                      aria-busy="true"
                    >
                      <caption class="visually-hidden">
                        <fmt:message key="performance.tab.title" />
                      </caption>

                      <thead>
                        <tr></tr>
                      </thead>

                      <tbody></tbody>
                    </table>
                  </section>

                  <button
                    type="button"
                    class="table-scroll-jump has-icon icon-chevron-right-bold icon-md icon-flip-rtl"
                    data-table-scroll-jump
                    data-table-scroll-direction="end"
                    aria-label="Jump to last columns"
                    title="Jump to last columns"
                    hidden
                  >
                    <span class="visually-hidden">Jump to last columns</span>
                  </button>
                </div>
              </div>

              <div
                class="data-view__cards"
                data-historical-mobile="performance"
              >
                <div
                  class="data-view__cards-inner"
                  data-historical-mobile-cards="performance"
                  aria-busy="true"
                ></div>
              </div>
            </div>
          </div>
        </section>

        <!-- ==================================================================
             Unadjusted Price Panel
             ================================================================== -->

        <section
          class="tab-pane"
          role="tabpanel"
          id="historical-panel-unadjusted"
          hidden
        >
          <div class="data-view" data-historical-view="unadjusted">
            <div class="data-view__workspace">
              <div class="data-view__table">
                <div class="table-shell" data-table-shell>
                  <section
                    class="table-responsive custom-scrollbar"
                    tabindex="0"
                    role="region"
                    aria-label="<fmt:message key='unadjust.price.tab.title' />"
                  >
                    <table
                      id="historical-unadjusted-table"
                      class="table table-hover table-nowrap"
                      data-historical-table="unadjusted"
                      aria-busy="true"
                    >
                      <caption class="visually-hidden">
                        <fmt:message key="unadjust.price.tab.title" />
                      </caption>

                      <thead>
                        <tr></tr>
                      </thead>

                      <tbody></tbody>
                    </table>
                  </section>

                  <button
                    type="button"
                    class="table-scroll-jump has-icon icon-chevron-right-bold icon-md icon-flip-rtl"
                    data-table-scroll-jump
                    data-table-scroll-direction="end"
                    aria-label="Jump to last columns"
                    title="Jump to last columns"
                    hidden
                  >
                    <span class="visually-hidden">Jump to last columns</span>
                  </button>
                </div>
              </div>

              <div
                class="data-view__cards"
                data-historical-mobile="unadjusted"
              >
                <div
                  class="data-view__cards-inner"
                  data-historical-mobile-cards="unadjusted"
                  aria-busy="true"
                ></div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>

    <!-- ======================================================================
         Derivatives Underlying (Single Stock Options)

         Not a tab. historical.rules.js shows this in place of the tabs
         entirely when the market/sector combination resolves to
         isDerivativeUnderlying. Kept as a sibling section, matching legacy.
         ====================================================================== -->

    <section
      id="historical-underlying-section"
      aria-labelledby="historical-underlying-title"
      hidden
    >
      <h2 class="visually-hidden" id="historical-underlying-title">
        <fmt:message key="derivatives.market.watch.sso" />
      </h2>

      <div class="data-view" data-historical-view="underlying">
        <div class="data-view__workspace">
          <div class="data-view__table">
            <div class="table-shell" data-table-shell>
              <section
                class="table-responsive custom-scrollbar"
                tabindex="0"
                role="region"
                aria-label="<fmt:message key='derivatives.market.watch.sso' />"
