<script>
	$(function() {

		var autoRefreshTimeInSec = 60;

		// initial call
		getTasiIndexValues();

		function getTasiIndexValues() {
			$.ajax({
						url : getMarketIndexUrl,
						type : 'GET',
						dataType : "json", // Note: jQuery 4 strictly handles data types and no longer promotes JSON to JSONP automatically
						success : function(response) {
							// jQuery 4 breaking change: $.parseJSON was removed. Use native JSON.parse()
							var jsonResponse = (typeof response === "string") ? JSON
									.parse(response)
									: response;

							var indexDivClass = "instrument-price__change"; // Default parent class
							var iconClass = "instrument-price__change-icon has-icon";

							if (jsonResponse.netChange > 0) {
								indexDivClass += " price-up";
								iconClass += " has-icon icon-trending-up";
							} else if (jsonResponse.netChange < 0) {
								indexDivClass += " price-down";
								iconClass += " has-icon icon-trending-down";
							} else {
								indexDivClass += " price-neutral";
							}

							$('.instrument-price__change').attr('class',
									indexDivClass);
							;

							$('.instrument-price__change-icon').attr('class',
									iconClass);

							$('#indexPrice').text(
									(jsonResponse.indexPrice).toLocaleString(
											undefined, {
												minimumFractionDigits : 2
											}));
							$('#indexNetChange').text(
									(jsonResponse.netChange).toLocaleString(
											undefined, {
												minimumFractionDigits : 2
											}));

							var percentChange = (jsonResponse.percentChange)
									.toLocaleString(undefined, {
										minimumFractionDigits : 2
									});
							if (!percentChange || percentChange == 0) {
								percentChange = '(-)';
							} else {
								percentChange = '(' + percentChange + '%)';
							}
							$('#indexPercentChange').text(percentChange);
							$('#indexPercentChange').text(percentChange);

							// This is for arealabels
							var accessibilityText = "TASI Index: "
									+ jsonResponse.indexPrice.toLocaleString()
									+ " points. "
									+ (jsonResponse.netChange >= 0 ? "Increased"
											: "Decreased")
									+ " by "
									+ Math.abs(jsonResponse.netChange)
											.toLocaleString() + " points, or "
									+ percentChange + ".";
							$('.instrument-price').attr('aria-label',
									accessibilityText);
						},
						complete : function() {
							setTimeout(function() {
								getTasiIndexValues();
							}, autoRefreshTimeInSec * 1000);
						}
					});
		}
	});
</script>