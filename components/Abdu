<script>
  window.HistoricalConfig = {
    /* ======================================================================
       Locale
       ====================================================================== */

    locale: "${requestScope.requestLocale}",

    /* ======================================================================
       Endpoints
       ====================================================================== */

    /*
     * "report" is shared by both the Performance and Unadjusted tabs.
     * historical.table.js differentiates them with the existing
     * tableTabId request parameter ("0" / "1"), exactly as legacy did.
     */
    endpoints: {
      report: "<portlet:resourceURL id='populateCompanyDetails'></portlet:resourceURL>",
      underlying: "<portlet:resourceURL id='getSingleStockOptionsTableCompanyData'></portlet:resourceURL>",
      sectors: "<portlet:resourceURL id='populateSectors'></portlet:resourceURL>",
      entities: "<portlet:resourceURL id='populateEntity'></portlet:resourceURL>"
    },

    /* ======================================================================
       Defaults
       ====================================================================== */

    /*
     * Raw request-scope values only. Fallback constants (INDICES / M /
     * M:TASI / OB) belong in historical.config.js, matching the
     * normalizeLabel(value, fallback) pattern market-watch.config.js uses.
     *
     * These same values also serve as the Reset target, matching legacy's
     * resetFilters() behavior exactly: reset returns to the page's initial
     * state, not to a hardcoded value.
     */
    defaults: {
      market: "${requestScope.selectedMarket}",
      sector: "${requestScope.selectedSector}",
      entity: "${requestScope.selectedEntity}",
      tradeType: "OB"
    },

    /* ======================================================================
       Constants
       ====================================================================== */

    constants: {
      marketsWithoutSector: ["ETFS", "MF", "TR"]
    },

    /* ======================================================================
       Table Options
       ====================================================================== */

    /*
     * Two blocks because Performance/Unadjusted and Underlying are
     * genuinely different DataTables integrations (server-side paged vs.
     * client-side single-shot), not just column-schema variants.
     */
    table: {
      report: {
        serverSide: true,
        paging: true,
        pagingType: "simple",
        pageLength: 100,
        searching: false,
        ordering: false,
