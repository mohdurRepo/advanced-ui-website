  /* ==========================================================================
     Mobile Card Reconciliation
     ========================================================================== */

  function renderActivityCards(
    type,
    items,
    {
      initial = false,
    } = {}
  ) {
    const container =
      document.querySelector(
        `[data-market-activity-cards="${type}"]`
      );

    if (!container) {
      return;
    }

    /* ------------------------------------------------------------------------
       Existing Cards
       ------------------------------------------------------------------------ */

    const existingCards =
      new Map(
        Array.from(
          container.querySelectorAll(
            ".data-card[data-market-symbol]"
          )
        ).map(
          (card) => [
            card.dataset
              .marketSymbol,

            card,
          ]
        )
      );

    /* ------------------------------------------------------------------------
       Remove Initial Skeleton Cards / Message
       ------------------------------------------------------------------------ */

    container
      .querySelectorAll(
        [
          ".data-card:not([data-market-symbol])",
          ".data-view__empty",
        ].join(", ")
      )
      .forEach(
        (element) => {
          element.remove();
        }
      );

    const visibleSymbols =
      new Set();

    /* ------------------------------------------------------------------------
       Create / Update / Reorder
       ------------------------------------------------------------------------ */

    items.forEach(
      (item) => {
        visibleSymbols.add(
          item.symbol
        );

        let card =
          existingCards.get(
            item.symbol
          );

        const isNew =
          !card;

        if (!card) {
          card =
            createActivityCard(
              type,
              item
            );
        }

        updateActivityCard(
          card,
          type,
          item,
          {
            initial:
              initial ||
              isNew,
          }
        );

        /*
         * appendChild() moves existing cards into the
         * latest backend order without rebuilding them.
         */

        container.appendChild(
          card
        );
      }
    );

    /* ------------------------------------------------------------------------
       Remove Securities No Longer Returned
       ------------------------------------------------------------------------ */

    existingCards.forEach(
      (
        card,
        symbol
      ) => {
        if (
          !visibleSymbols.has(
            symbol
          )
        ) {
          card.remove();
        }
      }
    );
  }

