                  data-historical-table="underlying"
                  aria-busy="true"
                >
                  <caption class="visually-hidden">
                    <fmt:message key="derivatives.market.watch.sso" />
                  </caption>

                  <thead>
                    <tr></tr>
                  </thead>

                  <tbody></tbody>
                </table>
              </section>

              <button
                type="button"
                class="table-scroll-jump has-icon icon-chevron-right-bold icon-md icon-flip-rtl"
                data-table-scroll-jump
                data-table-scroll-direction="end"
                aria-label="Jump to last columns"
                title="Jump to last columns"
                hidden
              >
                <span class="visually-hidden">Jump to last columns</span>
              </button>
            </div>
          </div>

          <div class="data-view__cards" data-historical-mobile="underlying">
            <div
              class="data-view__cards-inner"
              data-historical-mobile-cards="underlying"
              aria-busy="true"
            ></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         Notes
         ====================================================================== -->

    <div
      class="alert alert-info mt-6"
      id="historical-note"
      data-historical-note="default"
      role="note"
      hidden
    >
      <p id="historical-note-text" data-historical-note-text></p>
    </div>

    <div
      class="alert alert-info mt-6"
      id="historical-note-derivatives"
      data-historical-note="derivatives"
      role="note"
      hidden
    >
      <p id="historical-note-derivatives-text" data-historical-note-text></p>
    </div>

    <!-- ======================================================================
         Empty / Invalid / No-data Placeholder
         ====================================================================== -->

    <section
      id="historical-empty-state"
      class="text-center py-8"
      hidden
    >
      <img
        id="historical-empty-image"
        src="${pageContext.request.contextPath}/images/no-data.png"
        class="w-100"
        style="max-width: 300px; margin-inline: auto;"
        alt=""
        hidden
      />

      <p
        id="historical-placeholder-message"
        class="text-muted mt-4"
        data-historical-placeholder-message
      ></p>
    </section>

    <!-- ======================================================================
         Pagination
         ====================================================================== -->

    <div class="data-view__pagination" data-historical-pagination hidden>
      <div class="data-view__pagination-range" data-feed-range>0–0</div>

      <div class="data-view__pagination-controls">
        <span class="text-muted"><fmt:message key="pagination.page" /></span>

        <div class="custom-select custom-select--sm" data-custom-select>
          <div class="form-select-wrap custom-select__fallback">
            <select
              class="form-select form-select-sm custom-select__native"
              data-feed-page
              aria-label="<fmt:message key='pagination.page' />"
            ></select>

            <span
              class="form-select-icon has-icon icon-chevron-down"
              aria-hidden="true"
            ></span>
          </div>
        </div>

        <span class="text-muted">
          <fmt:message key="pagination.of" />
          <strong data-feed-total-pages>1</strong>
        </span>

        <button
          type="button"
          class="btn btn-outline-primary btn-icon"
          data-feed-prev
          disabled
          aria-label="<fmt:message key='pagination.previous' />"
        >
          <span
            class="has-icon icon-chevron-left icon-flip-rtl"
            aria-hidden="true"
          ></span>
        </button>

        <button
          type="button"
          class="btn btn-outline-primary btn-icon"
          data-feed-next
          disabled
          aria-label="<fmt:message key='pagination.next' />"
        >
          <span
            class="has-icon icon-chevron-right icon-flip-rtl"
            aria-hidden="true"
          ></span>
        </button>
      </div>
    </div>
  </div>
</section>
