        hideDetails: "<fmt:message key='historical.mobile.hide.details' />"
      },

      /* --------------------------------------------------------------------
         Table Columns
         -------------------------------------------------------------------- */

      table: {
        date: "<fmt:message key='table.header.date' />",
        open: "<fmt:message key='table.header.open' />",
        high: "<fmt:message key='table.header.high' />",
        low: "<fmt:message key='table.header.low' />",
        close: "<fmt:message key='table.header.close' />",
        change: "<fmt:message key='table.header.change' />",
