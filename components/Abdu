<section class="app-container hero-banner-section historical-reports">
	<div class="profile-banner">
		<div class="profile-banner--pattern">



			<div class="row">
				<div class="col-12">
					<h2>
						<svg class="pc-icon pr-3 link-icon" width="40" height="40">
                            <use xlink:href="#tadawul-arrow-icon"></use>
                        </svg>

						<label><fmt:message key="page.header" /> </label>
					</h2>
				</div>
			</div>

			<section class="banner-filters historical-filters is-active"
				data-filters>
				<div class="banner-filters__group is-active">
					<div class="row g-3">

						<!-- ===================== MARKET ===================== -->
						<div class="col-12 col-md-3 col-sm-6">
							<label class="form-label"> <fmt:message
									key="market.title" />
							</label>

							<div class="form-control-shell is-select" data-select
								data-field="market">

								<div class="form-select-value"></div>

								<input type="hidden" id="marketOrIndices"
									name="<%=HistoricalReportConstants.SELECTED_MARKET%>"
									data-filter="market" value="${requestScope.selectedMarket}" />

								<span class="form-suffix form-select-arrow"></span>

								<div class="form-popover">
									<div class="form-select-panel">
										<div class="form-select-list">

											<div class="form-select-option" data-value="-1">
												<fmt:message key="market.default.value" />
											</div>

											<c:forEach items="${requestScope.marketIndicesList}"
												var="item">
												<div class="form-select-option" data-value="${item.value}"
													${item.value == requestScope.selectedMarket ? 'data-selected="true"' : ''}>
													${item.text}</div>
											</c:forEach>

										</div>
									</div>
								</div>

							</div>
						</div>

						<!-- ===================== SECTOR ===================== -->
						<div class="col-12 col-md-3 col-sm-6">
							<label class="form-label"> <fmt:message
									key="sector.title" />
							</label>

							<div class="form-control-shell is-select" data-select
								data-field="sector">

								<div class="form-select-value"></div>

								<input type="hidden" id="sectors"
									name="<%=HistoricalReportConstants.SELECTED_SECTOR%>"
									data-filter="sector" value="${requestScope.selectedSector}" />

								<span class="form-suffix form-select-arrow"></span>

								<div class="form-popover">
									<div class="form-select-panel">
										<div class="form-select-list">

											<div class="form-select-option" data-value="0">
												<fmt:message key="sector.default.value" />
											</div>

											<c:forEach items="${requestScope.sectorList}" var="item">
												<div class="form-select-option"
													data-value="${item.dropdownValue}"
													${item.dropdownValue == requestScope.selectedSector ? 'data-selected="true"' : ''}>
													${item.name}</div>
											</c:forEach>

										</div>
									</div>
								</div>

							</div>
						</div>

						<!-- ===================== ENTITY ===================== -->
						<div class="col-12 col-md-3 col-sm-6">
							<label class="form-label"> <fmt:message
									key="entity.title" />
							</label>

							<div class="form-control-shell is-select" data-select
								data-field="entity">

								<div class="form-select-value"></div>

								<input type="hidden" id="entity"
									name="<%=HistoricalReportConstants.SELECTED_ENTITY%>"
									data-filter="entity" value="${requestScope.selectedEntity}" />

								<span class="form-suffix form-select-arrow"></span>

								<div class="form-popover">
									<div class="form-select-panel">
										<div class="form-select-list">

											<div class="form-select-option" data-value="0">
												<fmt:message key="entity.default.value" />
											</div>

											<c:forEach items="${requestScope.entityList}" var="item">
												<div class="form-select-option"
													data-value="${item.entitySymbol}"
													${item.entitySymbol == requestScope.selectedEntity ? 'data-selected="true"' : ''}>
													${item.entityName}</div>
											</c:forEach>

										</div>
									</div>
								</div>

							</div>
						</div>

						<!-- ===================== TRADE TYPE ===================== -->
						<div class="col-12 col-md-3 col-sm-6" id="tradeTypeFilter" hidden>
							<label class="form-label"> <fmt:message key="trade.title" />
							</label>

							<div class="form-control-shell is-select" data-select
								data-field="tradeType">

								<div class="form-select-value"></div>

								<input type="hidden" id="typeOfTrade"
									name="<%=HistoricalReportConstants.SELECTED_TYPE_OF_TRADE%>"
									data-filter="tradeType" value="OB" /> <span
									class="form-suffix form-select-arrow"></span>

								<div class="form-popover">
									<div class="form-select-panel">
										<div class="form-select-list">

											<div class="form-select-option" data-value="OB"
												data-selected="true">
												<fmt:message key="type.of.trade.option.1" />
											</div>

											<div class="form-select-option" data-value="OTC">
												<fmt:message key="type.of.trade.option.2" />
											</div>

											<div class="form-select-option" data-value="ND">
												<fmt:message key="type.of.trade.option.3" />
											</div>

										</div>
									</div>
								</div>

							</div>
						</div>

						<!-- ===================== DATE RANGE ===================== -->
						<div class="col-12 col-md-3 col-sm-6">

							<label class="form-label"> <fmt:message key="filter.date" />
							</label>
							<div class="form-control-shell form-date-range is-date"
								data-date-range>

								<input type="text" class="form-date-input" readonly
									data-date-start data-filter="startDate" /> <span
									class="form-date-range-separator" aria-hidden="true">-</span> <input
									type="text" class="form-date-input" readonly data-date-end
									data-filter="endDate" /> <span
									class="form-suffix form-date-icon"></span>
							</div>
						</div>
					</div>
					<div id="historicalFilterMessage" class="historical-filter-message"
						hidden></div>

				</div>
				<div class="row">
					<div class="col-12 col-lg-12 col-md-12 col-sm-12 mt-3">
						<div class="d-flex justify-content-lg-end align-items-end">
							<button id="historicalResetBtn" type="button"
								class="se-btn se-btn--banner">
								<span> <fmt:message key="reset.btn.title" />
								</span> <span
									class="se-btn__icon se-btn__icon--refresh se-icon icon-custom-refresh-cycle icon-md"></span>
							</button>
						</div>
					</div>
				</div>


			</section>
		</div>
	</div>

	<!-- ========================================
         CONTENT AREA
    ======================================== -->

	<div class="intro-section">
		<section class="app-container mt-5">
			<section class="tabs-container" data-tabs>
				<div class="tabs" role="tablist">
					<button class="tabs__item is-active" role="tab"
						data-tab="performance" aria-selected="true">
						<fmt:message key="performance.tab.title" />
					</button>
					<button class="tabs__item" role="tab" data-tab="unadjusted"
						aria-selected="false" tabindex="-1">
						<fmt:message key="unadjust.price.tab.title" />
					</button>
					<span class="tabs__underline"></span>
				</div>
			</section>

			<!-- ========================================
  PLACEHOLDER
  ======================================== -->

			<section id="historical-empty-state" class="tab-content__panel"
				hidden>
				<div class="historical-placeholder">
					<img id="historical-empty-image" src="${pageContext.request.contextPath}/images/no-data.png"
						style="width: 300px; place-self: center;" hidden />

					<div id="historical-placeholder-message"
						class="historical-placeholder__message text-center"></div>
				</div>
			</section>

			<!-- ========================================
  TABLES
  ======================================== -->

			<section id="historical-content" class="tab-content">

				<!-- PERFORMANCE -->
				<section id="historical-panel-performance"
					class="tab-content__panel is-active">

					<table id="perfSummary" class="table" data-dt>
						<thead>
							<tr></tr>
						</thead>
						<tbody></tbody>
					</table>

				</section>

				<!-- UNADJUSTED -->
				<section id="historical-panel-unadjusted" class="tab-content__panel">

					<table id="unadjustedPrice" class="table" data-dt>
						<thead>
							<tr></tr>
						</thead>
						<tbody></tbody>
					</table>

				</section>

				<!-- DERIVATIVES -->
				<section id="SingleStockOptionsDiv" hidden>
					<table id="SingleStockOptionsTable" class="table" data-dt>
						<thead>
							<tr></tr>
						</thead>
						<tbody></tbody>
					</table>
				</section>
			</section>

			<!-- ========================================
  PAGINATION
  ======================================== -->

			<div class="feed__pagination">
				<div class="feed__page-range" data-feed-range>0–0 of 0</div>
				<div class="feed__page-controls">

					<span class="feed__page-label">Page</span> <select
						class="feed__select" data-feed-page></select> <span>of <strong
						data-feed-total-pages>1</strong></span>

					<button class="feed__page-btn" data-feed-prev disabled
						aria-label="Previous page">
						<span class="se-icon icon-md icon-arrow" aria-hidden="true"></span>
					</button>
					<button class="feed__page-btn" data-feed-next disabled
						aria-label="Next page">
						<span class="se-icon icon-md icon-arrow" aria-hidden="true"></span>
					</button>
				</div>

			</div>
		</section>
	</div>


</section>

<script>
 
window.HistoricalConfig = {
    requestLocale: "${requestScope.requestLocale}",
 
    defaults: {
      market: "${requestScope.selectedMarket}",
      sector: "${requestScope.selectedSector}",
      entity: "${requestScope.selectedEntity}",
      tradeType: "OB"
    },
 
    constants: {
      MARKETS_WITHOUT_SECTOR: ["ETFS", "MF", "TR"]
    }
  };
 
 
/* =========================================================
 ENDPOINTS
 ========================================================= */
 
 window.HistoricalEndpoints = {
    populateCompanyDetails: "<portlet:resourceURL id='populateCompanyDetails'/>",
    populateSectors: "<portlet:resourceURL id='populateSectors'/>",
    populateEntity: "<portlet:resourceURL id='populateEntity'/>",
    getSingleStockOptionsTableCompanyData:
      "<portlet:resourceURL id='getSingleStockOptionsTableCompanyData'/>"
  };
 
/* =========================================================
 I18N STRINGS (SAFE FOR JS)
 Avoid injecting JSP tags inside JS logic later
 ========================================================= */
 
window.HistoricalI18n = {
    sectorPlaceholder: "<fmt:message key='sector.default.value'/>",
    entityPlaceholder: "<fmt:message key='entity.default.value'/>",
    marketPlaceholder: "<fmt:message key='market.default.value'/>",
 
    validationMarket: "<fmt:message key='market.validation.message'/>",
    validationSector: "<fmt:message key='sector.validation.message'/>",
    validationEntity: "<fmt:message key='entity.validation.message'/>",
    validationDateRange: "<fmt:message key='date.validation.message'/>",
    validationDateOrder: "<fmt:message key='date.order.validation.message'/>",
	placeholderSelectFilters:
	    "<fmt:message key='historical.placeholder.select.filters'/>",
	 
	noDataMessage:
	    "<fmt:message key='historical.placeholder.no.data'/>",
 
    labels: {
      "table.header.date": "<fmt:message key='table.header.date'/>",
      "table.header.open": "<fmt:message key='table.header.open'/>",
      "table.header.high": "<fmt:message key='table.header.high'/>",
      "table.header.low": "<fmt:message key='table.header.low'/>",
      "table.header.close": "<fmt:message key='table.header.close'/>",
      "table.header.change": "<fmt:message key='table.header.change'/>",
      "table.header.change.points": "<fmt:message key='table.header.change.points'/>",
      "table.header.percnt.change": "<fmt:message key='table.header.percnt.change'/>",
      "table.header.volume.traded": "<fmt:message key='table.header.volume.traded'/>",
      "table.header.nominal.value.traded": "<fmt:message key='table.header.nominal.value.traded'/>",
      "table.header.turn.over": "<fmt:message key='table.header.turn.over'/>",
      "table.header.no.of.trades": "<fmt:message key='table.header.no.of.trades'/>",
      "table.header.nav": "<fmt:message key='table.header.nav'/>",
      "table.header.close.yeild": "<fmt:message key='table.header.close.yeild'/>",
      "table.header.mf.date": "<fmt:message key='table.header.mf.date'/>",
      "table.header.mf.nav": "<fmt:message key='table.header.mf.nav'/>",
      "table.header.daily.sett.price": "<fmt:message key='table.header.daily.sett.price'/>",
      "table.header.open.interest": "<fmt:message key='table.header.open.interest'/>",
 
      "derivatives.market.watch.underlying.table.instrumenttype":
        "<fmt:message key='derivatives.market.watch.underlying.table.instrumenttype'/>",
      "derivatives.market.watch.underlying.table.symbol":
        "<fmt:message key='derivatives.market.watch.underlying.table.symbol'/>",
      "derivatives.market.watch.underlying.table.Underlying":
        "<fmt:message key='derivatives.market.watch.underlying.table.Underlying'/>",
      "derivatives.market.watch.underlying.table.ExpiryDate":
        "<fmt:message key='derivatives.market.watch.underlying.table.ExpiryDate'/>",
      "derivatives.market.watch.underlying.table.Type":
        "<fmt:message key='derivatives.market.watch.underlying.table.Type'/>",
      "derivatives.market.watch.underlying.table.StrikePrice":
        "<fmt:message key='derivatives.market.watch.underlying.table.StrikePrice'/>",
      "derivatives.market.watch.underlying.table.ReferencePrice":
        "<fmt:message key='derivatives.market.watch.underlying.table.ReferencePrice'/>",
      "derivatives.market.watch.underlying.table.LastTradedPrice":
        "<fmt:message key='derivatives.market.watch.underlying.table.LastTradedPrice'/>",
      "derivatives.market.watch.underlying.table.Volume":
        "<fmt:message key='derivatives.market.watch.underlying.table.Volume'/>",
      "derivatives.market.watch.underlying.table.OpenInterest":
        "<fmt:message key='derivatives.market.watch.underlying.table.OpenInterest'/>",
      "derivatives.market.watch.underlying.table.UnderlyingPrice":
        "<fmt:message key='derivatives.market.watch.underlying.table.UnderlyingPrice'/>",
        "labels.company.profile.options.table.calls":
		  "<fmt:message key='labels.company.profile.options.table.calls'/>",
		"labels.company.profile.options.table.puts":
		  "<fmt:message key='labels.company.profile.options.table.puts'/>",
		"derivatives.market.watch.sso":
		  "<fmt:message key='derivatives.market.watch.sso'/>",
		  "table.header.aum": "AUM",
    }
  };
 
 
/* =========================================================
 DROPDOWN CONFIGURATION
 (Single source of truth for dependencies)
 ========================================================= */
 
window.DROPDOWN_CONFIG = {
    market: {
      init: true,
 
      targets: [
        {
          field: "sector",
          url: window.HistoricalEndpoints.populateSectors,
          method: "GET",
 
          params: function (marketValue, sourceShell) {
            const disabled =
              window.HistoricalConfig.constants.MARKETS_WITHOUT_SECTOR.includes(
                marketValue
              );
 
            const scope = sourceShell.closest("[data-filters]");
            const sectorShell = scope?.querySelector('[data-field="sector"]');
 
            if (sectorShell) {
              sectorShell.classList.toggle("is-disabled", disabled);
              sectorShell.setAttribute(
                "aria-disabled",
                disabled ? "true" : "false"
              );
            }
 
            if (disabled) return false;
 
            return {
              selectedMarket: marketValue
            };
          },
 
          map: function (item) {
            if (!item) return null;
 
            return {
              value: item.dropdownValue || "0",
              label: item.name || "-"
            };
          },
 
          placeholder: function () {
            return window.HistoricalI18n.sectorPlaceholder;
          }
        },
 
        {
          field: "entity",
          url: window.HistoricalEndpoints.populateEntity,
          method: "GET",
 
          params: function (marketValue) {
            return {
              selectedMarket: marketValue,
              selectedSector: "0"
            };
          },
 
          map: function (item) {
            if (!item) return null;
 
            return {
              value: item.entitySymbol || "0",
              label: item.entityName || "-"
            };
          },
 
          placeholder: function () {
            return window.HistoricalI18n.entityPlaceholder;
          }
        }
      ]
    },
 
    sector: {
      targets: [
        {
          field: "entity",
          url: window.HistoricalEndpoints.populateEntity,
          method: "GET",
 
          params: function (sectorValue) {
            const market =
              document.querySelector('[data-filter="market"]')?.value || "0";
 
            return {
              selectedMarket: market,
              selectedSector: sectorValue || "0"
            };
          },
 
          map: function (item) {
            if (!item) return null;
 
            return {
              value: item.entitySymbol || "0",
              label: item.entityName || "-"
            };
          },
 
          placeholder: function () {
            return window.HistoricalI18n.entityPlaceholder;
          }
        }
      ]
    }
  };
</script>

<script src="${pageContext.request.contextPath}/js/tabs.controller.js"></script>
<script src="${pageContext.request.contextPath}/js/dropdown-update.js"></script>
<script src="${pageContext.request.contextPath}/js/historical.rules.js"></script>
<script
	src="${pageContext.request.contextPath}/js/historical.columns.js"></script>
<script
	src="${pageContext.request.contextPath}/js/historical.table.profiles.js"></script>
<script
	src="${pageContext.request.contextPath}/js/historical.table.engine.js"></script>
<script
	src="${pageContext.request.contextPath}/js/historical.feature.manager.js"></script>
