    );

  const LOGO_BASE_URL =
    LOGOS.baseUrl ||
    "https://www.tadawulgroup.sa/Resources/SEMOBILELOGOS/";

  const FALLBACK_LOGO_URL =
    LOGOS.fallbackUrl ||
    `${LOGO_BASE_URL}default-Logo.png`;

  /* ==========================================================================
     Selectors
     ========================================================================== */

  const SELECTORS = {
    form:
      "#issuer-directory-filter-form",

    symbol:
      "#symbol_filter",

    market:
      "#Market_ti",

    sector:
      "#sectors_list",

    letterInput:
      "#letterId",

    alphabet:
      "[data-directory-alphabet]",

    results:
      "[data-directory-results]",

    resultCount:
      "#res-count",

    grid:
      "#issuer-directory-grid",

    list:
      "#issuer-directory-list",

    group:
      "[data-directory-group]",

    resultItem:
      ".directory-results__item",

    empty:
      "[data-directory-empty]",

    liveStatus:
      "[data-directory-live-status]",

    pagination:
      "[data-directory-pagination]",

    paginationList:
      "#pagination-ul",

    range:
      "[data-directory-range]",

    total:
      "[data-directory-total]",

    paginationRange:
      "[data-directory-pagination-range]",

    paginationTotal:
      "[data-directory-pagination-total]",

    pageLimit:
      "#pageLimitId",

    pageCount:
      "#recordsCountId",

    logo:
      "[data-issuer-logo]",
  };

  /* ==========================================================================
     Events
     ========================================================================== */

  const EVENTS = {
    alphabetChange:
      "directory:alphabet-change",
  };

  /* ==========================================================================
     State
     ========================================================================== */

  const state = {
    companies: [],

    currentPage: 1,

    companyRequest: null,
    sectorRequest: null,

    initialSectorOptions: [],

    /*
     * Rendering:
     *
     * backend Arabic alias -> displayed Arabic letter
     */
    arabicAliasToLetter:
      new Map(),

    /*
     * Backend request:
     *
     * displayed Arabic letter -> backend aliases[]
     */
    arabicLetterToAliases:
      new Map(),

    /*
     * Legacy distinction:
     *
     * Explicit All alphabet click:
     *   letter = "All"
     *
     * Reset / market / sector / symbol:
     *   letter = ""
     */
    backendLetterOverride: null,

    suppressSectorChange: false,
    resetting: false,
    initialized: false,
  };

  /* ==========================================================================
     Initialization
     ========================================================================== */

  function initIssuerDirectory() {
    if (state.initialized) {
      return;
    }

    const form =
      document.querySelector(
        SELECTORS.form,
      );

    if (
      !(
        form instanceof
        HTMLFormElement
      )
    ) {
      return;
    }

    state.initialized = true;

    captureInitialSectorOptions();
    buildArabicCharacterMaps();
    bindEvents();

    /*
     * Legacy behavior:
     * load companies immediately.
     */
    loadCompanies();
  }

  /* ==========================================================================
     Event Binding
     ========================================================================== */

  function bindEvents() {
    const form =
      document.querySelector(
        SELECTORS.form,
      );

    const symbol =
      document.querySelector(
        SELECTORS.symbol,
      );

    const market =
      document.querySelector(
        SELECTORS.market,
      );

    const sector =
      document.querySelector(
        SELECTORS.sector,
      );

    const paginationList =
      document.querySelector(
        SELECTORS.paginationList,
      );

    if (
      !(
        form instanceof
        HTMLFormElement
      )
    ) {
      return;
    }

    form.addEventListener(
      "submit",
      handleFormSubmit,
    );

    if (
      symbol instanceof
      HTMLInputElement
    ) {
      symbol.addEventListener(
        "input",
        debounce(
          handleSymbolChange,
          500,
        ),
      );
    }

    if (
      market instanceof
      HTMLSelectElement
    ) {
      market.addEventListener(
        "change",
        handleMarketChange,
      );
    }

    if (
      sector instanceof
      HTMLSelectElement
    ) {
      sector.addEventListener(
        "change",
        handleSectorChange,
      );
    }

    form.addEventListener(
      "reset",
      handleFormReset,
    );

    document.addEventListener(
      EVENTS.alphabetChange,
      handleAlphabetChange,
    );

    if (
      paginationList instanceof
      HTMLElement
    ) {
      paginationList.addEventListener(
        "click",
        handlePaginationClick,
      );
    }

    document.addEventListener(
      "error",
      handleImageError,
      true,
    );
  }

  /* ==========================================================================
     Form Submit
     ========================================================================== */

  function handleFormSubmit(
    event,
  ) {
    event.preventDefault();

    resetAlphabet();

    loadCompanies();
  }

  /* ==========================================================================
     Symbol Search
     ========================================================================== */

  function handleSymbolChange() {
    resetAlphabet();

    loadCompanies();
  }

  /* ==========================================================================
     Market Change
     ========================================================================== */

  function handleMarketChange(
    event,
  ) {
    resetAlphabet();

    /*
     * Prevent an older company request from rendering
     * while sectors for the new market are loading.
     */
    abortCompanyRequest();

    const marketType =
      event.currentTarget.value ||
      "";

    loadSectorsByMarket(
      marketType,
    );
  }

  /* ==========================================================================
     Sector Change
     ========================================================================== */

  function handleSectorChange() {
    if (
      state.suppressSectorChange
    ) {
      return;
    }

    resetAlphabet();

    loadCompanies();
  }

  /* ==========================================================================
     Form Reset
     ========================================================================== */

  function handleFormReset() {
    state.resetting = true;

    state.backendLetterOverride =
      null;

    abortSectorRequest();
    abortCompanyRequest();

    /*
     * Native form reset values are applied after
     * the reset event.
     */
    window.requestAnimationFrame(
      () => {
        restoreInitialSectorOptions();

        state.currentPage = 1;

        refreshDirectory();

        loadCompanies();

        /*
         * DirectoryAlphabet also handles the same
         * form reset in requestAnimationFrame().
         *
         * Keep the alphabet-change handler suppressed
         * until that work has completed.
         */
        window.requestAnimationFrame(
          () => {
            state.resetting =
              false;
          },
        );
      },
    );
  }

  /* ==========================================================================
     Alphabet Change
     ========================================================================== */

  function handleAlphabetChange(
    event,
  ) {
    if (state.resetting) {
      return;
    }

    const alphabet =
      event.target;

    const form =
      document.querySelector(
        SELECTORS.form,
      );

    if (
      !(
        alphabet instanceof
        Element
      ) ||
      !alphabet.matches(
        SELECTORS.alphabet,
      ) ||
      !(
        form instanceof
        HTMLFormElement
      ) ||
      !form.contains(
        alphabet,
      )
    ) {
      return;
    }

    /*
     * DirectoryAlphabet owns:
     *
     * - active state
     * - aria-pressed
     * - keyboard navigation
     * - hidden #letterId
     *
     * This controller owns the backend request.
     */
    const selectedLetter =
      event.detail &&
      typeof event.detail
        .letter === "string"
        ? event.detail.letter
        : getControlValue(
            SELECTORS.letterInput,
          );

    /*
     * Legacy behavior:
     *
     * Explicit All alphabet click:
     *
     * letter = "All"
     *
     * Resets:
     *
     * letter = ""
     */
    state.backendLetterOverride =
      selectedLetter === ""
        ? "All"
        : null;

    state.currentPage = 1;

    loadCompanies();
  }

  /* ==========================================================================
     Alphabet Reset
     ========================================================================== */

  function resetAlphabet() {
    const letterInput =
      document.querySelector(
        SELECTORS.letterInput,
      );

    state.backendLetterOverride =
      null;

    state.currentPage = 1;

    if (
      letterInput instanceof
      HTMLInputElement
    ) {
      letterInput.value = "";
    }

    /*
     * DirectoryAlphabet refresh() does not dispatch
     * another alphabet-change event.
     */
    refreshDirectory();
  }

  /* ==========================================================================
     Arabic Character Mapping
     ========================================================================== */

  function buildArabicCharacterMaps() {
    state.arabicAliasToLetter.clear();

    state.arabicLetterToAliases.clear();

    const mapping =
      String(
        CONFIG
          .arabicCharactersMapping ||
          "",
      ).trim();

    if (!mapping) {
      return;
    }

    mapping
      .split(",")
      .map(
        (entry) =>
          entry.trim(),
      )
      .filter(Boolean)
      .forEach((entry) => {
        const separatorIndex =
          entry.indexOf("-");

        if (
          separatorIndex === -1
        ) {
          return;
        }

        const displayLetter =
          normalizeLetter(
            entry.slice(
              0,
              separatorIndex,
            ),
          );

        const alias =
          normalizeLetter(
            entry.slice(
              separatorIndex + 1,
            ),
          );

        if (
          !displayLetter ||
          !alias
        ) {
          return;
        }

        /*
         * Backend request mapping:
         *
         * displayed letter -> aliases[]
         */
        if (
          !state
            .arabicLetterToAliases
            .has(displayLetter)
        ) {
          state
            .arabicLetterToAliases
            .set(
              displayLetter,
              [],
            );
        }

        const aliases =
          state
            .arabicLetterToAliases
            .get(
              displayLetter,
            );

        if (
          !aliases.includes(alias)
        ) {
          aliases.push(alias);
        }

        /*
         * Rendering mapping:
         *
         * alias -> displayed letter
         */
        state
          .arabicAliasToLetter
          .set(
            displayLetter,
            displayLetter,
          );

        state
          .arabicAliasToLetter
          .set(
            alias,
            displayLetter,
          );
      });
  }

  /* ==========================================================================
     Backend Alphabet Value
     ========================================================================== */

  function getBackendLetter() {
    if (
      state
        .backendLetterOverride !==
      null
    ) {
      return state
        .backendLetterOverride;
    }

    const selectedLetter =
      getControlValue(
        SELECTORS.letterInput,
      );

    if (!selectedLetter) {
      return "";
    }

    /*
     * Legacy Arabic behavior:
     *
     * arabicMap[letter] + ""
     *
     * Array#toString joins values with commas.
     */
    if (
      String(
        CONFIG.locale ||
          "",
      ).toLowerCase() ===
      "ar"
    ) {
      const normalizedLetter =
        normalizeLetter(
          selectedLetter,
        );

      const aliases =
        state
          .arabicLetterToAliases
          .get(
            normalizedLetter,
          );

      if (
        aliases &&
        aliases.length
      ) {
        return aliases.join(",");
      }
    }

    return selectedLetter;
  }

  function normalizeLetter(
    value,
  ) {
    return String(
      value || "",
    )
      .trim()
      .toLocaleUpperCase();
  }

  /* ==========================================================================
     Initial Sector Options
     ========================================================================== */

  function captureInitialSectorOptions() {
    const select =
      document.querySelector(
        SELECTORS.sector,
      );

    if (
      !(
        select instanceof
        HTMLSelectElement
      )
    ) {
      return;
    }

    state.initialSectorOptions =
      Array.from(
        select.options,
      ).map(
        (option) => ({
          value:
            option.value,

          text:
            option.text,

          selected:
            option
              .defaultSelected,
        }),
      );
  }

  /* ==========================================================================
     Restore Initial Sector Options
     ========================================================================== */

  function restoreInitialSectorOptions() {
    const select =
      document.querySelector(
        SELECTORS.sector,
      );

    if (
      !(
        select instanceof
        HTMLSelectElement
      )
    ) {
      return;
    }

    replaceSelectOptions(
      select,
      state.initialSectorOptions,
    );

    select.value = "All";

    notifySelectChanged(
      select,
    );
  }

  /* ==========================================================================
     Market -> Sector AJAX
     ========================================================================== */

  async function loadSectorsByMarket(
    marketType,
  ) {
    const sectorSelect =
      document.querySelector(
        SELECTORS.sector,
      );

    if (
      !(
        sectorSelect instanceof
        HTMLSelectElement
      )
    ) {
      await loadCompanies();

      return;
    }

    abortSectorRequest();

    /*
     * Default / all markets.
     */
    if (!marketType) {
      restoreInitialSectorOptions();

      await loadCompanies();

      return;
    }

    if (
      !URLS.sectorsByMarket
    ) {
      console.error(
        "IssuerDirectory: sectorsByMarket URL is missing.",
      );

      return;
    }

    const controller =
      new AbortController();

    state.sectorRequest =
      controller;

    sectorSelect.disabled =
      true;

    try {
      const response =
        await postForm(
          URLS.sectorsByMarket,
          {
            format:
              "json",

            marketType,
          },
          controller.signal,
        );

      if (
        state.sectorRequest !==
        controller
      ) {
        return;
      }

      const sectors =
        Array.isArray(response)
          ? response
          : response &&
              Array.isArray(
                response.data,
              )
            ? response.data
            : [];

      const options = [
        {
          value:
            "All",

          text:
            LABELS.allSectors ||
            "All Sectors",

          selected:
            true,
        },
      ];

      sectors.forEach(
        (sector) => {
          if (!sector) {
            return;
          }

          options.push({
            value:
              sector
                .pk_rf_sector !=
              null
                ? sector
                    .pk_rf_sector
                : "",

            text:
              sector.name !=
              null
                ? sector.name
                : "",

            selected:
              false,
          });
        },
      );

      replaceSelectOptions(
        sectorSelect,
        options,
      );

      sectorSelect.value =
        "All";

      notifySelectChanged(
        sectorSelect,
      );

      /*
       * Legacy flow:
       *
       * market
       *   -> sectors
       *   -> companies
       */
      await loadCompanies();
    } catch (error) {
      if (
        error &&
        error.name ===
          "AbortError"
      ) {
        return;
      }

      console.error(
        "IssuerDirectory: unable to load sectors.",
        error,
      );
    } finally {
      if (
        state.sectorRequest ===
        controller
      ) {
        state.sectorRequest =
          null;

        sectorSelect.disabled =
          false;
      }
    }
  }

  function abortSectorRequest() {
    if (
      !state.sectorRequest
    ) {
      return;
    }

    state.sectorRequest.abort();

    state.sectorRequest =
      null;

    const sector =
      document.querySelector(
        SELECTORS.sector,
      );

    if (
      sector instanceof
      HTMLSelectElement
    ) {
      sector.disabled =
        false;
    }
  }

  /* ==========================================================================
     Company AJAX
     ========================================================================== */

  async function loadCompanies() {
    if (!URLS.companies) {
      console.error(
        "IssuerDirectory: companies URL is missing.",
      );

      return;
    }

    abortCompanyRequest();

    const controller =
      new AbortController();

    state.companyRequest =
      controller;

    setBusy(true);

    /*
     * Exact legacy backend contract.
     */
    const requestData = {
      marketType:
        getControlValue(
          SELECTORS.market,
        ),

      sector:
        getControlValue(
          SELECTORS.sector,
        ),

      symbol:
        getControlValue(
          SELECTORS.symbol,
        ),

      letter:
        getBackendLetter(),
    };

    try {
      const response =
        await postForm(
          URLS.companies,
          requestData,
          controller.signal,
        );

      if (
        state.companyRequest !==
        controller
      ) {
        return;
      }

      state.companies =
        response &&
        Array.isArray(
          response.data,
        )
          ? response.data
          : [];

      state.currentPage = 1;

      renderDirectory(
        state.companies,
      );

      /*
       * AJAX replaced the result groups.
       */
      refreshDirectory();

      /*
       * Pagination runs on the backend result set.
       */
      renderPage(1);
    } catch (error) {
      if (
        error &&
        error.name ===
          "AbortError"
      ) {
        return;
      }

      console.error(
        "IssuerDirectory: unable to load companies.",
        error,
      );

      state.companies = [];

      state.currentPage = 1;

      renderDirectory(
        state.companies,
      );

      refreshDirectory();

      renderPage(1);
    } finally {
      if (
        state.companyRequest ===
        controller
      ) {
        state.companyRequest =
          null;

        setBusy(false);
      }
    }
  }

  function abortCompanyRequest() {
    if (
      !state.companyRequest
    ) {
      return;
    }

    state.companyRequest.abort();

    state.companyRequest =
      null;
  }

  /* ==========================================================================
     POST Form Request
     ========================================================================== */

  async function postForm(
    url,
    data,
    signal,
  ) {
    const body =
      new URLSearchParams();

    Object.entries(data).forEach(
      ([key, value]) => {
        body.append(
          key,
          value == null
            ? ""
            : String(value),
        );
      },
    );

    const response =
      await fetch(
        url,
        {
          method:
            "POST",

          credentials:
            "same-origin",

          signal,

          headers: {
            "Content-Type":
              "application/x-www-form-urlencoded; charset=UTF-8",

            "X-Requested-With":
              "XMLHttpRequest",
          },

          body,
        },
      );

    if (!response.ok) {
      throw new Error(
        `HTTP ${response.status}`,
      );
    }

    const text =
      await response.text();

    return parseJsonResponse(
      text,
    );
  }

  /* ==========================================================================
     JSON Response
     ========================================================================== */

  function parseJsonResponse(
    value,
  ) {
    if (
      value === null ||
      value === undefined
    ) {
      return {};
    }

    if (
      typeof value ===
      "object"
    ) {
      return value;
    }

    const text =
      String(value).trim();

    if (!text) {
      return {};
    }

    try {
      const parsed =
        JSON.parse(text);

      /*
       * Tolerate accidentally double-encoded JSON.
       */
      if (
        typeof parsed ===
        "string"
      ) {
        try {
          return JSON.parse(
            parsed,
          );
        } catch {
          return parsed;
        }
      }

      return parsed;
    } catch (error) {
      console.error(
        "IssuerDirectory: invalid JSON response.",
        text,
      );

      throw error;
    }
  }

  /* ==========================================================================
     Directory Rendering
     ========================================================================== */

  function renderDirectory(
    companies,
  ) {
    const grid =
      document.querySelector(
        SELECTORS.grid,
      );

    const list =
      document.querySelector(
        SELECTORS.list,
      );

    if (
      !(
        grid instanceof
        HTMLElement
      ) ||
      !(
        list instanceof
        HTMLElement
      )
    ) {
      console.error(
        "IssuerDirectory: grid/list result panels are missing.",
      );

      return;
    }

    const groups =
      groupCompanies(
        companies,
      );

    grid.innerHTML =
      groups
        .map(
          (
            group,
            index,
          ) =>
            renderGridGroup(
              group,
              index,
            ),
        )
        .join("");

    list.innerHTML =
      groups
        .map(
          (
            group,
            index,
          ) =>
            renderListGroup(
              group,
              index,
            ),
        )
        .join("");
  }

  /* ==========================================================================
     Group Companies
     ========================================================================== */

  function groupCompanies(
    companies,
  ) {
    const groups =
      new Map();

    companies.forEach(
      (
        company,
        companyIndex,
      ) => {
        const letter =
          resolveCompanyLetter(
            company,
          );

        if (
          !groups.has(letter)
        ) {
          groups.set(
            letter,
            {
              letter,
              items: [],
            },
          );
        }

        groups
          .get(letter)
          .items
          .push({
            company,
            index:
              companyIndex,
          });
      },
    );

    return sortGroups(
      Array.from(
        groups.values(),
      ),
    );
  }

  /* ==========================================================================
     Group Sorting
     ========================================================================== */

  function sortGroups(
    groups,
  ) {
    const alphabetOrder =
      getAlphabetOrder();

    return groups.sort(
      (
        groupA,
        groupB,
      ) => {
        const indexA =
          alphabetOrder.indexOf(
            groupA.letter,
          );

        const indexB =
          alphabetOrder.indexOf(
            groupB.letter,
          );

        if (
          indexA !== -1 &&
          indexB !== -1
        ) {
          return (
            indexA -
            indexB
          );
        }

        if (
          indexA !== -1
        ) {
          return -1;
        }

        if (
          indexB !== -1
        ) {
          return 1;
        }

        return groupA.letter
          .localeCompare(
            groupB.letter,
            CONFIG.locale ||
              undefined,
          );
      },
    );
  }

  /* ==========================================================================
     Alphabet Order
     ========================================================================== */

  function getAlphabetOrder() {
    return Array.from(
      document.querySelectorAll(
        `${SELECTORS.alphabet} [data-directory-letter]`,
      ),
    )
      .map(
        (control) =>
          normalizeLetter(
            control.getAttribute(
              "data-directory-letter",
            ),
          ),
      )
      .filter(Boolean);
  }

  /* ==========================================================================
     Resolve Company Letter
     ========================================================================== */

  function resolveCompanyLetter(
    company,
  ) {
    const name =
      getCompanyName(
        company,
      );

    if (
      !name ||
      name === "—"
    ) {
      return "#";
    }

    const characters =
      Array.from(
        name.trim(),
      );

    if (
      !characters.length
    ) {
      return "#";
    }

    const firstCharacter =
      normalizeLetter(
        characters[0],
      );

    /*
     * Arabic aliases are normalized back to the
     * displayed alphabet character.
     */
    if (
      state
        .arabicAliasToLetter
        .has(
          firstCharacter,
        )
    ) {
      return state
        .arabicAliasToLetter
        .get(
          firstCharacter,
        );
    }

    return (
      firstCharacter ||
      "#"
    );
  }

