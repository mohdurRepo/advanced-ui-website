  /* ==========================================================================
     Price Movement
     ========================================================================== */

  function getMovement(
    value,
    baseClass,
  ) {
    const numericValue =
      Number.parseFloat(
        value,
      );

    if (
      !Number.isFinite(
        numericValue,
      )
    ) {
      return {
        className:
          `${baseClass} priceEqual`,

        text:
          "—",
      };
    }

    if (
      numericValue > 0
    ) {
      return {
        className:
          `${baseClass} price-up has-icon icon-triangle-up`,

        text:
          `+${numericValue.toFixed(2)}%`,
      };
    }

    if (
      numericValue < 0
    ) {
      return {
        className:
          `${baseClass} price-down has-icon icon-triangle-down`,

        text:
          `${numericValue.toFixed(2)}%`,
      };
    }

    return {
      className:
        `${baseClass} priceEqual`,

      text:
        `${numericValue.toFixed(2)}%`,
    };
  }

  /* ==========================================================================
     Pagination Click
     ========================================================================== */

  function handlePaginationClick(
    event,
  ) {
    const pageButton =
      event.target.closest(
        "[data-directory-page]",
      );

    if (pageButton) {
      const page =
        Number(
          pageButton.getAttribute(
            "data-directory-page",
          ),
        );

      if (
        Number.isInteger(
          page,
        )
      ) {
        renderPage(page);
      }

      return;
    }

    const previousButton =
      event.target.closest(
        "[data-directory-page-prev]",
      );

    if (previousButton) {
      if (
        state.currentPage >
        1
      ) {
        renderPage(
          state.currentPage -
            1,
        );
      }

      return;
    }

    const nextButton =
      event.target.closest(
        "[data-directory-page-next]",
      );

    if (!nextButton) {
      return;
    }

    const totalPages =
      getTotalPages(
        state.companies
          .length,
      );

    if (
      state.currentPage <
      totalPages
    ) {
      renderPage(
        state.currentPage +
          1,
      );
    }
  }

  /* ==========================================================================
     Pagination
     ========================================================================== */

  function renderPage(
    pageNumber,
  ) {
    const totalItems =
      state.companies.length;

    const totalPages =
      getTotalPages(
        totalItems,
      );

    if (
      totalPages === 0
    ) {
      state.currentPage =
        1;
    } else {
      state.currentPage =
        Math.max(
          1,
          Math.min(
            Number(
              pageNumber,
            ) || 1,
            totalPages,
          ),
        );
    }

    const startIndex =
      (
        state.currentPage -
        1
      ) *
      PAGE_SIZE;

    const endIndex =
      Math.min(
        startIndex +
          PAGE_SIZE,
        totalItems,
      );

    const visibleIndexes =
      new Set();

    for (
      let index =
        startIndex;
      index <
      endIndex;
      index += 1
    ) {
      visibleIndexes.add(
        index,
      );
    }

    applyPageVisibility(
      document.querySelector(
        SELECTORS.grid,
      ),
      visibleIndexes,
    );

    applyPageVisibility(
      document.querySelector(
        SELECTORS.list,
      ),
      visibleIndexes,
    );

    updateResultSummary({
      totalItems,

      startIndex,

      pageItemCount:
        Math.max(
          0,
          endIndex -
            startIndex,
        ),
    });

    renderPagination({
      currentPage:
        state.currentPage,

      totalPages,
    });

    updateEmptyState(
      totalItems === 0,
    );
  }

  /* ==========================================================================
     Total Pages
     ========================================================================== */

  function getTotalPages(
    totalItems,
  ) {
    if (!totalItems) {
      return 0;
    }

    return Math.ceil(
      totalItems /
        PAGE_SIZE,
    );
  }

  /* ==========================================================================
     Apply Page Visibility
     ========================================================================== */

  function applyPageVisibility(
    panel,
    visibleIndexes,
  ) {
    if (
      !(
        panel instanceof
        HTMLElement
      )
    ) {
      return;
    }

    panel
      .querySelectorAll(
        SELECTORS.group,
      )
      .forEach(
        (group) => {
          let hasVisibleItem =
            false;

          group
            .querySelectorAll(
              SELECTORS.resultItem,
            )
            .forEach(
              (item) => {
                const index =
                  Number(
                    item
                      .dataset
                      .directoryIndex,
                  );

                const visible =
                  Number
                    .isInteger(
                      index,
                    ) &&
                  visibleIndexes
                    .has(index);

                item.hidden =
                  !visible;

                if (visible) {
                  hasVisibleItem =
                    true;
                }
              },
            );

          /*
           * Do not modify group.hidden here.
           *
           * DirectoryAlphabet owns semantic
           * alphabet visibility.
           *
           * Pagination only controls display.
           */
          group.style.display =
            hasVisibleItem
              ? ""
              : "none";
        },
      );
  }

  /* ==========================================================================
     Result Summary
     ========================================================================== */

  function updateResultSummary({
    totalItems,
    startIndex,
    pageItemCount,
  }) {
    const start =
      totalItems > 0
        ? startIndex + 1
        : 0;

    const end =
      totalItems > 0
        ? startIndex +
          pageItemCount
        : 0;

    const range =
      `${start}–${end}`;

    setText(
      SELECTORS.resultCount,
      totalItems,
    );

    setText(
      SELECTORS.range,
      range,
    );

    setText(
      SELECTORS.total,
      totalItems,
    );

    setText(
      SELECTORS.paginationRange,
      range,
    );

    setText(
      SELECTORS.paginationTotal,
      totalItems,
    );

    const liveStatus =
      document.querySelector(
        SELECTORS.liveStatus,
      );

    if (
      liveStatus instanceof
      HTMLElement
    ) {
      const resultsLabel =
        LABELS.results ||
        "Results";

      liveStatus.textContent =
        totalItems > 0
          ? `${resultsLabel}: ${range} / ${totalItems}`
          : `${resultsLabel}: 0`;
    }
  }

  /* ==========================================================================
     Pagination Renderer
     ========================================================================== */

  function renderPagination({
    currentPage,
    totalPages,
  }) {
    const navigation =
      document.querySelector(
        SELECTORS.pagination,
      );

    const list =
      document.querySelector(
        SELECTORS.paginationList,
      );

    if (
      !(
        navigation instanceof
        HTMLElement
      ) ||
      !(
        list instanceof
        HTMLElement
      )
    ) {
      return;
    }

    /*
     * Legacy compatibility fields.
     */
    setControlValue(
      SELECTORS.pageLimit,
      PAGE_SIZE,
    );

    setControlValue(
      SELECTORS.pageCount,
      totalPages,
    );

    if (
      totalPages <= 1
    ) {
      navigation.hidden =
        true;

      list.innerHTML = "";

      return;
    }

    navigation.hidden =
      false;

    const items = [];

    /* --------------------------------------------------------------------------
       Previous
       -------------------------------------------------------------------------- */

    const previousDisabled =
      currentPage <= 1;

    items.push(`
      <li class="pagination__item">

        <button
          class="pagination__link pagination__link--previous has-icon icon-chevron-left icon-flip-rtl${
            previousDisabled
              ? " is-disabled"
              : ""
          }"
          type="button"
          data-directory-page-prev
          ${
            previousDisabled
              ? 'disabled aria-disabled="true"'
              : ""
          }
        >
          <span class="visually-hidden">
            Previous page
          </span>
        </button>

      </li>
    `);

    /* --------------------------------------------------------------------------
       Page Numbers / Ellipsis
       -------------------------------------------------------------------------- */

    const pageItems =
      getPaginationItems(
        currentPage,
        totalPages,
      );

    pageItems.forEach(
      (page) => {
        if (
          page === null
        ) {
          items.push(`
            <li
              class="pagination__item pagination__item--ellipsis"
              aria-hidden="true"
            >
              <span class="pagination__ellipsis">
                …
              </span>
            </li>
          `);

          return;
        }

        const isCurrent =
          page ===
          currentPage;

        items.push(`
          <li class="pagination__item">

            <button
              class="pagination__link${
                isCurrent
                  ? " is-current"
                  : ""
              }"
              type="button"
              data-directory-page="${page}"
              ${
                isCurrent
                  ? 'aria-current="page"'
                  : ""
              }
            >
              ${page}
            </button>

          </li>
        `);
      },
    );

    /* --------------------------------------------------------------------------
       Next
       -------------------------------------------------------------------------- */

    const nextDisabled =
      currentPage >=
      totalPages;

    items.push(`
      <li class="pagination__item">

        <button
          class="pagination__link pagination__link--next has-icon icon-chevron-right icon-flip-rtl${
            nextDisabled
              ? " is-disabled"
              : ""
          }"
          type="button"
          data-directory-page-next
          ${
            nextDisabled
              ? 'disabled aria-disabled="true"'
              : ""
          }
        >
          <span class="visually-hidden">
            Next page
          </span>
        </button>

      </li>
    `);

    list.innerHTML =
      items.join("");
  }

  /* ==========================================================================
     Pagination Window
     ========================================================================== */

  function getPaginationItems(
    currentPage,
    totalPages,
  ) {
    /*
     * MAX_PAGE_BUTTONS = 3
     *
     * Examples:
     *
     * 1 2 3 … 18
     *
     * 1 … 7 8 9 … 18
     *
     * 1 … 16 17 18
     */

    if (
      totalPages <=
      MAX_PAGE_BUTTONS +
        2
    ) {
      return Array.from(
        {
          length:
            totalPages,
        },
        (_, index) =>
          index + 1,
      );
    }

    const pages =
      new Set([
        1,
        totalPages,
      ]);

    const half =
      Math.floor(
        MAX_PAGE_BUTTONS /
          2,
      );

    let start =
      Math.max(
        1,
        currentPage -
          half,
      );

    let end =
      Math.min(
        totalPages,
        start +
          MAX_PAGE_BUTTONS -
          1,
      );

    /*
     * Shift window left near the end.
     */
    if (
      end -
        start +
        1 <
      MAX_PAGE_BUTTONS
    ) {
      start =
        Math.max(
          1,
          end -
            MAX_PAGE_BUTTONS +
            1,
        );
    }

    for (
      let page = start;
      page <= end;
      page += 1
    ) {
      pages.add(page);
    }

    const sortedPages =
      Array.from(
        pages,
      ).sort(
        (a, b) =>
          a - b,
      );

    const result = [];

    sortedPages.forEach(
      (
        page,
        index,
      ) => {
        if (
          index > 0 &&
          page -
            sortedPages[
              index - 1
            ] >
            1
        ) {
          result.push(
            null,
          );
        }

        result.push(
          page,
        );
      },
    );

    return result;
  }

  /* ==========================================================================
     Empty State
     ========================================================================== */

  function updateEmptyState(
    isEmpty,
  ) {
    const empty =
      document.querySelector(
        SELECTORS.empty,
      );

    const results =
      document.querySelector(
        SELECTORS.results,
      );

    if (
      empty instanceof
      HTMLElement
    ) {
      empty.hidden =
        !isEmpty;
    }

    if (
      results instanceof
      HTMLElement
    ) {
      results.classList.toggle(
        "is-empty",
        isEmpty,
      );
    }
  }

  /* ==========================================================================
     Busy State
     ========================================================================== */

  function setBusy(
    isBusy,
  ) {
    const results =
      document.querySelector(
        SELECTORS.results,
      );

    if (
      !(
        results instanceof
        HTMLElement
      )
    ) {
      return;
    }

    results.setAttribute(
      "aria-busy",
      String(isBusy),
    );
  }

  /* ==========================================================================
     Directory Refresh Bridge
     ========================================================================== */

  function refreshDirectory() {
    if (
      window.Theme &&
      window.Theme.directory &&
      typeof window
        .Theme
        .directory
        .refresh ===
        "function"
    ) {
      window
        .Theme
        .directory
        .refresh(
          document,
        );
    }
  }

  /* ==========================================================================
     Custom Select Synchronization
     ========================================================================== */

  function notifySelectChanged(
    select,
  ) {
    if (
      !(
        select instanceof
        HTMLSelectElement
      )
    ) {
      return;
    }

    /*
     * Notify the shared custom-select implementation
     * after programmatic option/value replacement.
     *
     * Prevent this controller from issuing a duplicate
     * company request for that synthetic change.
     */
    state.suppressSectorChange =
      true;

    try {
      select.dispatchEvent(
        new Event(
          "change",
          {
            bubbles:
              true,
          },
        ),
      );
    } finally {
      state.suppressSectorChange =
        false;
    }
  }

  /* ==========================================================================
     Logo Fallback
     ========================================================================== */

  function handleImageError(
    event,
  ) {
    const image =
      event.target;

    if (
      !(
        image instanceof
        HTMLImageElement
      ) ||
      !image.matches(
        SELECTORS.logo,
      )
    ) {
      return;
    }

    if (
      image.dataset
        .fallbackApplied ===
      "true"
    ) {
      return;
    }

    image.dataset
      .fallbackApplied =
      "true";

    image.src =
      FALLBACK_LOGO_URL;
  }

  /* ==========================================================================
     Sector Option Rendering
     ========================================================================== */

  function replaceSelectOptions(
    select,
    options,
  ) {
    if (
      !(
        select instanceof
        HTMLSelectElement
      )
    ) {
      return;
    }

    const fragment =
      document
        .createDocumentFragment();

    options.forEach(
      (item) => {
        const option =
          document.createElement(
            "option",
          );

        option.value =
          String(
            item.value !=
            null
              ? item.value
              : "",
          );

        option.textContent =
          String(
            item.text !=
            null
              ? item.text
              : "",
          );

        option.defaultSelected =
          Boolean(
            item.selected,
          );

        option.selected =
          Boolean(
            item.selected,
          );

        fragment.appendChild(
          option,
        );
      },
    );

    select.replaceChildren(
      fragment,
    );
  }

  /* ==========================================================================
     Form Helpers
     ========================================================================== */

  function getControlValue(
    selector,
  ) {
    const control =
      document.querySelector(
        selector,
      );

    if (
      !(
        control instanceof
        HTMLInputElement
      ) &&
      !(
        control instanceof
        HTMLSelectElement
      )
    ) {
      return "";
    }

    return (
      control.value ||
      ""
    );
  }

  function setControlValue(
    selector,
    value,
  ) {
    const control =
      document.querySelector(
        selector,
      );

    if (
      !(
        control instanceof
        HTMLInputElement
      ) &&
      !(
        control instanceof
        HTMLSelectElement
      )
    ) {
      return;
    }

    control.value =
      String(value);
  }

  /* ==========================================================================
     Company Name
     ========================================================================== */

  function getCompanyName(
    company,
  ) {
    if (!company) {
      return "—";
    }

    /*
     * Preserve legacy backend typo:
     *
     * lonaName
     */
    return getDisplayValue(
      company.lonaName ||
        company.longName ||
        company.shortName ||
        company.symbol,
    );
  }

  /* ==========================================================================
     Display Value
     ========================================================================== */

  function getDisplayValue(
    value,
  ) {
    if (
      value === null ||
      value === undefined ||
      String(value).trim() ===
        ""
    ) {
      return "—";
    }

    return String(
      value,
    ).trim();
  }

  /* ==========================================================================
     Company Logo
     ========================================================================== */

  function getCompanyLogoUrl(
    company,
  ) {
    const symbol =
      String(
        company &&
        company.symbol
          ? company.symbol
          : "",
      ).trim();

    if (!symbol) {
      return FALLBACK_LOGO_URL;
    }

    return (
      LOGO_BASE_URL +
      encodeURIComponent(
        symbol,
      ) +
      ".png"
    );
  }

  /* ==========================================================================
     Profile URL
     ========================================================================== */

  function sanitizeUrl(
    value,
  ) {
    const url =
      String(
        value || "",
      ).trim();

    if (!url) {
      return "#";
    }

    /*
     * Allow:
     *
     * - application-relative paths
     * - anchors
     * - HTTP
     * - HTTPS
     */
    if (
      url.startsWith("/") ||
      url.startsWith("#") ||
      /^https?:\/\//i
        .test(url)
    ) {
      return url;
    }

    return "#";
  }

  /* ==========================================================================
     Text Helper
     ========================================================================== */

  function setText(
    selector,
    value,
  ) {
    document
      .querySelectorAll(
        selector,
      )
      .forEach(
        (element) => {
          element.textContent =
            String(value);
        },
      );
  }

  /* ==========================================================================
     Integer Helper
     ========================================================================== */

  function getPositiveInteger(
    value,
    fallback,
  ) {
    const number =
      Number.parseInt(
        value,
        10,
      );

    return (
      Number.isInteger(
        number,
      ) &&
      number > 0
    )
      ? number
      : fallback;
  }

  /* ==========================================================================
     Debounce
     ========================================================================== */

  function debounce(
    callback,
    delay,
  ) {
    let timeoutId =
      null;

    return function debounced(
      ...args
    ) {
      window.clearTimeout(
        timeoutId,
      );

      timeoutId =
        window.setTimeout(
          () => {
            callback.apply(
              this,
              args,
            );
          },
          delay,
        );
    };
  }

  /* ==========================================================================
     HTML Escaping
     ========================================================================== */

  function escapeHtml(
    value,
  ) {
    return String(
      value == null
        ? ""
        : value,
    )
      .replace(
        /&/g,
        "&amp;",
      )
      .replace(
        /</g,
        "&lt;",
      )
      .replace(
        />/g,
        "&gt;",
      )
      .replace(
        /"/g,
        "&quot;",
      )
      .replace(
        /'/g,
        "&#039;",
      );
  }

  function escapeAttribute(
    value,
  ) {
    return escapeHtml(
      value,
    );
  }

  /* ==========================================================================
     Public API
     ========================================================================== */

  window.IssuerDirectory = {
    init:
      initIssuerDirectory,

    reload:
      loadCompanies,
  };

  /* ==========================================================================
     Auto Initialization
     ========================================================================== */

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initIssuerDirectory,
      {
        once: true,
      },
    );
  } else {
    initIssuerDirectory();
  }
})();