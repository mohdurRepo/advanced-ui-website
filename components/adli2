import { refreshDirectories } from "./directory";

/* ==========================================================================
   Issuer Directory
   ========================================================================== */

/**
 * Page-specific issuer directory controller.
 *
 * Owns:
 * - legacy company AJAX request
 * - market -> sector AJAX request
 * - symbol filtering
 * - rendering grid/card view
 * - rendering list view
 * - grouping companies alphabetically
 * - pagination
 * - result counts
 * - empty/loading state
 * - Arabic character normalization
 *
 * Does NOT own:
 * - alphabet button behavior
 * - alphabet active state
 * - alphabet keyboard navigation
 * - alphabet aria-pressed state
 * - grid/list switching
 * - generic custom-select behavior
 *
 * Those are handled by the reusable components.
 */


/* ==========================================================================
   Configuration
   ========================================================================== */

const CONFIG = window.issuerDirectoryConfig || {};

const URLS = CONFIG.urls || {};
const LABELS = CONFIG.labels || {};
const LOGOS = CONFIG.logos || {};
const PAGINATION = CONFIG.pagination || {};

const PAGE_SIZE = getPositiveInteger(PAGINATION.pageSize, 20);
const MAX_PAGE_BUTTONS = getPositiveInteger(PAGINATION.maxButtons, 3);

const LOGO_BASE_URL =
  LOGOS.baseUrl ||
  "https://www.tadawulgroup.sa/Resources/SEMOBILELOGOS/";

const FALLBACK_LOGO_URL =
  LOGOS.fallbackUrl ||
  `${LOGO_BASE_URL}default-Logo.png`;


/* ==========================================================================
   Selectors
   ========================================================================== */

const SELECTORS = {
  form: "#issuer-directory-filter-form",

  symbol: "#symbol_filter",
  market: "#Market_ti",
  sector: "#sectors_list",
  letterInput: "#letterId",

  alphabet: "[data-directory-alphabet]",

  results: "[data-directory-results]",
  resultCount: "#res-count",

  grid: "#issuer-directory-grid",
  list: "#issuer-directory-list",

  group: "[data-directory-group]",
  resultItem: ".directory-results__item",

  empty: "[data-directory-empty]",

  pagination: "[data-directory-pagination]",
  paginationList: "#pagination-ul",

  range: "[data-directory-range]",
  total: "[data-directory-total]",

  paginationRange: "[data-directory-pagination-range]",
  paginationTotal: "[data-directory-pagination-total]",

  pageLimit: "#pageLimitId",
  pageCount: "#recordsCountId",

  logo: "[data-issuer-logo]",
};


/* ==========================================================================
   Events
   ========================================================================== */

const EVENTS = {
  alphabetChange: "directory:alphabet-change",
};


/* ==========================================================================
   State
   ========================================================================== */

const state = {
  companies: [],

  currentPage: 1,

  companyRequest: null,
  sectorRequest: null,

  initialSectorOptions: [],

  arabicAliasToLetter: new Map(),

  initialized: false,
};


/* ==========================================================================
   Initialization
   ========================================================================== */

export function initIssuerDirectory() {
  if (state.initialized) {
    return;
  }

  const form = document.querySelector(SELECTORS.form);

  if (!form) {
    return;
  }

  state.initialized = true;

  captureInitialSectorOptions();
  buildArabicCharacterMap();
  bindEvents();

  loadCompanies();
}


/* ==========================================================================
   Auto Initialization
   ========================================================================== */

if (document.readyState === "loading") {
  document.addEventListener(
    "DOMContentLoaded",
    initIssuerDirectory,
    {
      once: true,
    },
  );
} else {
  initIssuerDirectory();
}


/* ==========================================================================
   Event Binding
   ========================================================================== */

function bindEvents() {
  const form = document.querySelector(SELECTORS.form);
  const symbol = document.querySelector(SELECTORS.symbol);
  const market = document.querySelector(SELECTORS.market);
  const sector = document.querySelector(SELECTORS.sector);
  const paginationList = document.querySelector(
    SELECTORS.paginationList,
  );

  if (!form) {
    return;
  }


  /* =========================================================================
     Form Submit
     ========================================================================= */

  form.addEventListener("submit", handleFormSubmit);


  /* =========================================================================
     Symbol Search
     ========================================================================= */

  symbol?.addEventListener(
    "input",
    debounce(handleSymbolChange, 500),
  );


  /* =========================================================================
     Market
     ========================================================================= */

  market?.addEventListener(
    "change",
    handleMarketChange,
  );


  /* =========================================================================
     Sector
     ========================================================================= */

  sector?.addEventListener(
    "change",
    handleSectorChange,
  );


  /* =========================================================================
     Reset
     ========================================================================= */

  form.addEventListener(
    "reset",
    handleFormReset,
  );


  /* =========================================================================
     Alphabet
     ========================================================================= */

  document.addEventListener(
    EVENTS.alphabetChange,
    handleAlphabetChange,
  );


  /* =========================================================================
     Pagination
     ========================================================================= */

  paginationList?.addEventListener(
    "click",
    handlePaginationClick,
  );


  /* =========================================================================
     Image Error / Logo Fallback
     ========================================================================= */

  document.addEventListener(
    "error",
    handleImageError,
    true,
  );
}


/* ==========================================================================
   Form Submit
   ========================================================================== */

function handleFormSubmit(event) {
  event.preventDefault();

  resetAlphabet();

  loadCompanies();
}


/* ==========================================================================
   Symbol Search
   ========================================================================== */

function handleSymbolChange() {
  resetAlphabet();

  loadCompanies();
}


/* ==========================================================================
   Market Change
   ========================================================================== */

function handleMarketChange(event) {
  resetAlphabet();

  const marketType =
    event.currentTarget.value || "";

  loadSectorsByMarket(marketType);
}


/* ==========================================================================
   Sector Change
   ========================================================================== */

function handleSectorChange() {
  resetAlphabet();

  loadCompanies();
}


/* ==========================================================================
   Form Reset
   ========================================================================== */

function handleFormReset() {
  abortSectorRequest();

  /*
   * Native reset values are applied after the reset event.
   */
  requestAnimationFrame(() => {
    restoreInitialSectorOptions();

    state.currentPage = 1;

    loadCompanies();
  });
}


/* ==========================================================================
   Alphabet Change
   ========================================================================== */

function handleAlphabetChange(event) {
  const alphabet = event.target;
  const form = document.querySelector(SELECTORS.form);

  if (
    !(alphabet instanceof Element) ||
    !alphabet.matches(SELECTORS.alphabet) ||
    !form?.contains(alphabet)
  ) {
    return;
  }

  /*
   * DirectoryAlphabet has already:
   *
   * - changed the active button
   * - updated aria-pressed
   * - updated #letterId
   * - shown/hidden directory groups
   *
   * We only restart pagination for the newly selected result set.
   */

  state.currentPage = 1;

  renderPage(1);
}


/* ==========================================================================
   Pagination Click
   ========================================================================== */

function handlePaginationClick(event) {
  const pageButton = event.target.closest(
    "[data-directory-page]",
  );

  if (pageButton) {
    const page = Number(
      pageButton.getAttribute(
        "data-directory-page",
      ),
    );

    if (Number.isInteger(page)) {
      renderPage(page);
    }

    return;
  }


  const previousButton = event.target.closest(
    "[data-directory-page-prev]",
  );

  if (previousButton) {
    if (state.currentPage > 1) {
      renderPage(
        state.currentPage - 1,
      );
    }

    return;
  }


  const nextButton = event.target.closest(
    "[data-directory-page-next]",
  );

  if (!nextButton) {
    return;
  }

  const totalItems =
    getAlphabetFilteredIndexes().length;

  const totalPages =
    getTotalPages(totalItems);

  if (state.currentPage < totalPages) {
    renderPage(
      state.currentPage + 1,
    );
  }
}


/* ==========================================================================
   Logo Error
   ========================================================================== */

function handleImageError(event) {
  const image = event.target;

  if (
    !(image instanceof HTMLImageElement) ||
    !image.matches(SELECTORS.logo)
  ) {
    return;
  }

  if (
    image.dataset.fallbackApplied === "true"
  ) {
    return;
  }

  image.dataset.fallbackApplied = "true";
  image.src = FALLBACK_LOGO_URL;
}


/* ==========================================================================
   Alphabet Reset
   ========================================================================== */

function resetAlphabet() {
  const letterInput =
    document.querySelector(
      SELECTORS.letterInput,
    );

  if (letterInput) {
    letterInput.value = "";
  }

  state.currentPage = 1;

  /*
   * Synchronize DirectoryAlphabet with the cleared hidden value.
   *
   * refreshDirectories() does not dispatch another alphabet-change event,
   * so this does not cause an event loop.
   */
  refreshDirectories(document);
}


/* ==========================================================================
   Arabic Character Mapping
   ========================================================================== */

function buildArabicCharacterMap() {
  state.arabicAliasToLetter.clear();

  const mapping = String(
    CONFIG.arabicCharactersMapping || "",
  ).trim();

  if (!mapping) {
    return;
  }

  mapping
    .split(",")
    .map((entry) => entry.trim())
    .filter(Boolean)
    .forEach((entry) => {
      const separatorIndex =
        entry.indexOf("-");

      if (separatorIndex === -1) {
        return;
      }

      const displayLetter =
        normalizeLetter(
          entry.slice(
            0,
            separatorIndex,
          ),
        );

      const alias =
        normalizeLetter(
          entry.slice(
            separatorIndex + 1,
          ),
        );

      if (
        !displayLetter ||
        !alias
      ) {
        return;
      }

      /*
       * Legacy mapping was:
       *
       * display character -> backend variants.
       *
       * For client-side grouping we need:
       *
       * variant -> displayed alphabet character.
       */

      state.arabicAliasToLetter.set(
        displayLetter,
        displayLetter,
      );

      state.arabicAliasToLetter.set(
        alias,
        displayLetter,
      );
    });
}


/* ==========================================================================
   Letter Normalization
   ========================================================================== */

function normalizeLetter(value) {
  return String(value || "")
    .trim()
    .toLocaleUpperCase();
}


/* ==========================================================================
   Initial Sector Options
   ========================================================================== */

function captureInitialSectorOptions() {
  const select =
    document.querySelector(
      SELECTORS.sector,
    );

  if (
    !(select instanceof HTMLSelectElement)
  ) {
    return;
  }

  state.initialSectorOptions =
    Array.from(select.options).map(
      (option) => ({
        value: option.value,
        text: option.text,
        selected:
          option.defaultSelected,
      }),
    );
}


/* ==========================================================================
   Restore Sector Options
   ========================================================================== */

function restoreInitialSectorOptions() {
  const select =
    document.querySelector(
      SELECTORS.sector,
    );

  if (
    !(select instanceof HTMLSelectElement)
  ) {
    return;
  }

  replaceSelectOptions(
    select,
    state.initialSectorOptions,
  );

  select.value = "All";
}


/* ==========================================================================
   Market -> Sector AJAX
   ========================================================================== */

async function loadSectorsByMarket(
  marketType,
) {
  const sectorSelect =
    document.querySelector(
      SELECTORS.sector,
    );

  if (
    !(sectorSelect instanceof HTMLSelectElement)
  ) {
    await loadCompanies();

    return;
  }


  /*
   * Cancel any previous sector request first.
   *
   * This also prevents an old request from overwriting the restored
   * sector list after the user changes back to "All markets".
   */

  abortSectorRequest();


  /* =========================================================================
     All Markets
     ========================================================================= */

  if (!marketType) {
    restoreInitialSectorOptions();

    await loadCompanies();

    return;
  }


  if (!URLS.sectorsByMarket) {
    console.error(
      "IssuerDirectory: sectorsByMarket URL is missing.",
    );

    return;
  }


  const controller =
    new AbortController();

  state.sectorRequest =
    controller;

  sectorSelect.disabled = true;


  try {
    const response =
      await postForm(
        URLS.sectorsByMarket,
        {
          format: "json",
          marketType,
        },
        controller.signal,
      );


    /*
     * Ignore response from a request that is no longer current.
     */
    if (
      state.sectorRequest !== controller
    ) {
      return;
    }


    const options = [
      {
        value: "All",

        text:
          LABELS.allSectors ||
          "All Sectors",

        selected: true,
      },
    ];


    if (Array.isArray(response)) {
      response.forEach((sector) => {
        if (!sector) {
          return;
        }

        options.push({
          value:
            sector.pk_rf_sector ??
            "",

          text:
            sector.name ??
            "",

          selected: false,
        });
      });
    }


    replaceSelectOptions(
      sectorSelect,
      options,
    );

    sectorSelect.value = "All";


    await loadCompanies();

  } catch (error) {
    if (
      error?.name ===
      "AbortError"
    ) {
      return;
    }

    console.error(
      "IssuerDirectory: unable to load sectors.",
      error,
    );

  } finally {
    if (
      state.sectorRequest === controller
    ) {
      state.sectorRequest = null;
      sectorSelect.disabled = false;
    }
  }
}


/* ==========================================================================
   Abort Sector Request
   ========================================================================== */

function abortSectorRequest() {
  if (!state.sectorRequest) {
    return;
  }

  state.sectorRequest.abort();
  state.sectorRequest = null;

  const sector =
    document.querySelector(
      SELECTORS.sector,
    );

  if (
    sector instanceof HTMLSelectElement
  ) {
    sector.disabled = false;
  }
}


/* ==========================================================================
   Company AJAX
   ========================================================================== */

async function loadCompanies() {
  if (!URLS.companies) {
    console.error(
      "IssuerDirectory: companies URL is missing.",
    );

    return;
  }


  abortCompanyRequest();


  const controller =
    new AbortController();

  state.companyRequest =
    controller;


  setBusy(true);


  const marketType =
    getControlValue(
      SELECTORS.market,
    );

  const sector =
    getControlValue(
      SELECTORS.sector,
    );

  const symbol =
    getControlValue(
      SELECTORS.symbol,
    );


  /*
   * IMPORTANT
   * --------------------------------------------------------------------------
   *
   * The legacy implementation sent `letter` to the backend.
   *
   * The new DirectoryAlphabet determines which alphabet controls are available
   * by inspecting all [data-directory-group] elements currently rendered.
   *
   * Therefore we fetch ALL companies matching:
   *
   * - market
   * - sector
   * - symbol
   *
   * and let DirectoryAlphabet filter the complete rendered collection locally.
   *
   * If we fetched only one letter from the server, every other alphabet button
   * would incorrectly become disabled.
   */

  const requestData = {
    marketType,
    sector,
    symbol,
    letter: "",
  };


  try {
    const response =
      await postForm(
        URLS.companies,
        requestData,
        controller.signal,
      );


    if (
      state.companyRequest !== controller
    ) {
      return;
    }


    state.companies =
      Array.isArray(response?.data)
        ? response.data
        : [];


    state.currentPage = 1;


    renderDirectory(
      state.companies,
    );


    /*
     * The AJAX response replaced the directory groups.
     *
     * Recollect:
     *
     * - grid groups
     * - list groups
     * - available alphabet letters
     */

    refreshDirectories(document);


    /*
     * DirectoryAlphabet needs to finish synchronizing its group visibility
     * before page-level pagination is applied.
     */

    requestAnimationFrame(() => {
      renderPage(1);
    });

  } catch (error) {
    if (
      error?.name ===
      "AbortError"
    ) {
      return;
    }


    console.error(
      "IssuerDirectory: unable to load companies.",
      error,
    );


    state.companies = [];
    state.currentPage = 1;


    renderDirectory(
      state.companies,
    );

    refreshDirectories(document);

    renderPage(1);

  } finally {
    if (
      state.companyRequest === controller
    ) {
      state.companyRequest = null;

      setBusy(false);
    }
  }
}


/* ==========================================================================
   Abort Company Request
   ========================================================================== */

function abortCompanyRequest() {
  if (!state.companyRequest) {
    return;
  }

  state.companyRequest.abort();
  state.companyRequest = null;
}


/* ==========================================================================
   POST Form Request
   ========================================================================== */

async function postForm(
  url,
  data,
  signal,
) {
  const body =
    new URLSearchParams();

  Object.entries(data).forEach(
    ([key, value]) => {
      body.append(
        key,
        value == null
          ? ""
          : String(value),
      );
    },
  );


  const response =
    await fetch(url, {
      method: "POST",

      credentials: "same-origin",

      signal,

      headers: {
        "Content-Type":
          "application/x-www-form-urlencoded; charset=UTF-8",

        "X-Requested-With":
          "XMLHttpRequest",
      },

      body,
    });


  if (!response.ok) {
    throw new Error(
      `HTTP ${response.status}`,
    );
  }


  const text =
    await response.text();


  return parseJsonResponse(text);
}


/* ==========================================================================
   JSON Response
   ========================================================================== */

function parseJsonResponse(value) {
  if (
    value === null ||
    value === undefined
  ) {
    return {};
  }


  if (
    typeof value === "object"
  ) {
    return value;
  }


  const text =
    String(value).trim();


  if (!text) {
    return {};
  }


  try {
    const parsed =
      JSON.parse(text);

    /*
     * Also tolerate an accidentally double-encoded JSON response.
     */

    if (
      typeof parsed === "string"
    ) {
      try {
        return JSON.parse(parsed);
      } catch {
        return parsed;
      }
    }

    return parsed;

  } catch (error) {
    console.error(
      "IssuerDirectory: invalid JSON response.",
      text,
    );

    throw error;
  }
}


/* ==========================================================================
   Directory Rendering
   ========================================================================== */

function renderDirectory(companies) {
  const grid =
    document.querySelector(
      SELECTORS.grid,
    );

  const list =
    document.querySelector(
      SELECTORS.list,
    );


  if (!grid || !list) {
    console.error(
      "IssuerDirectory: grid/list result panels are missing.",
    );

    return;
  }


  const groups =
    groupCompanies(companies);


  grid.innerHTML =
    groups
      .map(
        (group, index) =>
          renderGridGroup(
            group,
            index,
          ),
      )
      .join("");


  list.innerHTML =
    groups
      .map(
        (group, index) =>
          renderListGroup(
            group,
            index,
          ),
      )
      .join("");
}


/* ==========================================================================
   Group Companies
   ========================================================================== */

function groupCompanies(companies) {
  const groups =
    new Map();


  companies.forEach(
    (company, companyIndex) => {
      const letter =
        resolveCompanyLetter(
          company,
        );


      if (!groups.has(letter)) {
        groups.set(letter, {
          letter,
          items: [],
        });
      }


      groups
        .get(letter)
        .items
        .push({
          company,
          index: companyIndex,
        });
    },
  );


  return sortGroups(
    Array.from(
      groups.values(),
    ),
  );
}


/* ==========================================================================
   Group Sorting
   ========================================================================== */

function sortGroups(groups) {
  const alphabetOrder =
    getAlphabetOrder();


  return groups.sort(
    (groupA, groupB) => {
      const indexA =
        alphabetOrder.indexOf(
          groupA.letter,
        );

      const indexB =
        alphabetOrder.indexOf(
          groupB.letter,
        );


      /*
       * Both exist in the displayed alphabet.
       */

      if (
        indexA !== -1 &&
        indexB !== -1
      ) {
        return indexA - indexB;
      }


      /*
       * Known alphabet letters before unknown groups.
       */

      if (indexA !== -1) {
        return -1;
      }

      if (indexB !== -1) {
        return 1;
      }


      /*
       * Fallback sorting.
       */

      return groupA.letter.localeCompare(
        groupB.letter,
        CONFIG.locale || undefined,
      );
    },
  );
}


/* ==========================================================================
   Current Alphabet Order
   ========================================================================== */

function getAlphabetOrder() {
  return Array.from(
    document.querySelectorAll(
      `${SELECTORS.alphabet} [data-directory-letter]`,
    ),
  )
    .map((control) =>
      normalizeLetter(
        control.getAttribute(
          "data-directory-letter",
        ),
      ),
    )
    .filter(Boolean);
}


/* ==========================================================================
   Resolve Company Letter
   ========================================================================== */

function resolveCompanyLetter(company) {
  const name =
    getCompanyName(company);


  if (
    !name ||
    name === "—"
  ) {
    return "#";
  }


  const characters =
    Array.from(
      name.trim(),
    );


  if (!characters.length) {
    return "#";
  }


  const firstCharacter =
    normalizeLetter(
      characters[0],
    );


  /*
   * Arabic aliases are normalized back to the letter displayed by the
   * alphabet component.
   */

  if (
    state.arabicAliasToLetter.has(
      firstCharacter,
    )
  ) {
    return state.arabicAliasToLetter.get(
      firstCharacter,
    );
  }


  return (
    firstCharacter ||
    "#"
  );
}


