<!-- ==========================================================================
     Issuer Directory Results
     ========================================================================== -->

<section
	class="section directory"
	aria-labelledby="issuer-results-title"
	data-view-root
	data-view-default="grid"
	data-view-storage-key="issuer-directory-view"
>
	<div class="container">

		<div class="directory__surface">

			<div class="directory__content">

				<!-- ============================================================
				     Results Header
				     ============================================================ -->

				<header class="directory__header">

					<div class="directory__heading">

						<h2
							id="issuer-results-title"
							class="directory__title"
						>
							<fmt:message
								key="tadawul.eportal.issuer.directory.company.info.results.text"
							/>
						</h2>

					</div>


					<!-- ========================================================
					     Result Count
					     ======================================================== -->

					<div
						class="directory__count"
						role="status"
						aria-live="polite"
						aria-atomic="true"
					>

						<span
							id="res-count"
							class="directory__count-value"
							data-directory-result-count
						>
							0
						</span>

					</div>

				</header>


				<!-- ============================================================
				     Results Workspace
				     ============================================================ -->

				<div class="directory__workspace">

					<!-- ========================================================
					     Results Toolbar
					     ======================================================== -->

					<div class="directory__results-header">

						<div class="directory-toolbar">

							<!-- =================================================
							     Results Summary
							     ================================================= -->

							<div class="directory-toolbar__summary">

								<p
									class="directory-toolbar__status"
									data-directory-toolbar-status
								>
									<span data-directory-range>
										0–0
									</span>

									<span aria-hidden="true">
										/
									</span>

									<strong data-directory-total>
										0
									</strong>
								</p>

							</div>


							<!-- =================================================
							     View Switcher
							     ================================================= -->

							<div class="directory-toolbar__actions">

								<div
									class="directory-view-switch"
									role="group"
									aria-label="Choose issuer results view"
								>

									<!-- =========================================
									     Grid / Card View
									     ========================================= -->

									<button
										class="directory-view-switch__control has-icon icon-grid-bento-view is-active"
										type="button"
										aria-label="Show issuers in grid view"
										aria-controls="issuer-directory-grid"
										aria-pressed="true"
										data-view-control="grid"
									></button>


									<!-- =========================================
									     List View
									     ========================================= -->

									<button
										class="directory-view-switch__control has-icon icon-list-bullet"
										type="button"
										aria-label="Show issuers in list view"
										aria-controls="issuer-directory-list"
										aria-pressed="false"
										data-view-control="list"
									></button>

								</div>

							</div>

						</div>

					</div>


					<!-- ========================================================
					     Accessible Live Status
					     ======================================================== -->

					<div
						class="directory__live-status visually-hidden"
						role="status"
						aria-live="polite"
						aria-atomic="true"
						data-directory-live-status
						data-view-live-status
					></div>


					<!-- ========================================================
					     Results
					     ======================================================== -->

					<div
						class="directory__results directory-results directory-results--grid-3"
						data-directory-results
						data-view="grid"
						aria-busy="false"
					>

						<!-- ====================================================
						     Grid / Card View
						     ==================================================== -->

						<div
							id="issuer-directory-grid"
							class="stack stack--xl"
							aria-label="Issuers in grid view"
							data-view-panel="grid"
							data-directory-grid
						>

							<%--
								Dynamic grid groups are rendered here.

								Expected generated structure:

								<section
									class="directory-group"
									data-directory-group="A"
								>
									<header class="directory-group__header">

										<h3 class="directory-group__title">
											A
										</h3>

										<span class="directory-group__count">
											3
										</span>

									</header>

									<ul
										class="directory-results__collection
										       directory-results__collection--grid"
									>

										<li class="directory-results__item">

											<article class="card issuer-card">

												...

											</article>

										</li>

									</ul>

								</section>
							--%>

						</div>


						<!-- ====================================================
						     List View
						     ==================================================== -->

						<div
							id="issuer-directory-list"
							class="stack stack--lg"
							aria-label="Issuers in list view"
							data-view-panel="list"
							data-directory-list
							hidden
						>

							<%--
								Dynamic list groups are rendered here.

								Expected generated structure:

								<section
									class="directory-group directory-group--list"
									data-directory-group="A"
								>

									<header class="directory-group__header">

										<h3 class="directory-group__title">
											A
										</h3>

										<span class="directory-group__count">
											3
										</span>

									</header>

									<div class="directory-group__items">

										<article
											class="directory-results__item
											       issuer-row"
										>

											...

										</article>

									</div>

								</section>
