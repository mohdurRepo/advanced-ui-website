  );
}


/* ==========================================================================
   Sector Option Rendering
   ========================================================================== */

function replaceSelectOptions(
  select,
  options,
) {
  if (
    !(select instanceof HTMLSelectElement)
  ) {
    return;
  }


  const fragment =
    document.createDocumentFragment();


  options.forEach((item) => {
    const option =
      document.createElement(
        "option",
      );


    option.value =
      String(
        item.value ?? "",
      );


    option.textContent =
      String(
        item.text ?? "",
      );


    option.defaultSelected =
      Boolean(
        item.selected,
      );


    option.selected =
      Boolean(
        item.selected,
      );


    fragment.appendChild(
      option,
    );
  });


  select.replaceChildren(
    fragment,
  );
}


/* ==========================================================================
   Form Helpers
   ========================================================================== */

function getControlValue(selector) {
  const control =
    document.querySelector(
      selector,
    );


  if (
    !(
      control instanceof HTMLInputElement ||
      control instanceof HTMLSelectElement
    )
  ) {
    return "";
  }


  return (
    control.value ||
    ""
  );
}


function setControlValue(
  selector,
  value,
) {
  const control =
    document.querySelector(
      selector,
    );


  if (
    !(
      control instanceof HTMLInputElement ||
      control instanceof HTMLSelectElement
    )
  ) {
    return;
  }


  control.value =
    String(value);
}


/* ==========================================================================
   Company Name
   ========================================================================== */

function getCompanyName(company) {
  return getDisplayValue(
    company?.lonaName ||
      company?.longName ||
      company?.shortName ||
      company?.symbol,
  );
}


/* ==========================================================================
   Display Value
   ========================================================================== */

function getDisplayValue(value) {
  if (
    value === null ||
    value === undefined ||
    String(value).trim() === ""
  ) {
    return "—";
  }


  return String(value).trim();
}


/* ==========================================================================
   Company Logo
   ========================================================================== */

function getCompanyLogoUrl(company) {
  const symbol =
    String(
      company?.symbol ||
      "",
    ).trim();


  if (!symbol) {
    return FALLBACK_LOGO_URL;
  }


  return (
    LOGO_BASE_URL +
    encodeURIComponent(symbol) +
    ".png"
  );
}


/* ==========================================================================
   Profile URL
   ========================================================================== */

function sanitizeUrl(value) {
  const url =
    String(
      value ||
      "",
    ).trim();


  if (!url) {
    return "#";
  }


  /*
   * Allow:
   *
   * - application-relative links
   * - anchors
   * - HTTP
   * - HTTPS
   */

  if (
    url.startsWith("/") ||
    url.startsWith("#") ||
    /^https?:\/\//i.test(url)
  ) {
    return url;
  }


  return "#";
}


/* ==========================================================================
   Text Helper
   ========================================================================== */

function setText(
  selector,
  value,
) {
  document
    .querySelectorAll(selector)
    .forEach((element) => {
      element.textContent =
        String(value);
    });
}


/* ==========================================================================
   Integer Helper
   ========================================================================== */

function getPositiveInteger(
  value,
  fallback,
) {
  const number =
    Number.parseInt(
      value,
      10,
    );


  return (
    Number.isInteger(number) &&
    number > 0
  )
    ? number
    : fallback;
}


/* ==========================================================================
   Debounce
   ========================================================================== */

function debounce(
  callback,
  delay,
) {
  let timeoutId = null;


  return function debounced(
    ...args
  ) {
    clearTimeout(
      timeoutId,
    );


    timeoutId =
      window.setTimeout(
        () => {
          callback.apply(
            this,
            args,
          );
        },
        delay,
      );
  };
}


/* ==========================================================================
   HTML Escaping
   ========================================================================== */

function escapeHtml(value) {
  return String(
    value ?? "",
  )
    .replace(
      /&/g,
      "&amp;",
    )
    .replace(
      /</g,
      "&lt;",
    )
    .replace(
      />/g,
      "&gt;",
    )
    .replace(
      /"/g,
      "&quot;",
    )
    .replace(
      /'/g,
      "&#039;",
    );
}


function escapeAttribute(value) {
  return escapeHtml(value);
}