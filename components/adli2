<!-- ==========================================================================
     Issuer Directory Filters
     ========================================================================== -->

<section
	class="section issuer-directory-filters"
	aria-labelledby="issuer-directory-filters-title"
	data-directory-filters
>
	<div class="container">

		<form
			id="issuer-directory-filter-form"
			class="filter-bar filter-bar--stacked"
			role="search"
			data-directory-filter-form
		>

			<!-- ================================================================
			     Header
			     ================================================================ -->

			<header class="filter-bar__header">

				<div class="filter-bar__heading">

					<h2
						id="issuer-directory-filters-title"
						class="filter-bar__title"
					>
						<fmt:message
							key="tadawul.eportal.issuer.directory.company.info.title"
						/>
					</h2>

					<p class="filter-bar__description">
						<fmt:message
							key="tadawul.eportal.issuer.directory.company.info.title.text"
						/>
					</p>

				</div>

			</header>


			<!-- ================================================================
			     Primary Filters
			     ================================================================ -->

			<div class="filter-bar__inner">

				<div class="filter-bar__fields grid grid-3">

					<!-- ========================================================
					     Symbol
					     ======================================================== -->

					<div class="filter-bar__field">

						<label
							class="form-label"
							for="symbol_filter"
						>
							<fmt:message
								key="tadawul.eportal.issuer.directory.company.info.Symbol-Search"
							/>
						</label>

						<input
							id="symbol_filter"
							class="form-control"
							name="symbol_filter"
							type="search"
							inputmode="search"
							autocomplete="off"
							placeholder="<fmt:message key='tadawul.eportal.issuer.directory.company.info.enter-keyword' />"
							data-directory-search
						/>

					</div>


					<!-- ========================================================
					     Market
					     ======================================================== -->

					<div class="filter-bar__field">

						<label
							class="form-label"
							for="Market_ti"
						>
							<fmt:message
								key="tadawul.eportal.issuer.directory.company.info.Market"
							/>
						</label>

						<div
							class="custom-select"
							data-custom-select
						>

							<div
								class="form-select-wrap custom-select__fallback"
							>

								<select
									id="Market_ti"
									class="form-select custom-select__native"
									name="Market_ti"
									data-directory-market
								>

									<option
										value=""
										selected
									>
										<fmt:message
											key="tadawul.eportal.issuer.directory.company.info.Market"
										/>
									</option>

									<option value="M">
										<fmt:message
											key="tadawul.eportal.issuer.directory.company.info.label.main.market"
										/>
									</option>

									<option value="S">
										<fmt:message
											key="tadawul.eportal.issuer.directory.company.info.label.nomu.market"
										/>
									</option>

								</select>

								<span
									class="form-select-icon has-icon icon-chevron-down"
									aria-hidden="true"
								></span>

							</div>

						</div>

					</div>


					<!-- ========================================================
					     Sector
					     ======================================================== -->

					<div class="filter-bar__field">

						<label
							class="form-label"
							for="sectors_list"
						>
							<fmt:message
								key="tadawul.eportal.issuer.directory.company.info.Sector"
							/>
						</label>

						<div
							class="custom-select"
							data-custom-select
						>

							<div
								class="form-select-wrap custom-select__fallback"
							>

								<select
									id="sectors_list"
									class="form-select custom-select__native"
									name="sectors_list"
									data-directory-sector
								>

									<option
										value="All"
										selected
									>
										<fmt:message
											key="tadawul.eportal.issuer.directory.company.info.All-Sectors"
										/>
									</option>

									<c:forEach
										items="${requestScope.sectorsList}"
										var="sectors"
									>
										<option value="${sectors.pk_rf_sector}">
											${sectors.name}
										</option>
									</c:forEach>

								</select>

								<span
									class="form-select-icon has-icon icon-chevron-down"
									aria-hidden="true"
								></span>

							</div>

						</div>

					</div>

				</div>


				<!-- ============================================================
				     Actions
				     ============================================================ -->

				<div class="filter-bar__actions">

					<div class="filter-bar__action-group">

						<button
							class="btn btn-outline-primary has-icon icon-sync-refresh"
							type="reset"
							data-directory-filter-reset
						>
							<fmt:message
								key="tadawul.eportal.issuer.directory.company.info.reset"
							/>
						</button>

					</div>

				</div>

			</div>
            			<!-- ================================================================
			     Alphabetical Filter
			     ================================================================ -->

			<div class="filter-bar__secondary">

				<div class="filter-bar__secondary-content">

					<div
                        class="directory-alphabet directory-alphabet--quiet"
                        data-directory-alphabet
                        data-directory-server-filter
