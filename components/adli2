/* ==========================================================================
   Price Movement
   ========================================================================== */

function getMovement(
  value,
  baseClass,
) {
  const numericValue =
    Number.parseFloat(value);


  if (!Number.isFinite(numericValue)) {
    return {
      className:
        `${baseClass} price-neutral`,

      text: "—",
    };
  }


  if (numericValue > 0) {
    return {
      className:
        `${baseClass} price-up has-icon icon-triangle-up`,

      text:
        `+${numericValue.toFixed(2)}%`,
    };
  }


  if (numericValue < 0) {
    return {
      className:
        `${baseClass} price-down has-icon icon-triangle-down`,

      text:
        `${numericValue.toFixed(2)}%`,
    };
  }


  return {
    className:
      `${baseClass} price-neutral`,

    text:
      `${numericValue.toFixed(2)}%`,
  };
}


/* ==========================================================================
   Pagination
   ========================================================================== */

function renderPage(pageNumber) {
  const filteredIndexes =
    getAlphabetFilteredIndexes();


  const totalItems =
    filteredIndexes.length;


  const totalPages =
    getTotalPages(
      totalItems,
    );


  if (totalPages === 0) {
    state.currentPage = 1;

  } else {
    state.currentPage =
      Math.max(
        1,
        Math.min(
          Number(pageNumber) || 1,
          totalPages,
        ),
      );
  }


  const startIndex =
    (state.currentPage - 1) *
    PAGE_SIZE;


  const pageIndexes =
    filteredIndexes.slice(
      startIndex,
      startIndex + PAGE_SIZE,
    );


  const visibleIndexes =
    new Set(
      pageIndexes,
    );


  applyPageVisibility(
    document.querySelector(
      SELECTORS.grid,
    ),
    visibleIndexes,
  );


  applyPageVisibility(
    document.querySelector(
      SELECTORS.list,
    ),
    visibleIndexes,
  );


  updateResultSummary({
    totalItems,

    startIndex,

    pageItemCount:
      pageIndexes.length,
  });


  renderPagination({
    currentPage:
      state.currentPage,

    totalPages,
  });


  updateEmptyState(
    totalItems === 0,
  );
}


/* ==========================================================================
   Total Pages
   ========================================================================== */

function getTotalPages(totalItems) {
  if (!totalItems) {
    return 0;
  }

  return Math.ceil(
    totalItems /
    PAGE_SIZE,
  );
}


/* ==========================================================================
   Current Alphabet Result Indexes
   ========================================================================== */

function getAlphabetFilteredIndexes() {
  const grid =
    document.querySelector(
      SELECTORS.grid,
    );


  if (!grid) {
    return [];
  }


  const indexes = [];


  grid
    .querySelectorAll(
      SELECTORS.group,
    )
    .forEach((group) => {
      /*
       * `hidden` belongs exclusively to DirectoryAlphabet.
       */

      if (group.hidden) {
        return;
      }


      group
        .querySelectorAll(
          SELECTORS.resultItem,
        )
        .forEach((item) => {
          const index =
            Number(
              item.dataset.directoryIndex,
            );


          if (
            Number.isInteger(index)
          ) {
            indexes.push(index);
          }
        });
    });


  return indexes;
}


/* ==========================================================================
   Apply Page Visibility
   ========================================================================== */

function applyPageVisibility(
  panel,
  visibleIndexes,
) {
  if (!panel) {
    return;
  }


  panel
    .querySelectorAll(
      SELECTORS.group,
    )
    .forEach((group) => {
      /*
       * Alphabet visibility is semantic and belongs to DirectoryAlphabet.
       */

      const alphabetVisible =
        !group.hidden;


      let hasVisibleItem =
        false;


      group
        .querySelectorAll(
          SELECTORS.resultItem,
        )
        .forEach((item) => {
          const index =
            Number(
              item.dataset.directoryIndex,
            );


          const visible =
            alphabetVisible &&
            visibleIndexes.has(index);


          /*
           * Pagination owns item.hidden.
           *
           * DirectoryAlphabet works at group level, so these two systems
           * remain independent.
           */

          item.hidden =
            !visible;


          if (visible) {
            hasVisibleItem = true;
          }
        });


      /*
       * IMPORTANT:
       *
       * Do NOT set group.hidden here.
       *
       * DirectoryAlphabet owns group.hidden and uses that state to represent
       * the selected letter.
       *
       * Pagination only uses display to suppress groups that do not contain
       * an item on the current page.
       */

      group.style.display =
        alphabetVisible &&
        hasVisibleItem
          ? ""
          : "none";
    });
}


/* ==========================================================================
   Result Summary
   ========================================================================== */

function updateResultSummary({
  totalItems,
  startIndex,
  pageItemCount,
}) {
  const start =
    totalItems > 0
      ? startIndex + 1
      : 0;


  const end =
    totalItems > 0
      ? startIndex +
        pageItemCount
      : 0;


  const range =
    `${start}–${end}`;


  setText(
    SELECTORS.resultCount,
    totalItems,
  );


  setText(
    SELECTORS.range,
    range,
  );


  setText(
    SELECTORS.total,
    totalItems,
  );


  setText(
    SELECTORS.paginationRange,
    range,
  );


  setText(
    SELECTORS.paginationTotal,
    totalItems,
  );
}


/* ==========================================================================
   Pagination Renderer
   ========================================================================== */

function renderPagination({
  currentPage,
  totalPages,
}) {
  const navigation =
    document.querySelector(
      SELECTORS.pagination,
    );

  const list =
    document.querySelector(
      SELECTORS.paginationList,
    );


  if (!navigation || !list) {
    return;
  }


  /*
   * Keep these values for now because Part 4 still contains the legacy
   * compatibility inputs.
   *
   * recordsCountId stores TOTAL PAGES, matching the old pxpaginate behavior.
   */

  setControlValue(
    SELECTORS.pageLimit,
    PAGE_SIZE,
  );


  setControlValue(
    SELECTORS.pageCount,
    totalPages,
  );


  if (totalPages <= 1) {
    navigation.hidden = true;
    list.innerHTML = "";

    return;
  }


  navigation.hidden = false;


  const items = [];


  /* =========================================================================
     Previous
     ========================================================================= */

  const previousDisabled =
    currentPage <= 1;


  items.push(`
    <li class="pagination__item">

      <button
        class="pagination__link pagination__link--previous has-icon icon-chevron-left icon-flip-rtl${previousDisabled ? " is-disabled" : ""}"
        type="button"
        data-directory-page-prev
        ${previousDisabled ? 'disabled aria-disabled="true"' : ""}
      >
        <span class="visually-hidden">
          ${escapeHtml(
            LABELS.previousPage ||
              "Previous page",
          )}
        </span>
      </button>

    </li>
  `);


  /* =========================================================================
     Page Numbers
     ========================================================================= */

  const pageItems =
    getPaginationItems(
      currentPage,
      totalPages,
    );


  pageItems.forEach((page) => {
    if (page === null) {
      items.push(`
        <li
          class="pagination__item pagination__item--ellipsis"
          aria-hidden="true"
        >
          <span class="pagination__ellipsis">
            …
          </span>
        </li>
      `);

      return;
    }


    const isCurrent =
      page === currentPage;


    items.push(`
      <li class="pagination__item">

        <button
          class="pagination__link${isCurrent ? " is-current" : ""}"
          type="button"
          data-directory-page="${page}"
          ${isCurrent ? 'aria-current="page"' : ""}
        >
          ${page}
        </button>

      </li>
    `);
  });


  /* =========================================================================
     Next
     ========================================================================= */

  const nextDisabled =
    currentPage >= totalPages;


  items.push(`
    <li class="pagination__item">

      <button
        class="pagination__link pagination__link--next has-icon icon-chevron-right icon-flip-rtl${nextDisabled ? " is-disabled" : ""}"
        type="button"
        data-directory-page-next
        ${nextDisabled ? 'disabled aria-disabled="true"' : ""}
      >
        <span class="visually-hidden">
          ${escapeHtml(
            LABELS.nextPage ||
              "Next page",
          )}
        </span>
      </button>

    </li>
  `);


  list.innerHTML =
    items.join("");
}


/* ==========================================================================
   Pagination Window
   ========================================================================== */

function getPaginationItems(
  currentPage,
  totalPages,
) {
  /*
   * Small page count:
   *
   * 1 2 3 4 5
   */

  if (
    totalPages <=
    MAX_PAGE_BUTTONS + 2
  ) {
    return Array.from(
      {
        length: totalPages,
      },
      (_, index) =>
        index + 1,
    );
  }


  const pages =
    new Set([
      1,
      totalPages,
    ]);


  const half =
    Math.floor(
      MAX_PAGE_BUTTONS / 2,
    );


  let start =
    Math.max(
      1,
      currentPage - half,
    );


  let end =
    Math.min(
      totalPages,
      start +
        MAX_PAGE_BUTTONS -
        1,
    );


  /*
   * Shift the window left when close to the end.
   */

  if (
    end -
      start +
      1 <
    MAX_PAGE_BUTTONS
  ) {
    start =
      Math.max(
        1,
        end -
          MAX_PAGE_BUTTONS +
          1,
      );
  }


  for (
    let page = start;
    page <= end;
    page += 1
  ) {
    pages.add(page);
  }


  const sortedPages =
    Array.from(pages)
      .sort(
        (a, b) =>
          a - b,
      );


  const result = [];


  sortedPages.forEach(
    (page, index) => {
      if (
        index > 0 &&
        page -
          sortedPages[index - 1] >
          1
      ) {
        result.push(null);
      }


      result.push(page);
    },
  );


  return result;
}


/* ==========================================================================
   Empty State
   ========================================================================== */

function updateEmptyState(isEmpty) {
  const empty =
    document.querySelector(
      SELECTORS.empty,
    );

  const results =
    document.querySelector(
      SELECTORS.results,
    );


  if (empty) {
    empty.hidden =
      !isEmpty;
  }


  results?.classList.toggle(
    "is-empty",
    isEmpty,
  );
}


/* ==========================================================================
   Busy State
   ========================================================================== */

function setBusy(isBusy) {
  const results =
    document.querySelector(
      SELECTORS.results,
    );


  if (!results) {
    return;
  }


  results.setAttribute(
    "aria-busy",
