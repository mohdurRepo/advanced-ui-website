<%@ page import="sa.constants.CalendarType" %>

<fmt:setBundle
  basename="sa.nl.IssuerFinancialCalendarsV2PortletResource"
/>

<portlet:defineObjects />

<%-- =========================================================================
     Calendar Types
     ========================================================================= --%>

<c:set
  var="dividendsCalendarType"
  value="<%=CalendarType.DIVIDENDS_CALENDAR%>"
/>

<c:set
  var="generalMeetingsCalendarType"
  value="<%=CalendarType.GEN_ASSEMBLY_MEETINGS_CALENDAR%>"
/>

<c:set
  var="boardSessionsCalendarType"
  value="<%=CalendarType.DIRECTORS_SESSIONS_CALENDAR%>"
/>

<c:set
  var="corporateActionsCalendarType"
  value="<%=CalendarType.CORPORATE_ACTIONS_CALENDAR%>"
/>

<%-- =========================================================================
     Initial Tab

     A valid server-provided calendar type is respected. Dividends is the safe
     default when calendarType is empty or unsupported.
     ========================================================================= --%>

<c:choose>
  <c:when test="${calendarType eq generalMeetingsCalendarType}">
    <c:set
      var="initialFinancialCalendarTab"
      value="general-meetings"
    />
  </c:when>

  <c:when test="${calendarType eq boardSessionsCalendarType}">
    <c:set
      var="initialFinancialCalendarTab"
      value="board-sessions"
    />
  </c:when>

  <c:when test="${calendarType eq corporateActionsCalendarType}">
    <c:set
      var="initialFinancialCalendarTab"
      value="corporate-actions"
    />
  </c:when>

  <c:otherwise>
    <c:set
      var="initialFinancialCalendarTab"
      value="dividends"
    />
  </c:otherwise>
</c:choose>

<%-- =========================================================================
     Issuer Financial Calendars Hero
     ========================================================================= --%>

<section
  class="hero-section surface-hero"
  aria-labelledby="issuer-financial-calendars-page-title"
>
  <div
    class="hero-section__background"
    aria-hidden="true"
  ></div>

  <div class="container hero-section__content">
    <header class="hero-intro">
      <div class="hero-intro__header">
        <div class="hero-intro__brand">
          <span
            class="hero-intro__icon has-icon icon-tadawul"
            aria-hidden="true"
          ></span>

          <h1
            class="hero-intro__title"
            id="issuer-financial-calendars-page-title"
          >
            <fmt:message key="issuer.financial.calendars.v2.title" />
          </h1>
        </div>
      </div>
    </header>
  </div>
</section>

<%-- =========================================================================
     Issuer Financial Calendars
     ========================================================================= --%>

<section
  class="section issuer-financial-calendars"
  aria-labelledby="issuer-financial-calendars-page-title"
  data-issuer-financial-calendars
  data-initial-calendar-tab="${initialFinancialCalendarTab}"
>
  <div class="container">
    <%-- =====================================================================
         Tabs

         Visual tab behavior, keyboard navigation, ARIA state, and panel
         visibility are owned by the shared design-system tabs controller.

         The page module will observe tab changes only to activate and
         deactivate the corresponding data module.
         ===================================================================== --%>

    <div
      class="tabs"
      data-tabs
      data-tabs-id="issuer-financial-calendars"
    >
      <%-- ===================================================================
           Tab Navigation
           =================================================================== --%>

      <div
        class="tabs-nav"
        role="tablist"
        aria-labelledby="issuer-financial-calendars-page-title"
      >
        <%-- ===============================================================
             Dividends
             =============================================================== --%>

        <button
          class="tab-link${initialFinancialCalendarTab eq 'dividends' ? ' active' : ''}"
          type="button"
          id="issuer-financial-calendars-tab-dividends"
          role="tab"
          aria-selected="${initialFinancialCalendarTab eq 'dividends'}"
          aria-controls="issuer-financial-calendars-panel-dividends"
          data-tab-target="issuer-financial-calendars-panel-dividends"
          data-financial-calendar-tab="dividends"
          tabindex="${initialFinancialCalendarTab eq 'dividends' ? '0' : '-1'}"
        >
          <fmt:message
            key="issuer.financial.calendars.v2.title.dividends"
          />
        </button>

        <%-- ===============================================================
             General Meetings
             =============================================================== --%>

        <button
          class="tab-link${initialFinancialCalendarTab eq 'general-meetings' ? ' active' : ''}"
          type="button"
          id="issuer-financial-calendars-tab-general-meetings"
          role="tab"
          aria-selected="${initialFinancialCalendarTab eq 'general-meetings'}"
          aria-controls="issuer-financial-calendars-panel-general-meetings"
          data-tab-target="issuer-financial-calendars-panel-general-meetings"
          data-financial-calendar-tab="general-meetings"
          tabindex="${initialFinancialCalendarTab eq 'general-meetings' ? '0' : '-1'}"
        >
          <fmt:message
            key="issuer.financial.calendars.v2.title.generalmeetings"
          />
        </button>

        <%-- ===============================================================
             Board Sessions
             =============================================================== --%>

        <button
          class="tab-link${initialFinancialCalendarTab eq 'board-sessions' ? ' active' : ''}"
          type="button"
          id="issuer-financial-calendars-tab-board-sessions"
          role="tab"
          aria-selected="${initialFinancialCalendarTab eq 'board-sessions'}"
          aria-controls="issuer-financial-calendars-panel-board-sessions"
          data-tab-target="issuer-financial-calendars-panel-board-sessions"
          data-financial-calendar-tab="board-sessions"
          tabindex="${initialFinancialCalendarTab eq 'board-sessions' ? '0' : '-1'}"
        >
          <fmt:message
            key="issuer.financial.calendars.v2.title.boraddirectorssessions"
          />
        </button>

        <%-- ===============================================================
             Corporate Actions
             =============================================================== --%>

        <button
          class="tab-link${initialFinancialCalendarTab eq 'corporate-actions' ? ' active' : ''}"
          type="button"
          id="issuer-financial-calendars-tab-corporate-actions"
          role="tab"
          aria-selected="${initialFinancialCalendarTab eq 'corporate-actions'}"
          aria-controls="issuer-financial-calendars-panel-corporate-actions"
          data-tab-target="issuer-financial-calendars-panel-corporate-actions"
          data-financial-calendar-tab="corporate-actions"
          tabindex="${initialFinancialCalendarTab eq 'corporate-actions' ? '0' : '-1'}"
        >
          <fmt:message
            key="issuer.financial.calendars.v2.title.corporateactions"
          />
        </button>
      </div>

      <%-- ===================================================================
           Tab Content

           The four complete tab panels will be inserted inside this
           container. Each panel owns its filter and data-view markup.
           =================================================================== --%>

      <div class="tabs-content tab-content">

                <%-- =================================================================
             Dividends
             ================================================================= --%>

        <section
          class="tab-pane${initialFinancialCalendarTab eq 'dividends' ? ' active' : ''}"
          id="issuer-financial-calendars-panel-dividends"
          role="tabpanel"
          aria-labelledby="issuer-financial-calendars-tab-dividends"
          <c:if test="${initialFinancialCalendarTab ne 'dividends'}">
            hidden
          </c:if>
        >
          <div
            class="stack stack--lg"
            data-issuer-financial-calendars-feature="dividends"
          >
            <%-- =============================================================
                 Dividends Filters
                 ============================================================= --%>

            <form
              class="filter-bar filter-bar--connected"
              aria-labelledby="issuer-financial-calendars-tab-dividends"
              data-dividends-filters
              novalidate
            >
              <div class="filter-bar__inner">
                <div class="filter-bar__fields grid-4">
                  <%-- =======================================================
                       Market
                       ======================================================= --%>

                  <div class="filter-bar__field">
                    <label
                      class="form-label"
                      for="financial-calendars-dividends-market"
                    >
                      <fmt:message
                        key="generalassemblymeeting.markettype"
                      />
                    </label>

                    <div
                      class="custom-select"
                      data-custom-select
                    >
                      <div
                        class="form-select-wrap custom-select__fallback"
                      >
                        <select
                          class="form-select custom-select__native"
                          id="financial-calendars-dividends-market"
                          name="marketsListId"
                          data-dividends-market
                        >
                          <option
                            value="M"
                            <c:if test="${empty requestScope.marketsListId or requestScope.marketsListId eq 'M'}">
                              selected
                            </c:if>
                          >
                            <fmt:message
                              key="generalassemblymeeting.label.market.main"
                            />
                          </option>

                          <option
                            value="S"
                            <c:if test="${requestScope.marketsListId eq 'S'}">
                              selected
                            </c:if>
                          >
                            <fmt:message
                              key="generalassemblymeeting.label.market.nomu"
                            />
                          </option>
                        </select>

                        <span
                          class="form-select-icon has-icon icon-chevron-down"
                          aria-hidden="true"
                        ></span>
                      </div>
                    </div>
                  </div>

                  <%-- =======================================================
                       Sector

                       Options are loaded from getSectors1 according to the
                       selected Market.
                       ======================================================= --%>

                  <div class="filter-bar__field">
                    <label
                      class="form-label"
                      for="financial-calendars-dividends-sector"
                    >
                      <fmt:message key="dividends.sector" />
                    </label>

                    <div
                      class="custom-select"
                      data-custom-select
                    >
                      <div
                        class="form-select-wrap custom-select__fallback"
                      >
                        <select
                          class="form-select custom-select__native"
                          id="financial-calendars-dividends-sector"
                          name="sector"
                          data-initial-value="<c:out value='${requestScope.sector}' />"
                          data-dividends-sector
                        >
                          <option
                            value=""
                            selected
                          >
                            <fmt:message
                              key="generalassemblymeeting.archived.view.all.sectors"
                            />
                          </option>
                        </select>

                        <span
                          class="form-select-icon has-icon icon-chevron-down"
                          aria-hidden="true"
                        ></span>
                      </div>
                    </div>
                  </div>

                  <%-- =======================================================
                       Symbol or Company
                       ======================================================= --%>

                  <div class="filter-bar__field">
                    <label
                      class="form-label"
                      for="financial-calendars-dividends-company"
                    >
                      <fmt:message
                        key="issuer.financial.calendars.v2.table.search"
                      />
                    </label>

                    <input
                      class="form-control"
                      id="financial-calendars-dividends-company"
                      name="symbolorcompany"
                      type="search"
                      value="<c:out value='${requestScope.bySymbol}' />"
                      autocomplete="off"
                      data-dividends-company
                    />
                  </div>

                  <%-- =======================================================
                       Period
                       ======================================================= --%>

                  <div class="filter-bar__field">
                    <label
                      class="form-label"
                      for="financial-calendars-dividends-period"
                    >
                      <fmt:message key="dividends.period" />
                    </label>

                    <div
                      class="custom-select"
                      data-custom-select
                    >
                      <div
                        class="form-select-wrap custom-select__fallback"
                      >
                        <select
                          class="form-select custom-select__native"
                          id="financial-calendars-dividends-period"
                          name="period"
                          data-dividends-period
                        >
                          <option
                            value="CUSTOM"
                            <c:if test="${empty requestScope.period or requestScope.period eq 'CUSTOM'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.customPeriod" />
                          </option>

                          <option
                            value="7"
                            <c:if test="${requestScope.period eq '7'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.oneWeek" />
                          </option>

                          <option
                            value="14"
                            <c:if test="${requestScope.period eq '14'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.twoWeeks" />
                          </option>

                          <option
                            value="30"
                            <c:if test="${requestScope.period eq '30'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.oneMonth" />
                          </option>

                          <option
                            value="90"
                            <c:if test="${requestScope.period eq '90'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.threeMonths" />
                          </option>

                          <option
                            value="180"
                            <c:if test="${requestScope.period eq '180'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.sixMonths" />
                          </option>

                          <option
                            value="270"
                            <c:if test="${requestScope.period eq '270'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.nineMonths" />
                          </option>

                          <option
                            value="365"
                            <c:if test="${requestScope.period eq '365'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.oneYear" />
                          </option>

                          <option
                            value="730"
                            <c:if test="${requestScope.period eq '730'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.twoYears" />
                          </option>

                          <option
                            value="1095"
                            <c:if test="${requestScope.period eq '1095'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.threeYears" />
                          </option>

                          <option
                            value="1825"
                            <c:if test="${requestScope.period eq '1825'}">
                              selected
                            </c:if>
                          >
                            <fmt:message key="dividends.fiveYears" />
                          </option>
                        </select>

                        <span
                          class="form-select-icon has-icon icon-chevron-down"
                          aria-hidden="true"
                        ></span>
                      </div>
                    </div>
                  </div>

                  <%-- =======================================================
                       Time Period

                       Date inputs remain enabled when CUSTOM is selected.
                       The Dividends filter module will disable them when a
                       predefined period is selected.
                       ======================================================= --%>

                  <div
                    class="filter-bar__field"
                    data-dividends-date-field
                  >
                    <span
                      class="form-label-static"
                      id="financial-calendars-dividends-date-label"
                    >
                      <fmt:message
                        key="issuer.financial.calendars.v2.table.search.timeperiod"
                      />
                    </span>

                    <div
                      class="custom-date custom-date--range"
                      aria-labelledby="financial-calendars-dividends-date-label"
                      data-custom-date-range
                      data-clearable
                      data-placeholder="YYYY-MM-DD – YYYY-MM-DD"
                    >
                      <div class="custom-date__fallback">
                        <div class="custom-date__native-range">
                          <input
                            class="form-control custom-date__native"
                            id="financial-calendars-dividends-date-from"
                            name="start"
                            type="date"
                            aria-labelledby="financial-calendars-dividends-date-label"
                            data-date-start
                            data-dividends-date-from
                          />

                          <input
                            class="form-control custom-date__native"
                            id="financial-calendars-dividends-date-to"
                            name="end"
                            type="date"
                            aria-labelledby="financial-calendars-dividends-date-label"
                            data-date-end
                            data-dividends-date-to
                          />
                        </div>

                        <div
                          class="custom-date__initial-trigger"
                          aria-hidden="true"
                        >
                          <span
                            class="custom-date__initial-value is-placeholder"
                          >
                            YYYY-MM-DD – YYYY-MM-DD
                          </span>

                          <span
                            class="custom-date__initial-indicator has-icon icon-calendar-scheduler"
                            aria-hidden="true"
                          ></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <%-- =========================================================
                     Filter Actions
                     ========================================================= --%>

                <div class="filter-bar__actions">
                  <button
                    class="btn btn-outline-primary has-icon icon-sync-refresh"
                    type="reset"
                    data-dividends-reset
                  >
                    <fmt:message
                      key="issuer.trading.info.v2.search.reset"
                    />
                  </button>
                </div>
              </div>
            </form>

            <%-- =============================================================
                 Dividends Results
                 ============================================================= --%>

            <section
              class="data-view data-view--connected"
              aria-labelledby="issuer-financial-calendars-tab-dividends"
              aria-busy="false"
              data-dividends-view
            >
              <div class="data-view__workspace">
                <%-- =========================================================
                     Desktop and Tablet Table
                     ========================================================= --%>

                <div class="data-view__table">
                  <div class="data-view__table-block">
                    <%-- =====================================================
                         Results Toolbar
                         ===================================================== --%>

                    <div class="data-view__toolbar">
                      <div class="data-view__toolbar-start">
                        <p
                          class="data-view__result-count"
                          id="financial-calendars-dividends-results"
                          data-dividends-result-count
                        >
                          <strong>
                            <fmt:message
                              key="issuer.trading.info.results.msg"
                            />
                          </strong>

                          <span data-result-count-value>0</span>
                        </p>
                      </div>
                    </div>

                    <%-- =====================================================
                         Accessible Loading and Result Status
                         ===================================================== --%>

                    <p
                      class="visually-hidden"
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                      data-dividends-status
                    ></p>

                    <%-- =====================================================
                         Results Table
                         ===================================================== --%>

                    <div
                      class="table-shell"
                      data-table-shell
                    >
                      <div
                        class="table-responsive custom-scrollbar"
                        role="region"
                        tabindex="0"
                        aria-labelledby="issuer-financial-calendars-tab-dividends financial-calendars-dividends-results"
                        data-table-scroll
                        data-dividends-table-region
                      >
                        <table
                          class="table table-market table-market--results table-striped table-hover table-nowrap"
                          id="financial-calendars-dividends-table"
                          aria-describedby="financial-calendars-dividends-results"
                          aria-busy="false"
                          data-dividends-table
                        >
                          <caption class="visually-hidden">
                            <fmt:message
                              key="issuer.financial.calendars.v2.title.dividends"
                            />
                          </caption>

                          <thead>
                            <tr>
                              <%-- Symbol is displayed beneath the company name. --%>

                              <th
                                class="table-market__security"
                                scope="col"
                              >
                                <fmt:message
                                  key="issuer.financial.calendars.v2.table.heading.company"
                                />
                              </th>

                              <th
                                class="text-center"
                                scope="col"
                              >
                                <fmt:message
                                  key="issuer.financial.calendars.v2.table.heading.announcementdate"
                                />
                              </th>

                              <th
                                class="text-center"
                                scope="col"
                              >
                                <fmt:message
                                  key="issuer.financial.calendars.v2.table.heading.duedate"
                                />
                              </th>

                              <th
                                class="text-center"
                                scope="col"
                              >
                                <fmt:message
                                  key="issuer.financial.calendars.v2.table.heading.distributionmethod"
                                />
                              </th>

                              <th
                                class="text-center"
                                scope="col"
                              >
                                <fmt:message
                                  key="issuer.financial.calendars.v2.table.heading.distributiondate"
                                />
                              </th>

                              <th
                                class="table-market__number"
                                scope="col"
                                data-numeric
                              >
                                <fmt:message
                                  key="issuer.financial.calendars.v2.table.heading.amount"
                                />
                              </th>
                            </tr>
                          </thead>

                          <tbody>
                            <%--
                              JavaScript renders:

                              - company logo, name, and symbol
                              - announcement date
                              - due date
                              - distribution method
                              - distribution date
                              - dividend amount
                              - loading, empty, and error states
                            --%>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>

                <%-- =========================================================
                     Mobile Cards
                     ========================================================= --%>

                <div
                  class="data-view__cards"
                  role="region"
                  aria-labelledby="issuer-financial-calendars-tab-dividends"
                  data-dividends-mobile
                >
                  <div
                    class="data-view__cards-header"
                    aria-hidden="true"
                  >
                    <span>
                      <fmt:message
                        key="issuer.financial.calendars.v2.table.heading.company"
                      />
                    </span>

                    <span>
                      <fmt:message
                        key="issuer.financial.calendars.v2.table.heading.amount"
                      />
                    </span>
                  </div>

                  <div
                    class="data-view__cards-inner"
                    aria-busy="false"
                    data-dividends-cards
                  >
                    <%--
                      JavaScript renders:

                      - company logo, name, and symbol
                      - dividend amount in the summary
                      - announcement and due dates
                      - distribution method and date
                      - loading, empty, and error states
                    --%>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </section>

                <%-- =================================================================
             General Meetings
             ================================================================= --%>

        <section
          class="tab-pane${initialFinancialCalendarTab eq 'general-meetings' ? ' active' : ''}"
          id="issuer-financial-calendars-panel-general-meetings"
          role="tabpanel"
          aria-labelledby="issuer-financial-calendars-tab-general-meetings"
          <c:if test="${initialFinancialCalendarTab ne 'general-meetings'}">
            hidden
          </c:if>
        >
          <div
            class="stack stack--lg"
            data-issuer-financial-calendars-feature="general-meetings"
          >
            <%-- =============================================================
                 General Meetings Filters
                 ============================================================= --%>

            <form
              class="filter-bar filter-bar--connected"
              aria-labelledby="issuer-financial-calendars-tab-general-meetings"
              data-general-meetings-filters
              novalidate
            >
              <div class="filter-bar__inner">
                <div class="filter-bar__fields grid-4">
                  <%-- =======================================================
                       Market
                       ======================================================= --%>

                  <div class="filter-bar__field">
                    <label
                      class="form-label"
                      for="financial-calendars-general-meetings-market"
                    >
                      <fmt:message
                        key="generalassemblymeeting.markettype"
                      />
                    </label>

                    <div
                      class="custom-select"
                      data-custom-select
                    >
                      <div
                        class="form-select-wrap custom-select__fallback"
                      >
                        <select
                          class="form-select custom-select__native"
                          id="financial-calendars-general-meetings-market"
                          name="marketsListId"
                          data-general-meetings-market
                        >
                          <option
                            value="M"
                            <c:if test="${empty requestScope.marketsListId or requestScope.marketsListId eq 'M'}">
                              selected
                            </c:if>
                          >
                            <fmt:message
                              key="generalassemblymeeting.label.market.main"
                            />
                          </option>

                          <option
                            value="S"
                            <c:if test="${requestScope.marketsListId eq 'S'}">
                              selected
                            </c:if>
                          >
                            <fmt:message
                              key="generalassemblymeeting.label.market.nomu"
                            />
                          </option>
                        </select>

                        <span
                          class="form-select-icon has-icon icon-chevron-down"
                          aria-hidden="true"
                        ></span>
                      </div>
                    </div>
                  </div>

                  <%-- =======================================================
                       Sector

                       Options are loaded from getSectors1 according to the
                       selected Market.
                       ======================================================= --%>

                  <div class="filter-bar__field">
                    <label
                      class="form-label"
                      for="financial-calendars-general-meetings-sector"
                    >
                      <fmt:message
                        key="generalassemblymeeting.archived.view.sector"
                      />
                    </label>

                    <div
                      class="custom-select"
                      data-custom-select
                    >
                      <div
                        class="form-select-wrap custom-select__fallback"
                      >
                        <select
                          class="form-select custom-select__native"
                          id="financial-calendars-general-meetings-sector"
                          name="sector"
