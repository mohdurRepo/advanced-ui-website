<%-- =========================================================================
     Initial Date Values

     Initialize the native date inputs before the design-system CustomDate
     component enhances them.

     The legacy page used a five-year default range. The values are stored as
     ISO dates in the native inputs and converted to the service DD-MM-YYYY
     format by each tab filter module.
     ========================================================================= --%>

<script>
  (() => {
    "use strict";

    const root = document.querySelector(
      "[data-issuer-financial-calendars]",
    );

    if (!root) {
      return;
    }

    function toIsoDate(date) {
      const year = date.getFullYear();

      const month = String(
        date.getMonth() + 1,
      ).padStart(2, "0");

      const day = String(
        date.getDate(),
      ).padStart(2, "0");

      return `${year}-${month}-${day}`;
    }

    const today = new Date();

    const fromDate = new Date(
      today.getFullYear() - 5,
      today.getMonth(),
      today.getDate(),
    );

    const fromValue = toIsoDate(fromDate);

    const toValue = toIsoDate(today);

    root
      .querySelectorAll("[data-date-start]")
      .forEach((input) => {
        if (!input.value) {
          input.value = fromValue;
        }

        input.defaultValue = input.value;
      });

    root
      .querySelectorAll("[data-date-end]")
      .forEach((input) => {
        if (!input.value) {
          input.value = toValue;
        }

        input.defaultValue = input.value;
      });
  })();
</script>

