/* =========================================================
   Dependent Dropdown Manager
   Shared across platform
========================================================= */
 
(function (window, document) {
  "use strict";
 
  /* =========================================================
     AJAX
  ========================================================= */
 
  function requestJSON(url, params, method) {
    method = (method || "GET").toUpperCase();
 
    if (method === "POST") {
      return fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Requested-With": "XMLHttpRequest"
        },
        body: JSON.stringify(params || {})
      }).then(handleResponse);
    }
 
    const qs = new URLSearchParams(params || {}).toString();
    const fullUrl = qs ? url + (url.includes("?") ? "&" : "?") + qs : url;
 
    return fetch(fullUrl, {
      method: "GET",
      headers: {
        "X-Requested-With": "XMLHttpRequest"
      }
    }).then(handleResponse);
  }
 
  function handleResponse(res) {
    if (!res.ok) {
      throw new Error("HTTP " + res.status);
    }
    return res.json();
  }
 
  /* =========================================================
     Helpers
  ========================================================= */
 
  function rebuildDropdown(shell, items, mapFn, placeholder) {
    if (!shell) return;
 
    const list = shell.querySelector(".form-select-list");
    const valueEl = shell.querySelector(".form-select-value");
    const hidden = shell.querySelector("input[type='hidden']");
 
    if (!list) return;
 
    list.innerHTML = "";
 
    if (hidden) hidden.value = "";
 
    if (valueEl) {
      valueEl.textContent = placeholder || "All";
      valueEl.classList.add("is-placeholder");
    }
 
    /* default option */
 
    const defaultOpt = document.createElement("div");
    defaultOpt.className = "form-select-option";
    defaultOpt.dataset.value = "";
    defaultOpt.textContent = placeholder || "All";
 
    list.appendChild(defaultOpt);
 
    /* append items */
 
    (items || []).forEach(function (item) {
 
      const mapped = mapFn ? mapFn(item) : item;
 
      if (!mapped || mapped.value == null) return;
 
      const opt = document.createElement("div");
 
      opt.className = "form-select-option";
      opt.dataset.value = mapped.value;
      opt.textContent = mapped.label;
 
      list.appendChild(opt);
 
    });
  }
 
  function getActiveFilterGroups() {
    return Array.from(
      document.querySelectorAll("[data-filters-for].is-active:not([hidden])")
    );
  }
 
  function resolveScope(shell) {
    return (
      shell.closest("[data-filters-for]") ||
      shell.closest(".tabs-container") ||
      document
    );
  }
 
  /* =========================================================
     Dependency Processing
  ========================================================= */
 
  function processDependency(sourceShell, value) {
 
    const field = sourceShell.dataset.field;
 
    if (!window.DROPDOWN_CONFIG || !window.DROPDOWN_CONFIG[field]) return;
 
    const config = window.DROPDOWN_CONFIG[field];
 
    const scope = resolveScope(sourceShell);
 
    (config.targets || []).forEach(function (targetCfg) {
 
      const targetShell = scope.querySelector(
        '[data-field="' + targetCfg.field + '"]'
      );
 
      if (!targetShell) return;
 
      const params =
        typeof targetCfg.params === "function"
          ? targetCfg.params(value, sourceShell)
          : targetCfg.params || {};
 
      /* allow skipping API call */
 
      if (params === false) {
        console.log("Dropdown dependency skipped:", targetCfg.field);
        return;
      }
 
      requestJSON(targetCfg.url, params, targetCfg.method)
        .then(function (response) {
 
          const items = Array.isArray(response)
            ? response
            : response.data || [];
 
          const placeholder =
            typeof targetCfg.placeholder === "function"
              ? targetCfg.placeholder(value)
              : allLabel ;
 
          rebuildDropdown(
            targetShell,
            items,
            targetCfg.map,
            placeholder
          );
 
        })
        .catch(function (err) {
          console.error("[DropdownManager]", err);
        });
 
    });
  }
 
  /* =========================================================
     Initialize dropdowns when tab opens
  ========================================================= */
 
  function initializeGroup(group) {
 
    if (!window.DROPDOWN_CONFIG || !group) return;
 
    Object.keys(window.DROPDOWN_CONFIG).forEach(function (field) {
 
      const rule = window.DROPDOWN_CONFIG[field];
 
      if (!rule.init) return;
 
      const shell = group.querySelector('[data-field="' + field + '"]');
 
      if (!shell) return;
 
      if (shell.dataset.ddInitialized) return;
 
      shell.dataset.ddInitialized = "1";
 
      const hidden = shell.querySelector("input[type='hidden']");
      const value = hidden ? hidden.value : "";
 
      processDependency(shell, value);
 
    });
  }
 
  /* =========================================================
     Events
  ========================================================= */
 
  document.addEventListener("form:select-change", function (e) {
 
    const shell = e.target.closest("[data-select]");
 
    if (!shell) return;
 
    const value = e.detail?.value || "";
 
    processDependency(shell, value);
 
  });
 
  document.addEventListener("DOMContentLoaded", function () {
 
    getActiveFilterGroups().forEach(initializeGroup);
 
  });
 
  document.addEventListener("tab:prepare", function () {
 
    getActiveFilterGroups().forEach(initializeGroup);
 
  });
 
})(window, document);


/* datatable-page-utils.js
 * ======================================================
 * Reusable page utilities for DataTableCore modules
 * Works with DataTableCore.render + DataTableCore.plugins
 * ======================================================
 */
 
(function (window, document) {
  "use strict";
 
  function create(config) {
    var CONFIG = config || {};
 
    function getTableConfig(key) {
      return (CONFIG.tables && CONFIG.tables[key]) || {};
    }
 
    function getLabel(value, fallback) {
      return value || fallback || "";
    }
 
    function mergeOptions(base, extra) {
      return Object.assign({}, base || {}, extra || {});
    }
 
    function getNoDataImageUrl() {
      return (CONFIG.ui && CONFIG.ui.empty && CONFIG.ui.empty.imageUrl) || "";
    }
 
    function formatDateDDMMYYYY(dateObj) {
      var dd = String(dateObj.getDate()).padStart(2, "0");
      var mm = String(dateObj.getMonth() + 1).padStart(2, "0");
      var yyyy = dateObj.getFullYear();
 
      return dd + "-" + mm + "-" + yyyy;
    }
 
    function getDefaultDateRange() {
      var today = new Date();
      var from = new Date(today);
 
      from.setMonth(from.getMonth() - 1);
 
      return {
        fromDate: formatDateDDMMYYYY(from),
        toDate: formatDateDDMMYYYY(today)
      };
    }
 
    function setDefaultDatesInGroup(group) {
      if (!group) return;
 
      var enabled =
        CONFIG.defaults &&
        CONFIG.defaults.dateRange &&
        CONFIG.defaults.dateRange.enabled !== false;
 
      if (!enabled) return;
 
      var range = getDefaultDateRange();
 
      var fromInput = group.querySelector('[data-filter="fromDate"]');
      var toInput = group.querySelector('[data-filter="toDate"]');
 
      if (fromInput && !fromInput.value) fromInput.value = range.fromDate;
      if (toInput && !toInput.value) toInput.value = range.toDate;
    }
 
    function setDefaultDatesForAllGroups(scope) {
      (scope || document)
        .querySelectorAll(".banner-filters__group")
        .forEach(setDefaultDatesInGroup);
    }
 
    function ensureTableUi(selector) {
      var table = document.querySelector(selector);
      if (!table || !table.id) return null;
 
      var existing = document.querySelector(
        '[data-table-ui-for="' + table.id + '"]'
      );
 
      if (existing) {
        return {
          wrapper: existing,
          loader: existing.querySelector("[data-feed-loader]"),
          empty: existing.querySelector("[data-feed-empty]"),
          pagination: existing.querySelector("[data-feed-pagination]")
        };
      }
 
      var ui = CONFIG.ui || {};
      var pagination = ui.pagination || {};
      var paginationClass = getLabel(pagination.className, "feed__pagination");
 
      var wrapper = document.createElement("div");
      wrapper.setAttribute("data-table-ui-for", table.id);
 
      wrapper.innerHTML =
        '<div class="feed__loader is-hidden" data-feed-loader>' +
        '<div class="datatable-loader">' +
        '<div class="datatable-spinner"></div>' +
        "<span>" +
        getLabel(ui.loader && ui.loader.text, "Loading data...") +
        "</span>" +
        "</div>" +
        "</div>" +
 
        '<div class="feed__empty is-hidden" data-feed-empty></div>' +
 
        '<div class="' +
        paginationClass +
        ' is-hidden" data-feed-pagination>' +
        '<div class="feed__page-range" data-feed-range>0–0 of 0</div>' +
        '<div class="feed__page-controls">' +
        '<span class="feed__page-label">' +
        getLabel(pagination.pageText, "Page") +
        "</span> " +
        '<select class="feed__select" data-feed-page></select> ' +
        "<span>" +
        getLabel(pagination.ofText, "of") +
        ' <strong data-feed-total-pages>1</strong>' +
        "</span>" +
        '<button class="feed__page-btn" data-feed-prev disabled aria-label="' +
        getLabel(pagination.prevAriaLabel, "Previous page") +
        '">' +
        '<span class="se-icon icon-md icon-arrow" aria-hidden="true"></span>' +
        "</button>" +
        '<button class="feed__page-btn" data-feed-next disabled aria-label="' +
        getLabel(pagination.nextAriaLabel, "Next page") +
        '">' +
        '<span class="se-icon icon-md icon-arrow" aria-hidden="true"></span>' +
        "</button>" +
        "</div>" +
        "</div>";
 
      table.insertAdjacentElement("afterend", wrapper);
 
      return {
        wrapper: wrapper,
        loader: wrapper.querySelector("[data-feed-loader]"),
        empty: wrapper.querySelector("[data-feed-empty]"),
        pagination: wrapper.querySelector("[data-feed-pagination]")
      };
    }
 
    function getDataTableWrapper(tableEl) {
      if (!tableEl || !tableEl.id) return null;
 
      return (
        document.getElementById(tableEl.id + "_wrapper") ||
        tableEl.closest(".dt-container, .dataTables_wrapper")
      );
    }
 
function setTableVisible(tableEl, visible) {
      if (!tableEl) return;
 
      tableEl.hidden = !visible;
 
      var wrapper = getDataTableWrapper(tableEl);
 
      if (wrapper) {
        wrapper.hidden = !visible;
        wrapper.style.display = visible ? "" : "none";
      }
    }
 
    function resetPaginationUi(ui) {
      if (!ui || !ui.wrapper) return;
 
      var range = ui.wrapper.querySelector("[data-feed-range]");
      var page = ui.wrapper.querySelector("[data-feed-page]");
      var total = ui.wrapper.querySelector("[data-feed-total-pages]");
      var prev = ui.wrapper.querySelector("[data-feed-prev]");
      var next = ui.wrapper.querySelector("[data-feed-next]");
 
      if (range) range.textContent = "0–0 of 0";
      if (page) page.innerHTML = "";
      if (total) total.textContent = "1";
      if (prev) prev.disabled = true;
      if (next) next.disabled = true;
    }
 
    function setTableLoading(key, loading) {
      var table = getTableConfig(key);
      if (!table.selector) return;
 
      var tableEl = document.querySelector(table.selector);
      var ui = ensureTableUi(table.selector);
 
      if (!tableEl || !ui) return;
 
      if (ui.loader) ui.loader.classList.toggle("is-hidden", !loading);
 
      if (loading) {
        if (ui.empty) ui.empty.classList.add("is-hidden");
        if (ui.pagination) ui.pagination.classList.add("is-hidden");
        setTableVisible(tableEl, false);
      }
    }
 
    function syncEmptyState(selector, rows) {
        var tableEl = document.querySelector(selector);
        var ui = ensureTableUi(selector);
     
        if (!tableEl || !ui) return;
     
        var hasData = Array.isArray(rows) && rows.length > 0;
     
        setTableVisible(tableEl, true);
     
        if (ui.empty) ui.empty.classList.add("is-hidden");
        if (ui.pagination) ui.pagination.classList.toggle("is-hidden", !hasData);
        if (ui.loader) ui.loader.classList.add("is-hidden");
     
        if (!hasData) resetPaginationUi(ui);
    }
 
    function getFixedHeaderFeature(key) {
      var table = getTableConfig(key);
      var defaults = CONFIG.defaults && CONFIG.defaults.dataTable;
 
      if (table.fixedHeader !== undefined) return table.fixedHeader;
      if (defaults && defaults.fixedHeader !== undefined) return defaults.fixedHeader;
 
      return true;
    }
 
    function tableFeatures(key, selector) {
      var ui = CONFIG.ui || {};
      var tableUi = ensureTableUi(selector);
      var features = {};
      var fixedHeader = getFixedHeaderFeature(key);
 
      if (fixedHeader !== false) {
        features.fixedHeader = fixedHeader;
      }
 
      if (ui.loader && ui.loader.enabled !== false) {
        features.loader = true;
      }
 
      if (
        ui.pagination &&
        ui.pagination.enabled !== false &&
        tableUi &&
        tableUi.pagination
      ) {
        features.feedPagination = {
          container: tableUi.pagination
        };
      }
 
      return features;
    }
 
function tableOptions(key, extra) {
      var defaults =
        CONFIG.defaults && CONFIG.defaults.dataTable
          ? CONFIG.defaults.dataTable
          : {};
 
      var table = getTableConfig(key);
 
      var options = mergeOptions(
        mergeOptions(defaults, {
          pageLength: table.pageLength,
          lengthMenu: table.lengthMenu,
          paging: table.paging,
          ordering: table.ordering
        }),
        extra
      );
 
      /*
       * FixedHeader is intentionally removed from raw dtOptions.
       * It is passed through features.fixedHeader so your DataTableCore
       * fixedHeader plugin owns offset + lifecycle.
       */
      delete options.fixedHeader;
 
      return options;
    }
 
    function adjustTable(key) {
      var table = getTableConfig(key);
      if (!table.selector) return;
 
      var instance = window.DataTableCore.getInstance(table.selector);
      if (!instance) return;
 
      setTimeout(function () {
        instance.columns.adjust();
 
        if (instance.fixedHeader && instance.fixedHeader.adjust) {
          instance.fixedHeader.adjust();
        }
      }, 0);
    }
 
    function safeDestroyTable(tableEl) {
      if (!tableEl) return;
 
      var instance = window.DataTableCore.getInstance(tableEl);
      if (!instance) return;
 
      try {
        instance.destroy(false);
        window.DataTableCore.registry.remove(tableEl);
      } catch (e) {
        console.warn("DataTable safe destroy failed:", tableEl, e);
      }
    }
 
    function destroyHiddenTables(scope) {
      (scope || document)
        .querySelectorAll(
          ".tab-content__panel[hidden] table, [data-variant][hidden] table"
        )
        .forEach(safeDestroyTable);
    }
 
    function renderTable(key, options) {
      options = options || {};
 
      var table = getTableConfig(key);
      var selector = table.selector;
 
      if (!selector) {
        console.warn("Missing table selector for:", key);
        return null;
      }
 
      var rows = Array.isArray(options.data) ? options.data : [];
      var tableEl = document.querySelector(selector);
 
      setTableLoading(key, false);
      syncEmptyState(selector, rows);
 
      if (!rows.length) {
    	    var existing = window.DataTableCore.getInstance(selector);
    	 
    	    if (existing) {
    	        existing.clear();
    	        existing.page(0).draw(false);
    	        return existing;
    	    }
    	}
 
      if (tableEl) setTableVisible(tableEl, true);
 
      var instance = window.DataTableCore.render({
        target: selector,
        columns: options.columns,
        data: rows,
        features: tableFeatures(key, selector),
        dtOptions: tableOptions(key, options.dtOptions),
        locale: CONFIG.locale || "en"
      });
 
      adjustTable(key);
 
      return instance;
    }
 
    function onShow(key) {
      adjustTable(key);
    }
 
    function showVariant(panel, key) {
      if (!panel) return;
 
      panel.querySelectorAll("[data-variant]").forEach(function (variant) {
        variant.hidden = variant.getAttribute("data-variant") !== key;
      });
 
      destroyHiddenTables(panel);
    }
 
    function safeCell(value) {
      return value == null ? "" : value;
    }
 
    function safeUrl(url) {
      return url && url !== "0" ? url : "";
    }
 
    function linkRenderer(label, url, className) {
      if (!label) return "";
 
      var href = safeUrl(url);
 
      if (!href) return safeCell(label);
 
      return (
        '<a class="' +
        (className || "") +
        '" href="' +
        href +
        '">' +
        safeCell(label) +
        "</a>"
      );
    }
 
    function formatQuantitySafe(value) {
      if (value == null || value === "") return "";
 
      var num = parseFloat(String(value).replace(/,/g, ""));
 
      if (isNaN(num)) return value;
 
      return typeof num.formatQuantity === "function"
        ? num.formatQuantity()
        : num.toLocaleString();
    }
 
    function formatMoneySafe(value) {
      if (value == null || value === "" || Number(value) === 0) return "-";
      if (Number(value) === -1) return "";
 
      var num = parseFloat(String(value).replace(/,/g, ""));
 
      if (isNaN(num)) return value;
 
      return typeof num.formatMoney === "function"
        ? num.formatMoney()
        : num.toLocaleString(undefined, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          });
    }
 
    function resetSelectUi(select) {
      if (!select) return;
 
      var hidden = select.querySelector("[data-filter]");
      var valueBox = select.querySelector(".form-select-value");
 
      if (!hidden) return;
 
      var defaultValue = hidden.getAttribute("data-default") || hidden.value;
      var option = select.querySelector(
        '.form-select-option[data-value="' + defaultValue + '"]'
      );
 
      hidden.value = defaultValue;
 
      select.querySelectorAll(".form-select-option").forEach(function (opt) {
    	  opt.removeAttribute("data-selected");
    	  opt.classList.remove("is-selected", "is-focused");
    	});
    	 
    	if (option) {
    	  option.setAttribute("data-selected", "true");
    	  option.classList.add("is-selected");
    	 
    	  if (valueBox) {
    	    valueBox.innerHTML = option.innerHTML;
    	    valueBox.classList.remove("is-placeholder");
    	  }
    	}
    }
 
    function resetFilterGroup(group) {
      if (!group) return;
 
      var range = getDefaultDateRange();
 
      var from = group.querySelector('[data-filter="fromDate"]');
      var to = group.querySelector('[data-filter="toDate"]');
 
      if (from) from.value = range.fromDate;
      if (to) to.value = range.toDate;
 
      group.querySelectorAll("[data-select]").forEach(resetSelectUi);
 
      group.querySelectorAll("[data-filter]").forEach(function (el) {
        el.dispatchEvent(
          new Event("change", {
            bubbles: true
          })
        );
      });
 
      group.dispatchEvent(
        new CustomEvent("filters:reset", {
          bubbles: true,
          detail: {
            group: group
          }
        })
      );
    }
 
    function bindResetFilters(scope) {
      (scope || document).addEventListener("click", function (e) {
        var btn = e.target.closest("[data-reset-filters]");
        if (!btn) return;
 
        var group = btn.closest(".banner-filters__group");
        resetFilterGroup(group);
      });
    }
 
    function bindDateStartBlock(scope) {
      (scope || document).addEventListener(
        "change",
        function (e) {
          if (!e.target.matches('[data-date-start][data-filter="fromDate"]')) {
            return;
          }
 
          e.stopImmediatePropagation();
        },
        true
      );
    }
 
    return {
      getTableConfig: getTableConfig,
      getDefaultDateRange: getDefaultDateRange,
      setDefaultDatesForAllGroups: setDefaultDatesForAllGroups,
 
      ensureTableUi: ensureTableUi,
      setTableLoading: setTableLoading,
      renderTable: renderTable,
      onShow: onShow,
      showVariant: showVariant,
      destroyHiddenTables: destroyHiddenTables,
 
      safeCell: safeCell,
      safeUrl: safeUrl,
      linkRenderer: linkRenderer,
      formatQuantitySafe: formatQuantitySafe,
      formatMoneySafe: formatMoneySafe,
 
      resetFilterGroup: resetFilterGroup,
      bindResetFilters: bindResetFilters,
      bindDateStartBlock: bindDateStartBlock
    };
  }
 
  window.DataTablePageUtils = {
    create: create
  };
})(window, document);
 /* derivative-negotiated-datatables.js
* ======================================================
* Derivative Negotiated Deals module
* Single table, no tabs
* Requires:
* - DataTableCore
* - DataTablePageUtils
* - dropdown-update.js
* ======================================================
*/
 
(function (window, document) {
  "use strict";
  var zebraIndex = 0;
  var CONFIG = window.DERIVATIVE_NEGOTIATED_DATATABLE_CONFIG || {};
  var U = window.DataTablePageUtils.create(CONFIG);
 
  var TABLE_KEY = "negotiatedDeals";
  var refreshTimer = null;
  var isLoading = false;
 
  function getTotalLabel() {
	  return CONFIG.labels && CONFIG.labels.total
	    ? CONFIG.labels.total
	    : "Total";
	}
  
  function normalizeResponse(response) {
    if (!response) return [];
 
    if (typeof response === "string") {
      try {
        return normalizeResponse(JSON.parse(response));
      } catch (e) {
        console.error("[DerivativeNegotiated] Invalid JSON response:", response);
        return [];
      }
    }
 
    if (Array.isArray(response)) return response;
    if (Array.isArray(response.data)) return response.data;
    if (Array.isArray(response.rows)) return response.rows;
 
    return [];
  }
 
  function getFilters(scope) {
    var root = scope || document;
    var out = {};
 
    root.querySelectorAll("[data-filter]").forEach(function (el) {
      var key = el.dataset.filter;
      if (!key) return;
 
      if (el.type === "checkbox") {
        out[key] = el.checked ? el.value : "";
      } else if (el.type === "radio") {
        if (el.checked) out[key] = el.value;
      } else {
        out[key] = el.value;
      }
    });
 
    return out;
  }
 
  function buildUrl(url, params) {
    if (!params || !Object.keys(params).length) return url;
 
    var qs = new URLSearchParams(params).toString();
 
    return url + (url.indexOf("?") > -1 ? "&" : "?") + qs;
  }
 
  function updateResultCount(rows) {
    var selector =
      CONFIG.resultCounters && CONFIG.resultCounters.negotiatedDeals
        ? CONFIG.resultCounters.negotiatedDeals
        : "#derivativeNegotiatedResultsId";
 
    var el = document.querySelector(selector);
    if (!el) return;
 
    if (Array.isArray(rows) && rows.length && rows[0].count != null) {
      el.textContent = rows[0].count;
      return;
    }
 
    el.textContent = Array.isArray(rows) ? rows.length : 0;
  }
 
  function parseDateSafe(value) {
    if (!value || String(value).indexOf("/") === -1) return U.safeCell(value);
 
    var date = new Date(value);
    if (isNaN(date.getTime())) return U.safeCell(value);
 
    var dd = String(date.getDate()).padStart(2, "0");
    var mm = String(date.getMonth() + 1).padStart(2, "0");
    var yyyy = date.getFullYear();
 
    return dd + "-" + mm + "-" + yyyy;
  }
 
  function moneyOrDash(value) {
    if (value == null || value === "" || Number(value) === 0) return "-";
    if (Number(value) === -1) return "";
 
    return U.formatMoneySafe(value);
  }
 
  function quantityOrDash(value) {
    if (value == null || value === "" || Number(value) === 0) return "-";
 
    return U.formatQuantitySafe(value);
  }
 
  function getRequestParams(filters) {
    var range = U.getDefaultDateRange();
 
    return {
      fromDate: filters.fromDate || range.fromDate,
      toDate: filters.toDate || range.toDate,
      contract: filters.contract || "All",
      sector: filters.category || "All",
      requestLocale: CONFIG.locale || "en"
    };
  }
  zebraIndex = 0;
  function renderTable(rows) {
    U.renderTable(TABLE_KEY, {
      data: rows,
