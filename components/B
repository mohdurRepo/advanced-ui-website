            return r && r.rowType === "total" ? "" : parseDateSafe(d);
          }
        },
        {
          data: "company",
          className: "align",
          render: function (d, t, r) {
            if (r && r.rowType === "total") {
            	return '<strong class="table-total-label">' + getTotalLabel() + '</strong>';
            	}
 
            return U.linkRenderer(d, r.companyURL, "ellipsis");
          }
        },
        {
          data: "tradePrice",
          className: "numeric",
          render: function (d, t, r) {
            return r && r.rowType === "total" ? "" : moneyOrDash(d);
          }
        },
        {
          data: "tradeVolume",
          className: "numeric",
          render: quantityOrDash
        },
        {
          data: "turnOver",
          className: "numeric",
          render: U.formatMoneySafe
        },
        {
          data: "strTime",
          className: "dt-nowrap",
          render: function (d, t, r) {
            return r && r.rowType === "total" ? "" : U.safeCell(d);
          }
        }
      ],
      dtOptions: {
        paging: true,
        pageLength: 25,
        lengthMenu: [25, 50, 100],
        ordering: false,
        searching: false,
        info: false,
        dom: "rt",
        scrollX: true,
        scrollCollapse: true,
 
        createdRow: function (row, data) {
        	  if (data && data.rowType === "total") {
        	    row.classList.add("table-total-row");
        	    return;
        	  }
        	 
        	  if (zebraIndex % 2 === 0) {
        		    row.classList.add("is-odd");
        		  } else {
        		    row.classList.add("is-even");
        		  }
        	 
        	  zebraIndex++;
        	},
 
        initComplete: function () {
          updateResultCount(rows);
        }
      }
    });
 
    updateResultCount(rows);
    U.onShow(TABLE_KEY);
  }
 
  function loadData() {
    if (isLoading) return;
 
    var filterRoot = document.querySelector(CONFIG.filtersSelector) || document;
    var filters = getFilters(filterRoot);
    var params = getRequestParams(filters);
 
    isLoading = true;
    U.setTableLoading(TABLE_KEY, true);
 
    fetch(buildUrl(CONFIG.urls.negotiatedDeals, params), {
      method: "GET",
      headers: {
        "X-Requested-With": "XMLHttpRequest"
      }
    })
      .then(function (res) {
        if (!res.ok) throw new Error("HTTP " + res.status);
        return res.json();
      })
      .then(function (response) {
        var rows = normalizeResponse(response);
        renderTable(rows);
      })
      .catch(function (err) {
        console.error("[DerivativeNegotiated]", err);
        renderTable([]);
      })
      .finally(function () {
        isLoading = false;
        U.setTableLoading(TABLE_KEY, false);
      });
  }
 
  function scheduleLoad() {
    clearTimeout(refreshTimer);
 
    refreshTimer = setTimeout(function () {
      loadData();
    }, 200);
  }
 
  function bindFilters(scope) {
    var root = scope || document;
 
    root.addEventListener("form:select-change", scheduleLoad);
 
    root.addEventListener("change", function (e) {
      if (e.target && e.target.matches("[data-filter]")) {
        scheduleLoad();
      }
    });
 
    root.addEventListener("filters:reset", scheduleLoad);
  }
 
  function initDerivativeNegotiated() {
    var filterRoot = document.querySelector(CONFIG.filtersSelector) || document;
 
    if (!window.DataTableCore || !window.DataTablePageUtils) {
      return;
    }
 
    U.setDefaultDatesForAllGroups(document);
    U.bindResetFilters(filterRoot);
    U.bindDateStartBlock(filterRoot);
 
    bindFilters(filterRoot);
 
    loadData();
  }
 
  document.addEventListener("DOMContentLoaded", initDerivativeNegotiated);
})(window, document);