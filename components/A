<portlet:renderURL var="negotiatedDealsRenderURL">
	<portlet:param
		name="<%=IssuerTradingInformationConstants.ACTION_TARGET%>"
		value="<%=IssuerTradingInformationConstants.NEGOTIATED_DEALS_SEARCH_ACTION%>" />
</portlet:renderURL>

<input type="hidden" id="requestLocale" name="requestLocale"
       value="${pageContext.request.locale.language}" />
 
<section class="app-container hero-banner-section">
  <div class="profile-banner animate__animated animate__fadeIn">
    <div class="profile-banner--pattern">
      <div class="row">
 
        <div class="col-12">
          <h2>
            <svg class="pc-icon pr-3 link-icon me-3" width="40" height="40"
                 style="color:#fff;fill:#fff">
              <use xlink:href="#tadawul-arrow-icon"></use>
            </svg>
 
            <label style="color:#FFFFFF">
              <fmt:message key="issuer.trading.info.v2.title.negotiated" />
            </label>
          </h2>
 
          <p style="color:#FFFFFF">
            <fmt:message key="issuer.trading.info.v2.description" />
          </p>
        </div>
 
        <section class="banner-filters" id="derivativeNegotiatedFilters">
          <div class="banner-filters__group is-active">
 
            <div class="row mt-2">
 
              <!-- Category -->
              <div class="col-12 col-lg-3 col-md-3 col-sm-6 col-xm-12">
                <div class="form-field">
                  <label class="form-label">
                    <fmt:message key="issuer.trading.info.v2.section.heading.category" />
                  </label>
 
                  <div class="form-control-shell is-select"
                       tabindex="0"
                       data-select
                       data-field="category">
 
                    <div class="form-select-value is-placeholder">
                      <fmt:message key="derivative.allContractCombo" />
                    </div>
 
                    <input type="hidden"
                           name="category"
                           data-filter="category"
                           value="All"
                           data-default="All" />
 
                    <span class="form-suffix form-select-arrow" aria-hidden="true"></span>
 
                    <div class="form-popover">
                      <div class="form-select-panel">
                        <div class="form-select-list">
 
                          <div class="form-select-option"
                               data-value="All"
                               data-selected="true">
                            <fmt:message key="derivative.allContractCombo" />
                          </div>
 
                          <c:forEach items="${requestScope.contractsresultlBean.allSectors}"
                                     var="sectors">
                            <div class="form-select-option"
                                 data-value="${sectors.symbol}">
                              ${sectors.name}
                            </div>
                          </c:forEach>
 
                        </div>
                      </div>
                    </div>
 
                  </div>
                </div>
              </div>
 
              <!-- Contract -->
              <div class="col-12 col-lg-3 col-md-3 col-sm-6 col-xm-12">
                <div class="form-field">
                  <label class="form-label">
                    <fmt:message key="derivative.selectContractssLabel" />
                  </label>
 
                  <div class="form-control-shell is-select"
                       tabindex="0"
                       data-select
                       data-field="contract">
 
                    <div class="form-select-value is-placeholder">
                      <fmt:message key="derivative.allContractCombo" />
                    </div>
 
                    <input type="hidden"
                           name="contract"
                           data-filter="contract"
                           value="All"
                           data-default="All" />
 
                    <span class="form-suffix form-select-arrow" aria-hidden="true"></span>
 
                    <div class="form-popover">
                      <div class="form-select-panel">
                        <div class="form-select-list">
 
                          <div class="form-select-option"
                               data-value="All"
                               data-selected="true">
                            <fmt:message key="derivative.allContractCombo" />
                          </div>
 
                          <c:forEach items="${requestScope.contractsresultlBean.companyList}"
                                     var="contracts">
                            <div class="form-select-option"
                                 data-value="${contracts.symbol}"
                                 <c:if test="${requestScope.contract eq contracts.symbol}">
                                   data-selected="true"
                                 </c:if>>
                              ${contracts.longName}
                            </div>
                          </c:forEach>
 
                        </div>
                      </div>
                    </div>
 
                  </div>
                </div>
              </div>
 
              <!-- Date Range -->
              <div class="col-12 col-lg-3 col-md-3 col-sm-6 col-xm-12">
                <div class="form-field">
                  <label class="form-label">
                    <fmt:message key="issuer.trading.info.v2.section.heading.timeperiod" />
                  </label>
 
                  <div class="form-control-shell form-date-range is-date"
                       data-date-range>
                    <input type="text"
                           name="fromDate"
                           data-filter="fromDate"
                           class="form-date-input"
                           placeholder="DD-MM-YYYY"
                           readonly
                           data-date-start />
 
                    <span class="form-date-range-separator" aria-hidden="true">-</span>
 
                    <input type="text"
                           name="toDate"
                           data-filter="toDate"
                           class="form-date-input"
                           placeholder="DD-MM-YYYY"
                           readonly
                           data-date-end />
 
                    <span class="form-suffix form-date-icon"></span>
                  </div>
                </div>
              </div>
 
              <!-- Reset -->
              <div class="col-12 col-lg-3 col-md-3 col-sm-6 col-xm-12">
                <div class="form-field d-flex justify-content-lg-end align-items-end h-100">
                  <button type="button"
                          class="se-btn se-btn--banner"
                          data-reset-filters>
                    <span>
                      <fmt:message key="issuer.trading.info.v2.search.reset" />
                    </span>
                    <span class="se-btn__icon se-btn__icon--refresh se-icon icon-custom-refresh-cycle icon-md"></span>
                  </button>
                </div>
              </div>
 
            </div>
          </div>
        </section>
 
      </div>
    </div>
  </div>
 
  <div class="intro-section">
    <section class="app-container mt-5">
 
      <div class="resultBox">
        <div class="resultFst">
          <div class="resultShow">
            <fmt:message key="issuer.trading.info.results.msg" />:
            <span id="derivativeNegotiatedResultsId">0</span>
          </div>
        </div>
      </div>
 
      <div class="tradingTable historicalTable">
        <table id="derivativeNegotiatedTable"
               class="table table-striped table-bordered"
               cellspacing="0"
               width="100%">
          <thead>
            <tr>
              <th><fmt:message key="issuer.trading.info.v2.table.heading.date" /></th>
              <th><fmt:message key="derivative.selectContractssLabel" /></th>
              <th><fmt:message key="issuer.trading.info.v2.table.heading.price" /></th>
              <th><fmt:message key="issuer.trading.info.v2.table.heading.volumetraded" /></th>
              <th><fmt:message key="issuer.trading.info.v2.table.heading.valuetraded" /></th>
              <th><fmt:message key="issuer.trading.info.v2.table.heading.time" /></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
 
    </section>
  </div>
</section>
 
<script>
window.DROPDOWN_CONFIG = {
  category: {
    targets: [
      {
        field: "contract",
        url: '<portlet:resourceURL id="getContractsByCategory" />',
        method: "GET",
        params: function (categoryValue) {
          return {
            format: "json",
            category: categoryValue
          }
        },
        map: function (item) {
          return {
            value: item.symbol,
            label: item.longName
          };
        }
      }
    ]
  }
};
</script>
 
<script>
window.allLabel= "<fmt:message key="derivative.allContractCombo" />";

window.DERIVATIVE_NEGOTIATED_DATATABLE_CONFIG = {
  locale: document.querySelector("#requestLocale")?.value || "en",
 
  filtersSelector: "#derivativeNegotiatedFilters",

  labels: {
	  total: '<fmt:message key="issuer.trading.info.v2.total" />'
	},
  ui: {
    loader: {
      enabled: true,
      text: '<fmt:message key="datatable.loading" />'
    },
 
    empty: {
      text: '<fmt:message key="datatable.no.data" />',
      imageUrl: "${pageContext.request.contextPath}/images/no-data.png"
    },
 
    pagination: {
      enabled: true,
      className: "feed__pagination",
      pageText: '<fmt:message key="pagination.page" />',
      ofText: '<fmt:message key="pagination.of" />',
      prevAriaLabel: '<fmt:message key="pagination.previous" />',
      nextAriaLabel: '<fmt:message key="pagination.next" />'
    }
  },
 
  defaults: {
    dateRange: {
      enabled: true,
      mode: "lastMonthToToday",
      format: "dd-MM-yyyy"
    },
 
    dataTable: {
      paging: true,
      pageLength: 25,
      lengthMenu: [25, 50, 100],
      searching: false,
      ordering: false,
      info: false,
      dom: "rt",
      deferRender: true,
      autoWidth: false,
      fixedHeader: true
    }
  },
 
  urls: {
    negotiatedDeals: '<portlet:resourceURL id="getDerivativeNegotiatedDetails" />'
  },
 
  tables: {
    negotiatedDeals: {
      selector: "#derivativeNegotiatedTable",
      paging: true,
      pageLength: 25,
      lengthMenu: [25, 50, 100],
      ordering: false,
      fixedHeader: true
    }
  },
 
  resultCounters: {
    negotiatedDeals: "#derivativeNegotiatedResultsId"
  }
};
</script>
 
<script src="${pageContext.request.contextPath}/js/dropdown-update.js"></script>
<script src="${pageContext.request.contextPath}/js/custom-trading/datatable-page-utils.js"></script>
<script src="${pageContext.request.contextPath}/js/custom-trading/derivative-trading-datatables.js"></script>
 
