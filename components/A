<%-- =========================================================================
Home Discovery Search Temporary validation: id="searchForm" added to verify
legacy submitSearch() dependency.
========================================================================= --%>

<form
  id="searchForm"
  class="home-discovery-search"
  role="search"
  aria-label="Search companies, news, and market updates"
  action="#"
  method="get"
  data-home-discovery-search
>
  <label class="visually-hidden" for="home-discovery-search-input">
    Search companies, news, and market updates
  </label>

  <span
    class="home-discovery-search__icon has-icon icon-search"
    aria-hidden="true"
  ></span>

  <input
    id="home-discovery-search-input"
    class="home-discovery-search__input"
    type="search"
    name="q"
    placeholder="Search companies, news, and updates"
    autocomplete="off"
    enterkeyhint="search"
    spellcheck="false"
    data-home-discovery-search-input
  />

  <button
    class="home-discovery-search__submit has-icon icon-chevron-right icon-flip-rtl"
    type="submit"
    aria-label="Submit search"
  ></button>

  <div
    class="home-discovery-search__results"
    data-home-discovery-search-results
    hidden
  >
    <ul
      class="home-discovery-search__list"
      data-home-discovery-search-list
    ></ul>

    <div
      class="home-discovery-search__state"
      data-home-discovery-search-loading
      role="status"
      aria-live="polite"
      hidden
    >
      <span class="home-discovery-search__loading" aria-hidden="true"></span>
      <span>Searching companies</span>
    </div>

    <div
      class="home-discovery-search__state"
      data-home-discovery-search-empty
      hidden
    >
      <span
        class="home-discovery-search__state-icon has-icon icon-search"
        aria-hidden="true"
      ></span>
      <span>No matching companies found.</span>
    </div>

    <div
      class="home-discovery-search__state"
      data-home-discovery-search-error
      role="alert"
      hidden
    >
      <span
        class="home-discovery-search__state-icon has-icon icon-info-warning"
        aria-hidden="true"
      ></span>
      <span>Company search is currently unavailable.</span>
    </div>
  </div>
</form>
