
<c:set var="marketStatusCode" value="${siteToolHelper.getInstance().getMarketStatusText()}"/> 
<c:set var="tickerData" value="${siteToolHelper.getInstance().getTickerData()}" />
<c:set var="localeLang" value="${pageContext.request.locale.language}" />

<div id="marqueeRoot"></div>

<script src="<r:url uri='${themeWebDAVBaseURI}assets/js/marquee.js' keepNavigationalState='false' lateBinding='false' protected='false'/>"></script>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const userLocale = "${localeLang}";

  const getTheme = () =>
    document.documentElement.classList.contains("theme-light") ? "light" : "dark";

  const getLogoByTheme = () => {
    const theme = getTheme();
    return {
      desktop:
        theme === "light"
          ? "<r:url uri='${themeWebDAVBaseURI}assets/images/se-logo-light.png' keepNavigationalState='false' lateBinding='false' protected='false'/>"
          : "<r:url uri='${themeWebDAVBaseURI}assets/images/se-logo-dark.png' keepNavigationalState='false' lateBinding='false' protected='false'/>",
      mobile:
        theme === "light"
          ? "<r:url uri='${themeWebDAVBaseURI}assets/images/se-logo-light.png' keepNavigationalState='false' lateBinding='false' protected='false'/>"
          : "<r:url uri='${themeWebDAVBaseURI}assets/images/se-logo-dark.png' keepNavigationalState='false' lateBinding='false' protected='false'/>"
    };
  };

  const tickerData = [
<c:forEach items="${tickerData}" var="stock" varStatus="status">
    {
      company: "${stock.pk_rf_company}",
      companyDisplay: "${localeLang eq 'ar' ? stock.companyShortNameAr : stock.companyShortNameEn}",
      price: "${stock.lastTradePrice}",
      change: "${stock.change}",
      changePercent: "${stock.changePercent}",
      changeDomId: "${stock.pk_rf_company}Change",
      link: "<portal:urlGeneration contentNode='com.tadawul.hidden.company.profile.v3' portletMode='view' portletParameterType='render' layoutNode='com.tadawul.v3.company.profile.node.v3' keepNavigationalState='false'><portal:urlParam name='companySymbol' value='${stock.pk_rf_company}' /><% wpsURL.write(out); %></portal:urlGeneration>",
      image: "https://betauat.saudiexchange.sa/Resources/SEMOBILELOGOS/${stock.pk_rf_company}.png" 
    }<c:if test="${!status.last}">,</c:if>
</c:forEach>
  ];

  const ticker = new MarqueeTicker({
    elementId: "marqueeRoot",
    direction: userLocale === "ar" ? "rtl" : "ltr",
    logo: getLogoByTheme(),
    separator: "<r:url uri='${themeWebDAVBaseURI}assets/images/favicon.png' keepNavigationalState='false' lateBinding='false' protected='false' />",
    jsonData: tickerData,
    itemWidthEstimate: 180,
    renderChunkSize: 100,
    chunkDelayMs: 25,
    fields: {
      company: "company",
      price: "price",
      change: "change",
      changePercent: "changePercent",
      companyDisplay: "companyDisplay",
      changeDomId: "changeDomId",
      link: "link",
      image: "image"
    },
    onInit: () => console.log("Marquee initialized"),
    onStart: () => console.log("Marquee started"),
    onStop: () => console.log("Marquee stopped")
  });

  // Only observe theme for CSS changes, do not restart marquee
  const observer = new MutationObserver(() => ticker.updateOptions({ logo: getLogoByTheme() }));
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

  // Live update
  function refreshTickerDetails() {
    $.ajax({
      type: "GET",
      url: "/api",
      dataType: "json",
      success: function(data) {
        if (data && data.tickerStockData) {
          data.tickerStockData.forEach(stock => {
            const price = parseFloat(stock.lastTradePrice);
            const changePercent = parseFloat(stock.changePercent);
            const priceDisplay = price === 0 || stock.lastTradePrice === "-" ? "-" : stock.lastTradePrice;
            const changeDisplay = changePercent === 0 || stock.changePercent === "-" ? "- (- %)" : `${stock.change} (${stock.changePercent}%)`;
            const stockPriceClass = changePercent < 0 ? "stockdown" : changePercent > 0 ? "stockup" : "stock";
           // $(`#${stock.pk_rf_company}`).text(priceDisplay);
            //$(`#${stock.pk_rf_company}Change`).removeClass().addClass(stockPriceClass).text(changeDisplay);
          });
        }
      },
      complete: () => setTimeout(refreshTickerDetails, 60000),
      error: () => console.warn("Failed to update ticker data.")
    });
  }
  refreshTickerDetails();
});
</script>

class MarqueeTicker {
  constructor(options = {}) {
    const defaultConfig = {
      elementId: '',
      direction: document.dir || 'ltr', // 'ltr' or 'rtl'
      logo: {},
      separator: '|',
      jsonData: [],
      fields: {},
      onInit: null,
      onStart: null,
      onStop: null,
      itemWidthEstimate: 180,
      renderChunkSize: 100,
      chunkDelayMs: 25
    };

    this._config = { ...defaultConfig, ...options };
    this.root = options.element || document.getElementById(options.elementId);
    if (!this.root) throw new Error('Invalid target element for MarqueeTicker');

    this.frameId = null;
    this.paused = false;
    this.lastTime = null;
    this.currentPosition = 0;
    this.speed = parseFloat(
      getComputedStyle(document.documentElement).getPropertyValue('--marquee-speed')
    ) || 80;

    this.trackItems = [];
    this.fullItemsCount = 0;
    this.trackLength = 0;

    this.init = this.init.bind(this);
    this.animate = this.animate.bind(this);
    this._updateLogo = this._updateLogo.bind(this);
    this.start = this.start.bind(this);
    this.stop = this.stop.bind(this);
    this._renderChunk = this._renderChunk.bind(this);

    setTimeout(this.init, 0);
  }

  init() {
    const { direction, logo, onInit } = this._config;

    this.root.innerHTML = '';
    this.root.dir = direction;

    this.wrapper = document.createElement('div');
    this.wrapper.className = 'marquee-wrapper';

    if (logo.desktop || logo.mobile) {
      this.logoImg = document.createElement('img');
      this.logoImg.className = 'ticker-logo';
      this.logoImg.src = window.innerWidth < 600 ? logo.mobile || logo.desktop : logo.desktop || logo.mobile;
      this.logoImg.alt = 'Logo';
      this.wrapper.appendChild(this.logoImg);
      window.addEventListener('resize', this._updateLogo);
    } else {
      this.wrapper.classList.add('no-logo');
    }

    this.container = document.createElement('div');
    this.container.className = 'marquee-container';
    this.container.style.overflow = 'hidden';

    this.track = document.createElement('div');
    this.track.className = 'marquee-track';
    this.track.style.display = 'flex';
    this.track.style.willChange = 'transform';

    this.container.appendChild(this.track);
    this.wrapper.appendChild(this.container);
    this.root.appendChild(this.wrapper);

    this.container.addEventListener('mouseenter', this.stop);
    this.container.addEventListener('mouseleave', this.start);

    this.trackItems = [];
    this._restorePositionFromCookie();
    this._renderChunk();

    if (typeof onInit === 'function') onInit();
  }

  _updateLogo() {
    const { logo } = this._config;
    if (this.logoImg) {
      this.logoImg.src = window.innerWidth < 600 ? logo.mobile || logo.desktop : logo.desktop || logo.mobile;
    }
  }

  createItem(item) {
    const { changePercent: cp, change, price, companyDisplay, changeDomId, link, image } = item;
    const changePercent = parseFloat(cp);
    const className = isNaN(changePercent)
      ? 'stock'
      : changePercent < 0
      ? 'stockdown'
      : changePercent > 0
      ? 'stockup'
      : 'stock';

    const wrapper = document.createElement('div');
    wrapper.className = 'ticker-item';

    const separatorEl = document.createElement('span');
    separatorEl.className = 'separator';
    const isImageSeparator = this._config.separator?.match(/\.(png|jpg|jpeg|gif|svg)$/);
    if (isImageSeparator) {
      const img = document.createElement('img');
      img.src = this._config.separator;
      img.alt = '|';
      img.style.height = '1rem';
      img.style.margin = '0 0.5rem';
      separatorEl.appendChild(img);
    } else {
      separatorEl.textContent = this._config.separator;
    }

    const itemWrapper = document.createElement('div');
    itemWrapper.className = 'headline';
    itemWrapper.innerHTML = `
      <a href="${link}" class="sname">
        <img src="${image}" alt="${companyDisplay}" class="company-logo" width="40" height="20" loading="lazy" onerror="this.onerror=null;this.src='assets/images/noimage.png';"/>
        <span>${companyDisplay}</span>
      </a>
      <span class="ticker-spacer"></span>
      <span>${price || '-'}</span>
      <span class="${className}" id="${changeDomId}">${change} (${cp}%)</span>
    `;
    wrapper.appendChild(itemWrapper);
    wrapper.appendChild(separatorEl);
    return wrapper;
  }

  _renderChunk() {
    const { jsonData, renderChunkSize, chunkDelayMs } = this._config;
    if (this.trackItems.length > 0) return;

    this.fullItemsCount = jsonData.length;
    console.log(`[Marquee] Total items in jsonData: ${this.fullItemsCount}`);

    let itemsRendered = 0;

    const renderLoop = () => {
      if (itemsRendered >= this.fullItemsCount) {
        this.trackLength = this.track.scrollWidth;
        console.log(`[Marquee] All items rendered. Track length: ${this.trackLength}px`);
        this.start();
        return;
      }

      const fragment = document.createDocumentFragment();
      const end = Math.min(itemsRendered + renderChunkSize, this.fullItemsCount);

      for (let i = itemsRendered; i < end; i++) {
        const el = this.createItem(jsonData[i]);
        this.trackItems.push(el);
        fragment.appendChild(el);
      }

      console.log(`[Marquee] Rendered items ${itemsRendered + 1} to ${end} (chunk size: ${end - itemsRendered})`);
      this.track.appendChild(fragment);
      itemsRendered = end;
      setTimeout(renderLoop, chunkDelayMs);
    };

    renderLoop();
  }

  animate(time) {
    if (this.paused) return;
    if (!this.lastTime) this.lastTime = time;

    const dt = (time - this.lastTime) / 1000;
    const isRTL = this._config.direction === 'rtl';
    const delta = this.speed * dt;

    if (isRTL) {
        this.currentPosition += delta; // move visually right for RTL
        if (this.currentPosition >= this.trackLength) this.currentPosition = 0;
    } else {
        this.currentPosition -= delta; // move left for LTR
        if (Math.abs(this.currentPosition) >= this.trackLength) this.currentPosition = 0;
    }


    this.track.style.transform = `translateX(${this.currentPosition}px)`;
    this._savePositionToCookie();
    this.lastTime = time;
    this.frameId = requestAnimationFrame(this.animate);
  }

  start() {
    if (!this.frameId) {
      this.paused = false;
      this.lastTime = null;
      this.frameId = requestAnimationFrame(this.animate);
      if (typeof this._config.onStart === 'function') this._config.onStart();
    }
  }

  stop() {
    this.paused = true;
    if (this.frameId) cancelAnimationFrame(this.frameId);
    this.frameId = null;
    if (typeof this._config.onStop === 'function') this._config.onStop();
  }

  _savePositionToCookie() {
    const dir = this._config.direction === 'rtl' ? 'rtl' : 'ltr';
    document.cookie = `marqueePosition_${dir}=${this.currentPosition}; path=/; max-age=86400`;
  }

  _restorePositionFromCookie() {
    const dir = this._config.direction === 'rtl' ? 'rtl' : 'ltr';
    const match = document.cookie.match(new RegExp(`(?:^|; )marqueePosition_${dir}=([^;]*)`));
    if (match) {
      const pos = parseFloat(match[1]);
      if (!isNaN(pos)) {
        this.currentPosition = pos;
      } else if (dir === 'rtl') {
        this.currentPosition = this.track.scrollWidth || 0;
      }
    } else if (dir === 'rtl') {
      this.currentPosition = this.track.scrollWidth || 0;
    }
  }

  destroy() {
    this.stop();
    this.root.innerHTML = '';
    window.removeEventListener('resize', this._updateLogo);

    if (this.container) {
      this.container.removeEventListener('mouseenter', this.stop);
      this.container.removeEventListener('mouseleave', this.start);
    }
  }

  updateData(newData) {
    this.stop();
    this._config.jsonData = newData;
    this.track.innerHTML = '';
    this.trackItems = [];
    this.currentPosition = 0;
    this._renderChunk();
  }

  updateOptions(newOptions = {}) {
    this._config = { ...this._config, ...newOptions };
    this._updateLogo();
  }
}











<c:set
  var="tickerData"
  value="${siteToolHelper.getInstance().getTickerData()}"
/>

<c:set
  var="localeLang"
  value="${pageContext.request.locale.language}"
/>

<section
  class="market-ticker"
  data-market-ticker
  data-market-ticker-source="market-ticker-data"
  aria-label="${localeLang eq 'ar' ? 'شريط أسعار السوق' : 'Market ticker'}"
>
</section>

<script
  id="market-ticker-data"
  type="application/json"
>
[
<c:forEach
  items="${tickerData}"
  var="stock"
  varStatus="status"
>
  {
    "symbol": "${stock.pk_rf_company}",
    "name": "${localeLang eq 'ar' ? stock.companyShortNameAr : stock.companyShortNameEn}",
    "price": "${stock.lastTradePrice}",
    "change": "${stock.change}",
    "changePercent": "${stock.changePercent}",

    "url": "<portal:urlGeneration
      contentNode='com.tadawul.hidden.company.profile.v3'
      portletMode='view'
      portletParameterType='render'
      layoutNode='com.tadawul.v3.company.profile.node.v3'
      keepNavigationalState='false'
    >
      <portal:urlParam
        name='companySymbol'
        value='${stock.pk_rf_company}'
      />
      <% wpsURL.write(out); %>
    </portal:urlGeneration>",

    "logo": "https://betauat.saudiexchange.sa/Resources/SEMOBILELOGOS/${stock.pk_rf_company}.png"
  }<c:if test="${!status.last}">,</c:if>
</c:forEach>
]
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const REFRESH_INTERVAL = 60000;

  function refreshTickerDetails() {
    $.ajax({
      type: "GET",
      url: "/api",
      dataType: "json",

      success: function (data) {
        if (
          !data ||
          !Array.isArray(data.tickerStockData)
        ) {
          return;
        }

        data.tickerStockData.forEach((stock) => {
          const symbol = String(
            stock.pk_rf_company || ""
          ).trim();

          if (!symbol) {
            return;
          }

          const price = parseFloat(
            stock.lastTradePrice
          );

          const change = parseFloat(
            stock.change
          );

          const changePercent = parseFloat(
            stock.changePercent
          );

          const priceDisplay =
            price === 0 ||
            stock.lastTradePrice === "-"
              ? "-"
              : stock.lastTradePrice;

          const changeDisplay =
            changePercent === 0 ||
            stock.changePercent === "-"
              ? "- (- %)"
              : `${stock.change} (${stock.changePercent}%)`;

          const stateClass =
            changePercent < 0
              ? "price-down"
              : changePercent > 0
                ? "price-up"
                : "price-neutral";

          const iconClass =
            changePercent < 0
              ? "icon-trending-down"
              : changePercent > 0
                ? "icon-trending-up"
                : "";

          /*
           * Update source item and all ticker clones.
           */
          const items = document.querySelectorAll(
            `[data-market-ticker-symbol="${CSS.escape(symbol)}"]`
          );

          items.forEach((item) => {
            const priceElement =
              item.querySelector(
                ".market-ticker__price"
              );

            const changeElement =
              item.querySelector(
                ".market-ticker__change"
              );

            if (priceElement) {
              priceElement.textContent =
                priceDisplay;

              if (
                Number.isFinite(price)
              ) {
                priceElement.value =
                  String(price);
              }
            }

            if (!changeElement) {
              return;
            }

            changeElement.classList.remove(
              "price-up",
              "price-down",
              "price-neutral"
            );

            changeElement.classList.add(
              stateClass
            );

            let directionIcon =
              changeElement.querySelector(
                ".market-ticker__direction"
              );

            if (iconClass) {
              if (!directionIcon) {
                directionIcon =
                  document.createElement(
                    "span"
                  );

                directionIcon.className =
                  `market-ticker__direction has-icon ${iconClass} icon-md`;

                directionIcon.setAttribute(
                  "aria-hidden",
                  "true"
                );

                changeElement.prepend(
                  directionIcon
                );
              } else {
                directionIcon.classList.remove(
                  "icon-trending-up",
                  "icon-trending-down"
                );

                directionIcon.classList.add(
                  iconClass
                );
              }
            } else {
              directionIcon?.remove();
            }

            const values =
              changeElement.querySelectorAll(
                "data"
              );

            if (values[0]) {
              values[0].textContent =
                Number.isFinite(change)
                  ? stock.change
                  : "-";

              if (
                Number.isFinite(change)
              ) {
                values[0].value =
                  String(change);
              }
            }

            if (values[1]) {
              values[1].textContent =
                changePercent === 0 ||
                stock.changePercent === "-"
                  ? "(- %)"
                  : `(${stock.changePercent}%)`;

              if (
                Number.isFinite(
                  changePercent
                )
              ) {
                values[1].value =
                  String(changePercent);
              }
            }
          });
        });
      },

      error: function () {
        console.warn(
          "Failed to update ticker data."
        );
      },

      complete: function () {
        window.setTimeout(
          refreshTickerDetails,
          REFRESH_INTERVAL
        );
      }
    });
  }

  refreshTickerDetails();
});
</script>